@model List<Product>
@{
    ViewData["Title"] = "Products";
    var filter = ViewBag.Filter as ProductFilterViewModel ?? new ProductFilterViewModel();
}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Master Catalogue</h2>
        <a asp-controller="Products" asp-action="Create" class="btn btn-primary">+ Add Product</a>
    </div>

    <form asp-controller="Products" asp-action="Index" method="get" class="row g-2 mb-4">
        <div class="col-md-3">
            <input type="text" name="SearchTerm" value="@filter.SearchTerm" class="form-control" placeholder="Search name or SKU" />
        </div>
        <div class="col-md-2">
            <input type="text" name="Category" value="@filter.Category" class="form-control" placeholder="Category" />
        </div>
        <div class="col-md-2">
            <input type="text" name="Size" value="@filter.Size" class="form-control" placeholder="Size" />
        </div>
        <div class="col-md-2">
            <input type="text" name="Color" value="@filter.Color" class="form-control" placeholder="Colour" />
        </div>
        <div class="col-md-2 d-flex align-items-center">
            <div class="form-check">
                <input type="checkbox" name="InStockOnly" value="true" class="form-check-input" checked="@(filter.InStockOnly == true)" />
                <label class="form-check-label">In stock only</label>
            </div>
        </div>
        <div class="col-md-1">
            <button type="submit" class="btn btn-outline-secondary w-100">Filter</button>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No products match your search.</div>
    }
    else
    {
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>SKU</th>
                    <th>Category</th>
                    <th>Size / Colour</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var p in Model)
            {
                <tr class="@(p.IsLowStock ? "table-warning" : "")">
                    <td>@p.Name <div class="text-muted small">@p.Brand</div></td>
                    <td>@p.SKU</td>
                    <td>@p.Category</td>
                    <td>@p.Size / @p.Color</td>
                    <td>@p.SellingPrice.ToString("C")</td>
                    <td>
                        @p.StockQuantity
                        @if (p.IsLowStock)
                        {
                            <span class="badge bg-warning text-dark ms-1">Low</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-controller="Products" asp-action="Edit" asp-route-id="@p.ProductId" class="btn btn-sm btn-outline-primary">Edit</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>
