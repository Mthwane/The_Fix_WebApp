@model RoleEditViewModel
@{
    ViewData["Title"] = "New Role";
}
<div class="container py-4" style="max-width:640px;">
    <h2>New Role</h2>

    <form asp-controller="Roles" asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" placeholder="e.g. Supervisor" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <label class="form-label">Permissions</label>
        <div class="border rounded p-3 mb-3">
            @foreach (var permission in Model.AllPermissions)
            {
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" name="SelectedPermissions" value="@permission.Key" id="perm_@permission.Key" />
                    <label class="form-check-label" for="perm_@permission.Key">@permission.Value</label>
                </div>
            }
        </div>

        <button type="submit" class="btn btn-primary">Create Role</button>
        <a asp-controller="Roles" asp-action="Index" class="btn btn-link">Cancel</a>
    </form>
</div>
