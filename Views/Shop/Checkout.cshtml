@model CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
    var fallbackImage = "https://placehold.co/64x64?text=No+Image";
}
<div class="container py-4" style="max-width:640px;">
    <h2>Checkout</h2>

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <table class="table table-sm align-middle">
        <thead><tr><th></th><th>Item</th><th>Qty</th><th>Total</th></tr></thead>
        <tbody>
        @foreach (var line in Model.Cart.Lines)
        {
            <tr>
                <td style="width:56px;">
                    <img src="@(string.IsNullOrWhiteSpace(line.ImageUrl) ? fallbackImage : line.ImageUrl)"
                         alt="@line.Name" class="rounded border" style="width:48px;height:48px;object-fit:cover;" />
                </td>
                <td>@line.Name</td><td>@line.Quantity</td><td>@line.LineTotal.ToString("C")</td>
            </tr>
        }
        </tbody>
    </table>

    @{
        var vat = FashionFix.Web.Security.TaxSettings.CalculateVat(Model.Cart.SubTotal);
        var total = Model.Cart.SubTotal + vat;
    }
    <div class="d-flex justify-content-between"><span>Subtotal</span><span>@Model.Cart.SubTotal.ToString("C")</span></div>
    <div class="d-flex justify-content-between text-muted"><span>VAT (15%)</span><span>@vat.ToString("C")</span></div>
    <div class="d-flex justify-content-between fs-5 border-top pt-2 mt-2"><strong>Total</strong><strong>@total.ToString("C")</strong></div>

    <form asp-controller="Shop" asp-action="Checkout" method="post" class="mt-4">
        <div class="mb-3">
            <label asp-for="PaymentMethod" class="form-label"></label>
            <select asp-for="PaymentMethod" class="form-select">
                <option value="Cash">Cash on collection</option>
                <option value="CreditCard">Credit Card</option>
                <option value="DebitCard">Debit Card</option>
            </select>
        </div>

        <button type="submit" class="btn btn-danger w-100">Place Order</button>
    </form>
</div>
