@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    bool Can(string permission) => User.HasClaim(FashionFix.Web.Security.Permissions.ClaimType, permission);
    var canManageProducts = Can(FashionFix.Web.Security.Permissions.ProductsManage);
}

<div class="container py-4">
    <h1>Dashboard</h1>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h6 class="text-muted">Today's Sales</h6>
                    <h3>@Model.TodaysSales.ToString("C")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h6 class="text-muted">Today's Orders</h6>
                    <h3>@Model.TodaysOrderCount</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card">
                <div class="card-body">
                    <h6 class="text-muted">Month-to-Date Revenue</h6>
                    <h3>@Model.MonthToDateRevenue.ToString("C")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            @if (canManageProducts)
            {
                <a asp-controller="Products" asp-action="LowStock" class="text-decoration-none">
                    <div class="card border-warning h-100" style="cursor:pointer;">
                        <div class="card-body">
                            <h6 class="text-muted">Low Stock Items</h6>
                            <h3 class="text-warning-emphasis">@Model.LowStockCount</h3>
                            <div class="small text-muted">Click to view &amp; restock &rarr;</div>
                        </div>
                    </div>
                </a>
            }
            else
            {
                <div class="card border-warning">
                    <div class="card-body">
                        <h6 class="text-muted">Low Stock Items</h6>
                        <h3>@Model.LowStockCount</h3>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center">
        <h5>Low Stock Alerts</h5>
        @if (canManageProducts && Model.LowStockProducts.Any())
        {
            <a asp-controller="Products" asp-action="LowStock" class="btn btn-sm btn-outline-warning">View all &amp; restock</a>
        }
    </div>
    <table class="table table-sm @(canManageProducts ? "table-hover" : "")">
        <thead><tr><th>Product</th><th>SKU</th><th>Stock</th><th>Threshold</th></tr></thead>
        <tbody>
            @foreach (var p in Model.LowStockProducts)
            {
                if (canManageProducts)
                {
                    <tr style="cursor:pointer;" onclick="window.location='@Url.Action("Edit", "Products", new { id = p.ProductId })'">
                        <td>@p.Name</td>
                        <td>@p.SKU</td>
                        <td>@p.StockQuantity</td>
                        <td>@p.LowStockThreshold</td>
                    </tr>
                }
                else
                {
                    <tr><td>@p.Name</td><td>@p.SKU</td><td>@p.StockQuantity</td><td>@p.LowStockThreshold</td></tr>
                }
            }
        </tbody>
    </table>
</div>
