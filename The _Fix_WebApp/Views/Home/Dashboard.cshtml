@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container py-4">
    <h1>Dashboard</h1>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card"><div class="card-body">
                <h6 class="text-muted">Today's Sales</h6>
                <h3>@Model.TodaysSales.ToString("C")</h3>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card"><div class="card-body">
                <h6 class="text-muted">Today's Orders</h6>
                <h3>@Model.TodaysOrderCount</h3>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card"><div class="card-body">
                <h6 class="text-muted">Month-to-Date Revenue</h6>
                <h3>@Model.MonthToDateRevenue.ToString("C")</h3>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card border-warning"><div class="card-body">
                <h6 class="text-muted">Low Stock Items</h6>
                <h3>@Model.LowStockCount</h3>
            </div></div>
        </div>
    </div>

    <h5>Low Stock Alerts</h5>
    <table class="table table-sm">
        <thead><tr><th>Product</th><th>SKU</th><th>Stock</th><th>Threshold</th></tr></thead>
        <tbody>
        @foreach (var p in Model.LowStockProducts)
        {
            <tr><td>@p.Name</td><td>@p.SKU</td><td>@p.StockQuantity</td><td>@p.LowStockThreshold</td></tr>
        }
        </tbody>
    </table>
</div>
