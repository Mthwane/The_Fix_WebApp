@model StorefrontLandingViewModel
@{
    ViewData["Title"] = Model.SiteSettings.HeroHeadline;
    Layout = "_StorefrontLayout";
    var settings = Model.SiteSettings;

    string Ph(string label, int w = 800, int h = 800) => $"https://placehold.co/{w}x{h}/E4DEC9/24211B?text={Uri.EscapeDataString(label)}";
}

<section class="ffs-hero">
    <div class="ffs-container">
        <div class="ffs-hero-grid">
            <div class="ffs-hero-copy">
                <span class="ffs-eyebrow">@settings.HeroEyebrow</span>
                <h1>@settings.HeroHeadline</h1>
                <p>@settings.HeroSubheadline</p>
                <div class="ffs-hero-actions">
                    <a asp-controller="Shop" asp-action="Index" class="ffs-btn ffs-btn-forest">@settings.HeroPrimaryCtaText &rarr;</a>
                    <a href="#trending" class="ffs-btn ffs-btn-outline">@settings.HeroSecondaryCtaText</a>
                </div>
                <div class="ffs-hero-stats">
                    <div><b>100%</b><span>Certified Regenerative</span></div>
                    <div><b>0%</b><span>Synthetic Plastics</span></div>
                    <div><b>R500+</b><span>Free Express Logistics</span></div>
                </div>
            </div>
            <div class="ffs-hero-image">
                <img src="@(settings.HeroImageUrl ?? Ph("Fashion Fix Editorial", 900, 700))" alt="Fashion Fix editorial" />
            </div>
        </div>

        <div class="ffs-features">
            <div class="ffs-feature">
                <div class="ffs-feature-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg></div>
                <div><h4>Free Express Delivery</h4><p>Complimentary nationwide courier dispatch on orders exceeding R500.</p></div>
            </div>
            <div class="ffs-feature">
                <div class="ffs-feature-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2 3 7v6c0 5 4 9 9 9s9-4 9-9V7l-9-5Z"/></svg></div>
                <div><h4>Ethical Craftsmanship</h4><p>Regenerative botanical textiles and closed-loop herbal dyes.</p></div>
            </div>
            <div class="ffs-feature">
                <div class="ffs-feature-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-6.2-8.6"/><path d="M21 3v6h-6"/></svg></div>
                <div><h4>60-Day Easy Returns</h4><p>Effortless doorstep exchanges with carbon-neutral parcel returns.</p></div>
            </div>
            <div class="ffs-feature">
                <div class="ffs-feature-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg></div>
                <div><h4>24/7 Style Concierge</h4><p>Personalized sizing matrix and wardrobe curation on call.</p></div>
            </div>
        </div>
    </div>
</section>

<section class="ffs-section">
    <div class="ffs-container">
        <div class="ffs-section-head">
            <div>
                <span class="ffs-eyebrow">Atelier Departments</span>
                <h2>Curated Department Portals</h2>
            </div>
            <p>Explore intentional wardrobes categorized by tactile performance, botanical composition, and versatile ease.</p>
        </div>

        <div class="ffs-dept-grid">
            @for (var i = 0; i < Model.Departments.Count && i < 4; i++)
            {
                var dept = Model.Departments[i];
                <div class="ffs-dept-card">
                    <div class="ffs-dept-img">
                        <img src="@(dept.TileImageUrl ?? Ph(dept.Name, 500, 620))" alt="@dept.Name" />
                    </div>
                    <div class="ffs-dept-body">
                        <span class="ffs-dept-label">Department 0@(i + 1)</span>
                        <h3>@dept.Name</h3>
                        <p>@(dept.HeroSubheadline ?? "Curated pieces built for tactile comfort and lasting wear.")</p>
                        <div class="ffs-dept-links">
                            <a asp-controller="Shop" asp-action="Department" asp-route-slug="@dept.Slug" class="ffs-btn ffs-btn-forest">Shop @dept.Name &rarr;</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section class="ffs-section ffs-section-alt" id="trending">
    <div class="ffs-container">
        <div class="ffs-section-head">
            <div>
                <span class="ffs-eyebrow">Weekly Botanical Laboratory</span>
                <h2>Trending This Week</h2>
            </div>
        </div>

        @if (Model.Trending.Count == 0)
        {
            <p class="text-muted">New arrivals are being curated - check back soon.</p>
        }
        else
        {
            <div class="ffs-product-grid">
                @foreach (var card in Model.Trending)
                {
                    var product = card.Product;
                    <div class="ffs-product-card">
                        <a asp-controller="Shop" asp-action="Product" asp-route-id="@product.ProductId" class="ffs-product-img-wrap" style="display:block;">
                            <img src="@(card.DisplayImageUrl ?? Ph(card.DisplayTitle, 500, 650))" alt="@card.DisplayTitle" />
                            @if (!string.IsNullOrWhiteSpace(card.DisplayBadge))
                            {
                                <span class="ffs-product-badge @(product.IsOnSale ? "ffs-badge-clay" : "")">@card.DisplayBadge</span>
                            }
                        </a>
                        <button type="button" class="ffs-wishlist-btn" title="Save to wishlist" onclick="location.href='@Url.Action("Login", "Account", new { returnUrl = Url.Action("Index", "Home") })'">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8Z"/></svg>
                        </button>
                        <div class="ffs-product-meta">
                            @if (product.ReviewCount > 0)
                            {
                                <div class="ffs-product-rating"><span class="star">&#9733;</span> @product.AverageRating.ToString("0.0") <span>(@product.ReviewCount)</span></div>
                            }
                            <a asp-controller="Shop" asp-action="Product" asp-route-id="@product.ProductId" class="ffs-product-name" style="display:block;">@card.DisplayTitle</a>
                            @if (!string.IsNullOrWhiteSpace(product.Material))
                            {
                                <div class="ffs-product-desc">@product.Material</div>
                            }
                            <div class="ffs-product-price-row">
                                <span class="ffs-price">R@product.SellingPrice.ToString("N0")</span>
                                @if (product.IsOnSale)
                                {
                                    <span class="ffs-price-was">R@product.CompareAtPrice!.Value.ToString("N0")</span>
                                }
                            </div>
                            @{ var swatchColors = product.DistinctColors.Take(4).ToList(); }
                            @if (swatchColors.Count > 0)
                            {
                                <div class="ffs-swatches">
                                    @foreach (var c in swatchColors)
                                    {
                                        <span class="ffs-swatch" style="background:@c;" title="@c"></span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

<section class="ffs-section">
    <div class="ffs-container">
        <div class="ffs-banner-dark">
            <div style="max-width:640px;">
                <span class="ffs-eyebrow">The Curated Fix Experience</span>
                <h2 style="font-size:2rem;margin-bottom:14px;">@settings.StyleBoxHeadline</h2>
                <p>@settings.StyleBoxSubheadline</p>
                <div class="ffs-steps">
                    <div class="ffs-step"><b class="ffs-step-num">01</b><h5>Take the Quiz</h5><p>Define silhouettes, fabric weights, and weekly rituals.</p></div>
                    <div class="ffs-step"><b class="ffs-step-num">02</b><h5>Atelier Curates</h5><p>5 tailored garments hand-inspected in Cape Town.</p></div>
                    <div class="ffs-step"><b class="ffs-step-num">03</b><h5>Keep or Swap</h5><p>7 days to trial at home with 20% bundle reduction.</p></div>
                </div>
                <div style="display:flex;gap:14px;align-items:center;flex-wrap:wrap;">
                    <a asp-controller="Shop" asp-action="Index" class="ffs-btn ffs-btn-sage">Take the Style Quiz</a>
                    <a href="#" class="ffs-btn-outline-light ffs-btn">View Sample Autumn Box &nearr;</a>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="ffs-section">
    <div class="ffs-container">
        <div class="ffs-story-grid">
            <div class="ffs-story-img">
                <img src="@Ph("Garment Ecosystem", 700, 520)" alt="Botanical fashion laboratory" />
            </div>
            <div>
                <span class="ffs-eyebrow">Our Scientific Ethos</span>
                <h2 style="margin-bottom:16px;">Garments Conceived as Living Ecosystems</h2>
                <p style="color:var(--ffs-ink-muted);font-size:0.92rem;">Fashion Fix was founded on a singular botanical conviction: human dermal layers absorb the essence of what touches them. By abandoning petrochemical synthetics in favour of bio-fermented enzymes, raw flax, and plant-derived pigments, our garments support both personal well-being and ecological longevity.</p>
                <ul class="ffs-checklist">
                    <li>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>
                        <span><b>Microbiome-Safe Fabric Treatments</b><span>Finished exclusively with probiotic cleansers rather than heavy formaldehyde stabilizers.</span></span>
                    </li>
                    <li>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>
                        <span><b>Regenerative African Agriculture</b><span>Sourced through regional partner conservancies across Southern Africa replenishing topsoil integrity.</span></span>
                    </li>
                    <li>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>
                        <span><b>Lifetime Mend &amp; Rewear Program</b><span>Return any piece at year three for natural re-dyeing or atelier re-stitching at no charge.</span></span>
                    </li>
                </ul>
                <a href="#" class="ffs-btn ffs-btn-forest">Read The Transparency Ledger &rarr;</a>
            </div>
        </div>
    </div>
</section>

<section class="ffs-section">
    <div class="ffs-container">
        <div class="ffs-boutique-banner">
            <div>
                <h4>Visit Our Boutiques in Cape Town &amp; Sandton</h4>
                <p>Experience the tactile linen weight and bespoke sizing consultations in person.</p>
            </div>
            <div class="ffs-boutique-actions">
                <a href="#" class="ffs-btn ffs-btn-outline">Book Fitting Session</a>
                <a href="#" class="ffs-btn ffs-btn-forest">Find Stores</a>
            </div>
        </div>
    </div>
</section>
