@model LoginViewModel
@{
    ViewData["Title"] = "Login";
    ViewData["HideNav"] = true; // no navbar on the login screen
}

<div class="container-fluid vh-100">
    <div class="row h-100">

        <!-- LEFT PANEL: branding -->
        <div class="col-lg-6 d-none d-lg-flex flex-column justify-content-center text-white p-5"
             style="background: linear-gradient(135deg,#c2185b,#e91e63);">
            <h1 class="display-5 fw-bold">Fashion Fix</h1>
            <p class="fs-5">Style that fits</p>
            <h2 class="mt-4">Welcome Back!</h2>
            <p>Please login to continue</p>

            <div class="d-flex gap-3 mt-5">
                <div class="bg-white bg-opacity-25 rounded p-3 text-center flex-fill">
                    <div class="fs-4">🛍️</div>
                    <small>Manage Products</small>
                </div>
                <div class="bg-white bg-opacity-25 rounded p-3 text-center flex-fill">
                    <div class="fs-4">🛒</div>
                    <small>Process Sales</small>
                </div>
                <div class="bg-white bg-opacity-25 rounded p-3 text-center flex-fill">
                    <div class="fs-4">📊</div>
                    <small>View Reports</small>
                </div>
            </div>
        </div>

        <!-- RIGHT PANEL: the actual login form -->
        <div class="col-lg-6 d-flex flex-column justify-content-center p-5">
            <div class="mx-auto w-100" style="max-width: 380px;">

                <h2 class="mb-1">Login</h2>
                <p class="text-muted mb-4">Enter your credentials to access your account</p>

                <form asp-controller="Account" asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="ReturnUrl" />
                    <input type="hidden" asp-for="IsEmployeeLogin" value="false" />

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label"></label>
                        <input asp-for="Username" class="form-control" placeholder="Enter your username" />
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" placeholder="Enter your password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="mb-3 d-flex justify-content-between align-items-center">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label"></label>
                        </div>
                        <a href="#" class="text-decoration-none">Forgot Password?</a>
                    </div>

                    <button type="submit" class="btn btn-danger w-100 mb-3">Login</button>
                </form>

                <div class="text-center text-muted mb-3">OR</div>

                <!-- Secondary action: staff-only login placeholder -->
                <a asp-controller="Account" asp-action="EmployeeLogin" class="btn btn-outline-secondary w-100 mb-3">
                    Login as Employee
                </a>

                <p class="text-center">
                    Don't have an account?
                    <a asp-controller="Account" asp-action="Register">Register</a>
                </p>
            </div>
        </div>

    </div>
</div>
