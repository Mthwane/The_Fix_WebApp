@{
    ViewData["Title"] = "Page Not Found";
    ViewData["HideNav"] = User.Identity?.IsAuthenticated != true;
}
<div class="container py-5 text-center" style="max-width:520px;">
    <div class="display-1 mb-2"><i class="bi bi-search"></i></div>
    <h1 class="mb-2">Page Not Found</h1>
    <p class="text-muted">The page you're looking for doesn't exist, or you may not have access to it.</p>
    <div class="mt-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-danger">Go to Home</a>
    </div>
</div>
