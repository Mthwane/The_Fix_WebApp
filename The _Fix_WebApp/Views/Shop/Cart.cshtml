@model CartViewModel
@{
    ViewData["Title"] = "My Cart";
    Layout = "_StorefrontLayout";
    var fallbackImage = "https://placehold.co/160x160/E4DEC9/24211B?text=No+Image";
    var vat = FashionFix.Web.Security.TaxSettings.CalculateVat(Model.SubTotal);
}

<section class="ffs-section" style="padding-top:32px;">
    <div class="ffs-container" style="max-width:980px;">
        <div class="ffs-section-head">
            <div>
                <span class="ffs-eyebrow">Your Selection</span>
                <h1 style="font-family:'Fraunces',serif;font-size:2rem;">My Cart</h1>
            </div>
            <a asp-controller="Shop" asp-action="Index" class="ffs-btn ffs-btn-outline">&larr; Continue Shopping</a>
        </div>

        @if (!Model.Lines.Any())
        {
            <div style="text-align:center;padding:64px 0;color:var(--ffs-ink-muted);">
                <p style="margin-bottom:16px;">Your cart is empty.</p>
                <a asp-controller="Shop" asp-action="Index" class="ffs-btn ffs-btn-forest">Browse the Shop</a>
            </div>
        }
        else
        {
            <div style="display:flex;flex-direction:column;gap:14px;margin-bottom:32px;">
                @foreach (var line in Model.Lines)
                {
                    <div style="display:flex;gap:16px;align-items:center;background:var(--ffs-card);border:1px solid var(--ffs-border);border-radius:var(--ffs-radius);padding:14px;">
                        <img src="@(string.IsNullOrWhiteSpace(line.ImageUrl) ? fallbackImage : line.ImageUrl)"
                             alt="@line.Name" style="width:72px;height:72px;object-fit:cover;border-radius:10px;flex-shrink:0;" />

                        <div style="flex:1;min-width:0;">
                            <div style="font-weight:500;">@line.Name</div>
                            @if (line.Size != null || line.Color != null)
                            {
                                <div style="font-size:0.8rem;color:var(--ffs-ink-muted);">@line.Size / @line.Color</div>
                            }
                            <div style="font-size:0.78rem;color:var(--ffs-ink-muted);">SKU: @line.SKU</div>
                        </div>

                        <form asp-controller="Shop" asp-action="UpdateCartLine" method="post" style="display:flex;gap:6px;align-items:center;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="variantId" value="@line.VariantId" />
                            <input type="number" name="quantity" value="@line.Quantity" min="0"
                                   style="width:60px;border:1px solid var(--ffs-border);border-radius:8px;padding:6px 8px;font-size:0.85rem;" />
                            <button type="submit" class="ffs-btn ffs-btn-outline" style="padding:6px 12px;font-size:0.78rem;">Update</button>
                        </form>

                        <div style="width:90px;text-align:right;font-weight:600;font-family:'Fraunces',serif;">@line.LineTotal.ToString("C")</div>

                        <form asp-controller="Shop" asp-action="RemoveFromCart" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="variantId" value="@line.VariantId" />
                            <button type="submit" title="Remove" style="background:none;border:none;color:var(--ffs-clay);font-size:1.1rem;cursor:pointer;line-height:1;">&times;</button>
                        </form>
                    </div>
                }
            </div>

            <div style="display:flex;justify-content:flex-end;">
                <div style="min-width:300px;background:var(--ffs-cream-alt);border-radius:var(--ffs-radius);padding:20px;">
                    <div style="display:flex;justify-content:space-between;font-size:0.9rem;margin-bottom:8px;">
                        <span>Subtotal</span><span>@Model.SubTotal.ToString("C")</span>
                    </div>
                    <div style="display:flex;justify-content:space-between;font-size:0.85rem;color:var(--ffs-ink-muted);margin-bottom:14px;">
                        <span>VAT (15%)</span><span>@vat.ToString("C")</span>
                    </div>
                    <div style="display:flex;justify-content:space-between;border-top:1px solid var(--ffs-border);padding-top:12px;margin-bottom:18px;font-size:1.1rem;font-family:'Fraunces',serif;font-weight:600;">
                        <span>Total</span><span>@((Model.SubTotal + vat).ToString("C"))</span>
                    </div>
                    <a asp-controller="Shop" asp-action="Checkout" class="ffs-btn ffs-btn-forest" style="width:100%;justify-content:center;">Proceed to Checkout &rarr;</a>
                </div>
            </div>
        }
    </div>
</section>
