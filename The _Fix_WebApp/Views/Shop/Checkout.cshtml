@model CheckoutViewModel

@using FashionFix.Web.Models.Entities
@using FashionFix.Web.Models.ViewModels

@{
    ViewData["Title"] = "Checkout";
    Layout = "_StorefrontLayout";

    var fallbackImage = "https://placehold.co/100x100/E4DEC9/24211B?text=No+Image";

    var rewardsSettings = ViewBag.RewardsSettings as RewardsSettings;
    var rewardsQuote = ViewBag.RewardsQuote as RedemptionQuote;

    var pointsDiscount = 0m;

    if (Model.UsePoints && rewardsQuote is { CanRedeem: true })
    {
        pointsDiscount = Math.Min(
            rewardsQuote.MaxDiscount,
            Model.Cart.SubTotal);
    }

    var appliedDiscountCode = ViewBag.DiscountCode as string;
    var appliedDiscountAmount = appliedDiscountCode is null ? 0m : (decimal)ViewBag.DiscountAmount;

    // Reward points can't push the combined savings past the basket value.
    pointsDiscount = Math.Min(pointsDiscount, Math.Max(0m, Model.Cart.SubTotal - appliedDiscountAmount));

    var vat = TaxSettings.CalculateVat(
        Model.Cart.SubTotal,
        pointsDiscount + appliedDiscountAmount);

    var total =
        Model.Cart.SubTotal -
        pointsDiscount -
        appliedDiscountAmount +
        vat;
}

<section class="ffs-section" style="padding-top:32px;">
    <div class="ffs-container" style="max-width:680px;">
        <span class="ffs-eyebrow">Almost There</span>
        <h1 style="font-family:'Fraunces',serif;font-size:2rem;margin-bottom:24px;">Checkout</h1>

        <div asp-validation-summary="ModelOnly" style="color:var(--ffs-clay);margin-bottom:16px;"></div>

        <div style="display:flex;flex-direction:column;gap:10px;margin-bottom:24px;">
            @foreach (var line in Model.Cart.Lines)
            {
                <div style="display:flex;gap:14px;align-items:center;background:var(--ffs-card);border:1px solid var(--ffs-border);border-radius:var(--ffs-radius);padding:10px 14px;">
                    <img src="@(string.IsNullOrWhiteSpace(line.ImageUrl) ? fallbackImage : line.ImageUrl.Sized(200))"
                         alt="@line.Name" style="width:52px;height:52px;object-fit:cover;border-radius:8px;flex-shrink:0;" />
                    <div style="flex:1;">
                        <div style="font-size:0.9rem;">@line.Name @if (line.Size != null || line.Color != null) { <span style="color:var(--ffs-ink-muted);">(@line.Size/@line.Color)</span> }</div>
                        <div style="font-size:0.78rem;color:var(--ffs-ink-muted);">Qty @line.Quantity</div>
                    </div>
                    <div style="font-weight:600;font-family:'Fraunces',serif;">@line.LineTotal.ToString("C")</div>
                </div>
            }
        </div>

        <div style="background:var(--ffs-cream-alt);border-radius:var(--ffs-radius);padding:16px 20px;margin-bottom:28px;">
            <div style="display:flex;justify-content:space-between;font-size:0.88rem;margin-bottom:6px;"><span>Subtotal</span><span>@Model.Cart.SubTotal.ToString("C")</span></div>
            @if (appliedDiscountCode is not null)
            {
                <div style="display:flex;justify-content:space-between;font-size:0.88rem;margin-bottom:6px;color:var(--ffs-forest);"><span>Discount (@appliedDiscountCode)</span><span>-@appliedDiscountAmount.ToString("C")</span></div>
            }
            <div style="display:flex;justify-content:space-between;font-size:0.85rem;color:var(--ffs-ink-muted);margin-bottom:10px;"><span>VAT (15%)</span><span>@vat.ToString("C")</span></div>
            <div style="display:flex;justify-content:space-between;border-top:1px solid var(--ffs-border);padding-top:10px;font-size:1.05rem;font-weight:600;font-family:'Fraunces',serif;"><span>Total</span><span>@total.ToString("C")</span></div>
        </div>

        <div style="margin-bottom:28px;">
            @if (appliedDiscountCode is null)
            {
                <form asp-controller="Shop" asp-action="ApplyDiscountCode" asp-route-returnTo="checkout" method="post" style="display:flex;gap:8px;">
                    @Html.AntiForgeryToken()
                    <input type="text" name="code" placeholder="Have a discount code?" autocomplete="off" maxlength="30"
                           style="box-sizing:border-box;flex:1;min-width:0;border:1px solid var(--ffs-border);border-radius:8px;padding:9px 14px;font-size:0.88rem;text-transform:uppercase;" />
                    <button type="submit" class="ffs-btn ffs-btn-outline" style="padding:9px 18px;font-size:0.82rem;">Apply</button>
                </form>
            }
            else
            {
                <form asp-controller="Shop" asp-action="RemoveDiscountCode" asp-route-returnTo="checkout" method="post">
                    @Html.AntiForgeryToken()
                    <span style="font-size:0.85rem;">Code <strong>@appliedDiscountCode</strong> applied.</span>
                    <button type="submit" style="background:none;border:none;padding:0;margin-left:8px;font-size:0.82rem;color:var(--ffs-clay);cursor:pointer;text-decoration:underline;">Remove</button>
                </form>
            }
        </div>

        <form asp-controller="Shop" asp-action="Checkout" method="post">
            @Html.AntiForgeryToken()

            <h5 style="font-family:'Fraunces',serif;font-size:1.1rem;margin-bottom:12px;">Deliver To</h5>
            @if (!Model.Addresses.Any())
            {
                <div style="display:flex;justify-content:space-between;align-items:center;background:var(--ffs-cream-alt);border-radius:var(--ffs-radius);padding:14px 18px;margin-bottom:20px;">
                    <span style="font-size:0.88rem;">You don't have a saved address yet.</span>
                    <a asp-controller="Customer" asp-action="AddAddress" class="ffs-btn ffs-btn-forest" style="padding:8px 16px;font-size:0.8rem;">Add Address</a>
                </div>
            }
            else
            {
                <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:20px;">
                    @foreach (var address in Model.Addresses)
                    {
                        <label style="display:flex;gap:10px;align-items:flex-start;border:1px solid var(--ffs-border);border-radius:var(--ffs-radius);padding:12px 14px;cursor:pointer;">
                            <input type="radio" name="SelectedAddressId" value="@address.CustomerAddressId" checked="@(Model.SelectedAddressId == address.CustomerAddressId)" style="margin-top:3px;" />
                            <span>
                                <strong>@address.Label</strong>
                                @if (address.IsDefault)
                                {
                                    <span class="ffs-product-badge" style="position:static;font-size:0.6rem;margin-left:6px;">Default</span>
                                }
                                <br />
                                <span style="font-size:0.82rem;color:var(--ffs-ink-muted);">@address.RecipientName &middot; @address.AddressLine1, @address.City, @address.Province @address.PostalCode</span>
                            </span>
                        </label>
                    }
                    <a asp-controller="Customer" asp-action="AddAddress" style="font-size:0.82rem;color:var(--ffs-forest);">+ Add a different address</a>
                </div>
            }
            <span asp-validation-for="SelectedAddressId" style="color:var(--ffs-clay);font-size:0.82rem;"></span>

            <hr style="border-color:var(--ffs-border);margin:24px 0;" />

            <h5 style="font-family:'Fraunces',serif;font-size:1.1rem;margin-bottom:12px;">Payment</h5>
            @{
                var walletBalance = ViewBag.WalletBalance as decimal? ?? 0m;
            var checkoutTotal = total;
                var canPayWithWallet = walletBalance >= checkoutTotal;
            }
        @{
            var rewardsSettings = ViewBag.RewardsSettings as RewardsSettings;
            var rewardsQuote = ViewBag.RewardsQuote as RedemptionQuote;
        }
        @if (rewardsQuote is { CanRedeem: true })
        {
            var pointsOff = Math.Min(rewardsQuote.MaxDiscount, Math.Max(0m, Model.Cart.SubTotal - appliedDiscountAmount));
            var vatAfterPoints = TaxSettings.CalculateVat(Model.Cart.SubTotal, pointsOff + appliedDiscountAmount);
            var totalAfterPoints = Model.Cart.SubTotal - pointsOff - appliedDiscountAmount + vatAfterPoints;
            <h5 style="font-family:'Fraunces',serif;font-size:1.1rem;margin-bottom:12px;">FixRewards</h5>
            <label style="display:flex;gap:10px;align-items:flex-start;border:1px solid var(--ffs-border);border-radius:var(--ffs-radius);padding:12px 14px;cursor:pointer;margin-bottom:20px;">
                <input type="checkbox" asp-for="UsePoints" style="margin-top:3px;" />
                <span>
                    Use <strong>@rewardsQuote.MaxPoints.ToString("N0")</strong> points for <strong>@pointsOff.ToString("C")</strong> off
                    <div style="font-size:0.78rem;color:var(--ffs-ink-muted);">You have @rewardsQuote.Balance.ToString("N0") points. Your total becomes @totalAfterPoints.ToString("C").</div>
                </span>
            </label>
            <hr style="border-color:var(--ffs-border);margin:24px 0;" />
        }
        else if (rewardsSettings is { IsEnabled: true } && rewardsQuote is { Balance: > 0 } && rewardsQuote.Reason is not null)
        {
            <p style="font-size:0.82rem;color:var(--ffs-ink-muted);margin-bottom:16px;">@rewardsQuote.Reason</p>
        }
            @if (canPayWithWallet)
            {
                <div style="background:var(--ffs-cream-alt);border-radius:8px;padding:10px 14px;font-size:0.85rem;margin-bottom:12px;">
                    Your FixCash balance is <strong>R@(walletBalance.ToString("N2"))</strong> - enough to cover this order.
                </div>
            }
            <div style="margin-bottom:16px;">
                <label asp-for="PaymentMethod" class="form-label" style="font-size:0.85rem;"></label>
                <select asp-for="PaymentMethod" class="form-select" style="border:1px solid var(--ffs-border);border-radius:8px;padding:8px 12px;">
                    @if (canPayWithWallet)
                    {
                        <option value="FixCash">Pay with FixCash (R@(walletBalance.ToString("N2")) available)</option>
                    }
                    <option value="Cash">Cash on delivery</option>
                    <option value="CreditCard">Credit Card</option>
                    <option value="DebitCard">Debit Card</option>
                </select>
            </div>

            @if (Model.SavedCards.Any())
            {
                <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:12px;">
                    @foreach (var card in Model.SavedCards)
                    {
                        <label style="display:flex;gap:10px;align-items:center;border:1px solid var(--ffs-border);border-radius:var(--ffs-radius);padding:10px 14px;cursor:pointer;">
                            <input type="radio" name="SelectedPaymentMethodId" value="@card.CustomerPaymentMethodId" checked="@(Model.SelectedPaymentMethodId == card.CustomerPaymentMethodId)" />
                            <span style="font-size:0.88rem;text-transform:capitalize;">
                                @(card.CardType ?? "Card") ending in @card.Last4
                                @if (card.IsDefault)
                                {
                                    <span class="ffs-product-badge" style="position:static;font-size:0.6rem;margin-left:6px;">Default</span>
                                }
                            </span>
                        </label>
                    }
                    <label style="display:flex;gap:10px;align-items:center;border:1px solid var(--ffs-border);border-radius:var(--ffs-radius);padding:10px 14px;cursor:pointer;">
                        <input type="radio" name="SelectedPaymentMethodId" value="" checked="@(Model.SelectedPaymentMethodId is null)" />
                        <span style="font-size:0.88rem;">+ Pay with a new card</span>
                    </label>
                </div>
            }
            else
            {
                <p style="font-size:0.82rem;color:var(--ffs-ink-muted);">No saved cards yet - you'll pay on Paystack's secure page and can save the card there for next time.</p>
            }

            <label style="display:flex;gap:8px;align-items:flex-start;margin:14px 0 28px;cursor:pointer;">
                <input type="checkbox" asp-for="SaveCard" style="margin-top:3px;" />
                <span>
                    <span style="font-size:0.85rem;">Save this card for next time</span>
                    <div style="font-size:0.78rem;color:var(--ffs-ink-muted);">Only applies when paying with a new card - we never see or store your card number, only a reusable token from Paystack.</div>
                </span>
            </label>

            <button type="submit" class="ffs-btn ffs-btn-forest" style="width:100%;justify-content:center;">Place Order</button>
        </form>
    </div>
</section>
