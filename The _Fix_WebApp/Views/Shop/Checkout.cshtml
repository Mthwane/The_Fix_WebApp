@model CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
    var fallbackImage = "https://placehold.co/64x64?text=No+Image";
}
<div class="container py-4" style="max-width:640px;">
    <h2>Checkout</h2>

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <table class="table table-sm align-middle">
        <thead><tr><th></th><th>Item</th><th>Qty</th><th>Total</th></tr></thead>
        <tbody>
            @foreach (var line in Model.Cart.Lines)
            {
                <tr>
                    <td style="width:56px;">
                        <img src="@(string.IsNullOrWhiteSpace(line.ImageUrl) ? fallbackImage : line.ImageUrl)"
                             alt="@line.Name" class="rounded border" style="width:48px;height:48px;object-fit:cover;" />
                    </td>
                    <td>@line.Name</td>
                    <td>@line.Quantity</td>
                    <td>@line.LineTotal.ToString("C")</td>
                </tr>
            }
        </tbody>
    </table>

    @{
        var vat = FashionFix.Web.Security.TaxSettings.CalculateVat(Model.Cart.SubTotal);
        var total = Model.Cart.SubTotal + vat;
    }
    <div class="d-flex justify-content-between"><span>Subtotal</span><span>@Model.Cart.SubTotal.ToString("C")</span></div>
    <div class="d-flex justify-content-between text-muted"><span>VAT (15%)</span><span>@vat.ToString("C")</span></div>
    <div class="d-flex justify-content-between fs-5 border-top pt-2 mt-2"><strong>Total</strong><strong>@total.ToString("C")</strong></div>

    <form asp-controller="Shop" asp-action="Checkout" method="post" class="mt-4">

        <!-- Delivery address -->
        <h5><i class="bi bi-geo-alt"></i> Deliver To</h5>
        @if (!Model.Addresses.Any())
        {
            <div class="alert alert-warning d-flex justify-content-between align-items-center">
                <span>You don't have a saved address yet.</span>
                <a asp-controller="Customer" asp-action="AddAddress" class="btn btn-sm btn-dark">Add Address</a>
            </div>
        }
        else
        {
            <div class="mb-3">
                @foreach (var address in Model.Addresses)
                {
                    <div class="form-check border rounded p-2 mb-2">
                        <input class="form-check-input" type="radio" name="SelectedAddressId" id="addr-@address.CustomerAddressId"
                               value="@address.CustomerAddressId" checked="@(Model.SelectedAddressId == address.CustomerAddressId)" />
                        <label class="form-check-label w-100" for="addr-@address.CustomerAddressId">
                            <strong>@address.Label</strong>
                            @if (address.IsDefault)
                            {
                                <span class="badge bg-secondary ms-1">Default</span>
                            }
                            <br />
                            <span class="text-muted small">
                                @address.RecipientName &middot; @address.AddressLine1, @address.City, @address.Province @address.PostalCode
                            </span>
                        </label>
                    </div>
                }
                <a asp-controller="Customer" asp-action="AddAddress" class="small"><i class="bi bi-plus-lg"></i> Add a different address</a>
            </div>
        }
        <span asp-validation-for="SelectedAddressId" class="text-danger"></span>

        <hr />

        <!-- Payment -->
        <h5><i class="bi bi-credit-card"></i> Payment</h5>
        <div class="mb-3">
            <label asp-for="PaymentMethod" class="form-label"></label>
            <select asp-for="PaymentMethod" class="form-select">
                <option value="Cash">Cash on delivery</option>
                <option value="CreditCard">Credit Card</option>
                <option value="DebitCard">Debit Card</option>
            </select>
        </div>

        @if (Model.SavedCards.Any())
        {
            <div class="mb-2">
                @foreach (var card in Model.SavedCards)
                {
                    <div class="form-check border rounded p-2 mb-2">
                        <input class="form-check-input" type="radio" name="SelectedPaymentMethodId" id="card-@card.CustomerPaymentMethodId"
                               value="@card.CustomerPaymentMethodId" checked="@(Model.SelectedPaymentMethodId == card.CustomerPaymentMethodId)" />
                        <label class="form-check-label text-capitalize" for="card-@card.CustomerPaymentMethodId">
                            <i class="bi bi-credit-card-2-front"></i> @(card.CardType ?? "Card") ending in @card.Last4
                            @if (card.IsDefault)
                            {
                                <span class="badge bg-secondary ms-1">Default</span>
                            }
                        </label>
                    </div>
                }
                <div class="form-check border rounded p-2 mb-2">
                    <input class="form-check-input" type="radio" name="SelectedPaymentMethodId" id="card-new" value=""
                           checked="@(Model.SelectedPaymentMethodId is null)" />
                    <label class="form-check-label" for="card-new"><i class="bi bi-plus-lg"></i> Pay with a new card</label>
                </div>
            </div>
        }
        else
        {
            <p class="text-muted small">No saved cards yet - you'll pay on Paystack's secure page and can save the card there for next time.</p>
        }

        <div class="form-check mb-3">
            <input asp-for="SaveCard" class="form-check-input" />
            <label asp-for="SaveCard" class="form-check-label">Save this card for next time</label>
            <div class="form-text">Only applies when paying with a new card - we never see or store your card number, only a reusable token from Paystack.</div>
        </div>

        <button type="submit" class="btn btn-danger w-100">Place Order</button>
    </form>
</div>
