@model List<Product>
@{
    ViewData["Title"] = "Shop";
    Layout = "_StorefrontLayout";
    var categories = ViewBag.Categories as List<string> ?? new();
    var searchTerm = ViewBag.SearchTerm as string;
    var selectedCategory = ViewBag.SelectedCategory as string;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;

    string Ph(string label, int w = 500, int h = 650) => $"https://placehold.co/{w}x{h}/E4DEC9/24211B?text={Uri.EscapeDataString(label)}";
}

<section class="ffs-section" style="padding-top:32px;">
    <div class="ffs-container">
        <div class="ffs-section-head">
            <div>
                <span class="ffs-eyebrow">The Full Collection</span>
                <h1 style="font-family:'Fraunces',serif;font-size:2rem;">@(string.IsNullOrWhiteSpace(searchTerm) ? "Shop All" : $"Results for \u201c{searchTerm}\u201d")</h1>
            </div>
            <p>Showing @Model.Count style@(Model.Count == 1 ? "" : "s")</p>
        </div>

        <form method="get" asp-action="Index" style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:32px;">
            <input type="text" name="search" value="@searchTerm" placeholder="Search botanical linen, outerwear..."
                   style="flex:1 1 260px;border:1px solid var(--ffs-border);border-radius:999px;padding:10px 18px;font-size:0.85rem;background:var(--ffs-card);" />
            <select name="category" onchange="this.form.submit()"
                    style="border:1px solid var(--ffs-border);border-radius:999px;padding:10px 18px;font-size:0.85rem;background:var(--ffs-card);">
                <option value="">All Categories</option>
                @foreach (var c in categories)
                {
                    <option value="@c" selected="@(c == selectedCategory)">@c</option>
                }
            </select>
            <button type="submit" class="ffs-btn ffs-btn-forest">Search</button>
            @if (!string.IsNullOrWhiteSpace(searchTerm) || !string.IsNullOrWhiteSpace(selectedCategory))
            {
                <a asp-action="Index" class="ffs-btn ffs-btn-outline">Clear</a>
            }
        </form>

        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <p>No styles match your search.</p>
                <a asp-action="Index" class="ffs-btn ffs-btn-outline">Reset search</a>
            </div>
        }
        else
        {
            <div class="ffs-product-grid">
                @foreach (var product in Model)
                {
                    var variants = product.Variants.Where(v => v.IsActive && v.StockQuantity > 0).ToList();
                    <div class="ffs-product-card">
                        <a asp-controller="Shop" asp-action="Product" asp-route-id="@product.ProductId" class="ffs-product-img-wrap" style="display:block;">
                            <img src="@(product.ImageUrl ?? Ph(product.Name))" alt="@product.Name" />
                            @if (!string.IsNullOrWhiteSpace(product.Badge))
                            {
                                <span class="ffs-product-badge @(product.IsOnSale ? "ffs-badge-clay" : "")">@product.Badge</span>
                            }
                        </a>
                        <button type="button" class="ffs-wishlist-btn" title="Save to wishlist" onclick="location.href='@Url.Action("Login", "Account", new { returnUrl })'">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8Z"/></svg>
                        </button>
                        <div class="ffs-product-meta">
                            @if (product.ReviewCount > 0)
                            {
                                <div class="ffs-product-rating"><span class="star">&#9733;</span> @product.AverageRating.ToString("0.0") <span>(@product.ReviewCount)</span></div>
                            }
                            <a asp-controller="Shop" asp-action="Product" asp-route-id="@product.ProductId" class="ffs-product-name" style="display:block;">@product.Name</a>
                            @if (!string.IsNullOrWhiteSpace(product.Material))
                            {
                                <div class="ffs-product-desc">@product.Material</div>
                            }
                            <div class="ffs-product-price-row">
                                <span class="ffs-price">@product.SellingPrice.ToString("N0")</span>
                                @if (product.IsOnSale)
                                {
                                    <span class="ffs-price-was">@product.CompareAtPrice!.Value.ToString("N0")</span>
                                }
                            </div>

                            @{ var swatches = variants.Where(v => v.Color != null).GroupBy(v => v.Color).Select(g => g.First()).Take(5).ToList(); }
                            @if (swatches.Count > 0)
                            {
                                <div class="ffs-swatches">
                                    @foreach (var v in swatches)
                                    {
                                        <span class="ffs-swatch" style="background:@(v.ColorHex ?? v.Color);" title="@v.Color"></span>
                                    }
                                </div>
                            }

                            @if (variants.Count > 0)
                            {
                                <form asp-controller="Shop" asp-action="AddToCart" method="post" style="display:flex;gap:6px;margin-top:10px;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                    <select name="variantId" class="form-select form-select-sm" style="font-size:0.78rem;">
                                        @foreach (var v in variants)
                                        {
                                            <option value="@v.ProductVariantId">@v.Size / @v.Color &mdash; @v.StockQuantity left</option>
                                        }
                                    </select>
                                    <button type="submit" class="ffs-btn ffs-btn-forest" style="padding:8px 14px;font-size:0.78rem;white-space:nowrap;">Add</button>
                                </form>
                            }
                            else
                            {
                                <div class="ffs-btn ffs-btn-outline" style="margin-top:10px;padding:8px 14px;font-size:0.78rem;text-align:center;opacity:.6;">Out of stock</div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

