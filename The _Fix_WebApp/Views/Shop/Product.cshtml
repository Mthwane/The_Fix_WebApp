@model ProductDetailViewModel
@{
    var product = Model.Product;
    ViewData["Title"] = product.Name;
    Layout = "_StorefrontLayout";

    string Ph(string label, int w = 800, int h = 1000) => $"https://placehold.co/{w}x{h}/E4DEC9/24211B?text={Uri.EscapeDataString(label)}";

    var galleryImages = new List<string>();
    if (!string.IsNullOrWhiteSpace(product.ImageUrl)) galleryImages.Add(product.ImageUrl);
    galleryImages.AddRange(Model.Images.Select(i => i.ImageUrl));
    if (galleryImages.Count == 0) galleryImages.Add(Ph(product.Name));

    var activeVariants = product.Variants.Where(v => v.IsActive && v.StockQuantity > 0).ToList();
}

<section class="ffs-section" style="padding-top:28px;">
    <div class="ffs-container">
        <div style="font-size:0.78rem;color:var(--ffs-ink-muted);margin-bottom:18px;">
            <a asp-controller="Home" asp-action="Index">Home</a>
            @if (product.Department is not null)
            {
                <text> &rsaquo; <a asp-controller="Shop" asp-action="Department" asp-route-slug="@product.Department.Slug">@product.Department.Name</a></text>
            }
            <text> &rsaquo; @product.Name</text>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:44px;align-items:flex-start;">
            <div>
                <div class="ffs-hero-image" style="aspect-ratio:4/5;margin-bottom:10px;">
                    <img id="mainProductImage" src="@galleryImages[0].Sized(1000)" alt="@product.Name" />
                </div>
                @if (galleryImages.Count > 1)
                {
                    <div style="display:flex;gap:8px;">
                        @foreach (var img in galleryImages)
                        {
                            <button type="button" onclick="document.getElementById('mainProductImage').src='@img.Sized(1000)'"
                                    style="border:1px solid var(--ffs-border);border-radius:8px;overflow:hidden;padding:0;width:64px;height:80px;background:none;cursor:pointer;">
                                <img src="@img.Sized(160)" alt="" style="width:100%;height:100%;object-fit:cover;display:block;" />
                            </button>
                        }
                    </div>
                }
            </div>

            <div>
                @if (!string.IsNullOrWhiteSpace(product.Badge))
                {
                    <span class="ffs-product-badge @(product.IsOnSale ? "ffs-badge-clay" : "")" style="position:static;display:inline-block;margin-bottom:10px;">@product.Badge</span>
                }
                <h1 style="font-size:1.9rem;margin-bottom:8px;">@product.Name</h1>

                @if (product.ReviewCount > 0)
                {
                    <div class="ffs-product-rating" style="font-size:0.85rem;margin-bottom:12px;">
                        <span class="star">&#9733;</span> @product.AverageRating.ToString("0.0") <span>(@product.ReviewCount review@(product.ReviewCount == 1 ? "" : "s"))</span>
                    </div>
                }

                <div class="ffs-product-price-row" style="margin-bottom:16px;">
                    <span class="ffs-price" style="font-size:1.4rem;">R@(product.SellingPrice.ToString("N2"))</span>
                    @if (product.IsOnSale)
                    {
                        <span class="ffs-price-was">R@(product.CompareAtPrice!.Value.ToString("N2"))</span>
                        <span class="ffs-product-badge ffs-badge-clay" style="position:static;">@(product.DiscountPercentage)% off</span>
                    }
                </div>

                @foreach (var linked in Model.LinkedDiscounts)
                {
                    <div class="ffs-linked-discount">
                        <span class="ffs-product-badge ffs-badge-clay" style="position:static;">@linked.ValueLabel()</span>
                        <span>@(string.IsNullOrWhiteSpace(linked.BannerText) ? linked.Name : linked.BannerText) - use code</span>
                        <code>@linked.Code</code>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(product.Description))
                {
                    <p style="color:var(--ffs-ink-muted);font-size:0.92rem;margin-bottom:20px;">@product.Description</p>
                }

                <div style="display:flex;gap:18px;flex-wrap:wrap;font-size:0.82rem;color:var(--ffs-ink-muted);margin-bottom:24px;">
                    @if (!string.IsNullOrWhiteSpace(product.Material))
                    {
                        <span><b style="color:var(--ffs-ink);">Material:</b> @product.Material</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(product.Fit))
                    {
                        <span><b style="color:var(--ffs-ink);">Fit:</b> @product.Fit</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(product.Brand))
                    {
                        <span><b style="color:var(--ffs-ink);">Brand:</b> @product.Brand</span>
                    }
                </div>

                @if (activeVariants.Count > 0)
                {
                    // Every size the style has ever been sold in (so sold-out sizes show crossed out, like the reference),
                    // grouped by colour. A size button is only selectable for the chosen colour if that combination is in stock.
                    var allVariants = product.Variants.Where(v => v.IsActive).ToList();
                    var colours = allVariants.Where(v => !string.IsNullOrWhiteSpace(v.Color))
                        .GroupBy(v => v.Color!).Select(g => g.First()).ToList();
                    var sizeOrder = allVariants.Where(v => !string.IsNullOrWhiteSpace(v.Size))
                        .Select(v => v.DisplaySize ?? v.Size!).Distinct()
                        .OrderBy(x => double.TryParse(new string(x.Where(c => char.IsDigit(c) || c == '.').ToArray()), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var n) ? n : 1000)
                        .ThenBy(x => x).ToList();
                    var isFootwear = ProductViewModel.IsFootwear(product.Category);
                    var firstInStock = activeVariants.First();
                    var variantJson = allVariants.Select(v => new { id = v.ProductVariantId, size = v.DisplaySize ?? v.Size ?? "", color = v.Color ?? "", stock = v.IsActive ? v.StockQuantity : 0 });

                    <form asp-controller="Shop" asp-action="AddToCart" method="post" id="variantForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                        <input type="hidden" name="variantId" id="variantId" value="@firstInStock.ProductVariantId" />

                        @if (colours.Count > 0)
                        {
                            <div class="ffs-opt-head"><span>Colour</span> <b id="colourName">@firstInStock.Color</b><i></i></div>
                            <div class="ffs-colour-row" role="radiogroup" aria-label="Colour">
                                @foreach (var c in colours)
                                {
                                    var hex = !string.IsNullOrWhiteSpace(c.ColorHex) ? c.ColorHex : (ProductViewModel.ColorHexMap.TryGetValue(c.Color!, out var h) ? h : "#999999");
                                    var colourInStock = allVariants.Any(v => v.Color == c.Color && v.StockQuantity > 0);
                                    <button type="button" class="ffs-colour-chip @(c.Color == firstInStock.Color ? "is-active" : "") @(colourInStock ? "" : "is-out")" data-colour="@c.Color" title="@c.Color" aria-label="@c.Color" role="radio" aria-checked="@(c.Color == firstInStock.Color ? "true" : "false")">
                                        <span style="background:@hex;"></span>
                                    </button>
                                }
                            </div>
                        }

                        @if (sizeOrder.Count > 0)
                        {
                            <div class="ffs-opt-head"><span>@(isFootwear ? "Size (UK)" : "Size")</span> <b id="sizeName"></b><i></i></div>
                            <div class="ffs-size-grid" role="radiogroup" aria-label="Size">
                                @foreach (var sz in sizeOrder)
                                {
                                    <button type="button" class="ffs-size-btn" data-size="@sz" role="radio" aria-checked="false">@sz</button>
                                }
                            </div>
                            <div id="stockNote" class="ffs-stock-note"></div>
                        }

                        <div style="display:flex;gap:10px;align-items:center;margin-top:18px;">
                            <input type="number" name="quantity" value="1" min="1" class="form-control" style="width:80px;" />
                            <button type="submit" id="addBtn" class="ffs-btn ffs-btn-forest">Add to Cart</button>
                        </div>
                    </form>
                    <script id="variantData" type="application/json">@Html.Raw(Json.Serialize(variantJson))</script>
                    <script>
                        (function () {
                            var variants = JSON.parse(document.getElementById('variantData').textContent);
                            var hasColour = document.querySelectorAll('.ffs-colour-chip').length > 0;
                            var hasSize = document.querySelectorAll('.ffs-size-btn').length > 0;
                            var colour = hasColour ? (document.querySelector('.ffs-colour-chip.is-active') || {}).dataset.colour : '';
                            var size = '@(firstInStock.DisplaySize ?? firstInStock.Size)';
                            var idInput = document.getElementById('variantId');
                            var addBtn = document.getElementById('addBtn');

                            function find(c, s) {
                                return variants.filter(function (v) { return (!hasColour || v.color === c) && (!hasSize || v.size === s); })[0];
                            }
                            function render() {
                                // If the chosen size doesn't exist in stock for this colour, jump to the first one that does.
                                var cur = find(colour, size);
                                if (!cur || cur.stock <= 0) {
                                    var alt = variants.filter(function (v) { return (!hasColour || v.color === colour) && v.stock > 0; })[0];
                                    if (alt) { size = alt.size; cur = alt; }
                                }
                                document.querySelectorAll('.ffs-colour-chip').forEach(function (b) {
                                    var on = b.dataset.colour === colour;
                                    b.classList.toggle('is-active', on); b.setAttribute('aria-checked', on);
                                });
                                document.querySelectorAll('.ffs-size-btn').forEach(function (b) {
                                    var v = find(colour, b.dataset.size);
                                    var out = !v || v.stock <= 0;
                                    b.classList.toggle('is-out', out);
                                    b.disabled = out;
                                    var on = b.dataset.size === size && !out;
                                    b.classList.toggle('is-active', on); b.setAttribute('aria-checked', on);
                                });
                                var cn = document.getElementById('colourName'); if (cn) cn.textContent = colour;
                                var sn = document.getElementById('sizeName'); if (sn) sn.textContent = cur && cur.stock > 0 ? size : '';
                                var note = document.getElementById('stockNote');
                                if (cur && cur.stock > 0) {
                                    idInput.value = cur.id; addBtn.disabled = false;
                                    if (note) note.textContent = cur.stock <= 5 ? 'Only ' + cur.stock + ' left' : '';
                                } else {
                                    addBtn.disabled = true;
                                    if (note) note.textContent = 'Currently unavailable in this colour';
                                }
                            }
                            document.querySelectorAll('.ffs-colour-chip').forEach(function (b) {
                                b.addEventListener('click', function () { colour = b.dataset.colour; render(); });
                            });
                            document.querySelectorAll('.ffs-size-btn').forEach(function (b) {
                                b.addEventListener('click', function () { if (!b.disabled) { size = b.dataset.size; render(); } });
                            });
                            render();
                        })();
                    </script>
                }
                else
                {
                    <div class="ffs-btn ffs-btn-outline" style="opacity:.6;display:inline-block;">Currently out of stock</div>
                }

                <div style="margin-top:16px;">
                    @if (Model.IsWishlisted)
                    {
                        <form asp-controller="Customer" asp-action="ToggleWishlist" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@product.ProductId" />
                            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                            <button type="submit" class="ffs-btn ffs-btn-outline" style="font-size:0.82rem;">&#9829; Saved to Wishlist</button>
                        </form>
                    }
                    else
                    {
                        <button type="button" class="ffs-btn ffs-btn-outline" style="font-size:0.82rem;"
                                onclick="location.href='@Url.Action("Login", "Account", new { returnUrl = Model.ReturnUrl })'">
                            &#9825; Save to Wishlist
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<section class="ffs-section ffs-section-alt">
    <div class="ffs-container" style="max-width:820px;">
        <h2 style="margin-bottom:24px;">Reviews</h2>

        @if (Model.CanReview)
        {
            <style>
                .rv-form { background:var(--ffs-card);border:1px solid var(--ffs-border);border-radius:var(--ffs-radius);padding:24px;margin-bottom:28px; }
                .rv-form h3 { font-family:'Fraunces',serif;font-size:1.15rem;margin:0 0 4px; }
                .rv-form .rv-sub { font-size:0.82rem;color:var(--ffs-ink-muted);margin:0 0 18px; }
                .rv-label { font-size:0.8rem;font-weight:600;letter-spacing:.04em;text-transform:uppercase;display:block;margin-bottom:8px; }
                .rv-stars { display:inline-flex;flex-direction:row-reverse;gap:4px;margin-bottom:18px; }
                .rv-stars input { position:absolute;opacity:0;width:0;height:0; }
                .rv-stars label { font-size:2rem;line-height:1;color:var(--ffs-border);cursor:pointer;transition:color .12s, transform .12s; }
                .rv-stars label:hover, .rv-stars label:hover ~ label, .rv-stars input:checked ~ label { color:var(--ffs-clay); }
                .rv-stars label:hover { transform:scale(1.12); }
                .rv-stars input:focus-visible + label { outline:2px solid var(--ffs-forest);outline-offset:2px;border-radius:4px; }
                .rv-text { width:100%;box-sizing:border-box;border:1px solid var(--ffs-border);border-radius:10px;padding:12px 14px;font:inherit;font-size:0.9rem;background:#fff;resize:vertical;margin-bottom:18px; }
                .rv-text:focus { outline:none;border-color:var(--ffs-forest);box-shadow:0 0 0 3px rgba(47,89,67,.12); }
                .rv-drop { display:flex;align-items:center;gap:12px;border:1.5px dashed var(--ffs-border);border-radius:10px;padding:14px 16px;cursor:pointer;margin-bottom:10px;background:#fff; }
                .rv-drop:hover { border-color:var(--ffs-forest); }
                .rv-drop input { display:none; }
                .rv-drop-icon { width:36px;height:36px;border-radius:50%;background:var(--ffs-forest);color:#fff;display:flex;align-items:center;justify-content:center;font-size:1.2rem;flex-shrink:0; }
                .rv-previews { display:flex;gap:10px;flex-wrap:wrap;margin-bottom:18px; }
                .rv-previews img { width:72px;height:72px;object-fit:cover;border-radius:8px;border:1px solid var(--ffs-border); }
                .rv-photos { display:flex;gap:8px;flex-wrap:wrap;margin-top:10px; }
                .rv-photos a { display:block; }
                .rv-photos img { width:84px;height:84px;object-fit:cover;border-radius:8px;border:1px solid var(--ffs-border); }
            </style>
            <form asp-controller="Shop" asp-action="SubmitReview" method="post" enctype="multipart/form-data" class="rv-form">
                <h3>Write a review</h3>
                <p class="rv-sub">Tell other shoppers how this piece wears.</p>
                <input type="hidden" name="productId" value="@product.ProductId" />

                <span class="rv-label">Your rating</span>
                <div class="rv-stars" role="radiogroup" aria-label="Rating">
                    @for (var star = 5; star >= 1; star--)
                    {
                        <input type="radio" name="rating" id="star@(star)" value="@star" required />
                        <label for="star@(star)" title="@star star@(star == 1 ? "" : "s")">&#9733;</label>
                    }
                </div>

                <label class="rv-label" for="rvComment">Your review (optional)</label>
                <textarea id="rvComment" name="comment" class="rv-text" rows="4" maxlength="2000" placeholder="Fit, fabric, comfort..."></textarea>

                <span class="rv-label">Photos (optional, up to 3)</span>
                <label class="rv-drop">
                    <span class="rv-drop-icon">+</span>
                    <span style="font-size:0.88rem;">Add photos <span style="color:var(--ffs-ink-muted);">JPG, PNG or WebP, max 5 MB each</span></span>
                    <input type="file" name="photos" id="rvPhotos" accept="image/jpeg,image/png,image/webp" multiple />
                </label>
                <div class="rv-previews" id="rvPreviews"></div>

                <button type="submit" class="ffs-btn ffs-btn-forest">Post Review</button>
            </form>
            <script>
                (function () {
                    var input = document.getElementById('rvPhotos');
                    var box = document.getElementById('rvPreviews');
                    if (!input) return;
                    input.addEventListener('change', function () {
                        box.innerHTML = '';
                        var files = Array.prototype.slice.call(input.files, 0, 3);
                        if (input.files.length > 3) alert('Only the first 3 photos will be uploaded.');
                        files.forEach(function (f) {
                            var img = document.createElement('img');
                            img.src = URL.createObjectURL(f);
                            box.appendChild(img);
                        });
                    });
                })();
            </script>
        }
        else if (User.Identity?.IsAuthenticated != true)
        {
            <p style="color:var(--ffs-ink-muted);font-size:0.88rem;margin-bottom:28px;">
                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Sign in</a> to write a review.
            </p>
        }

        @if (Model.Reviews.Count == 0)
        {
            <p style="color:var(--ffs-ink-muted);">No reviews yet - be the first to share how this piece wears.</p>
        }
        else
        {
            // Compact list, same feel as the order-history list: one bordered row per review, small thumbnails to the right.
            <div class="ffs-review-list">
                @foreach (var review in Model.Reviews)
                {
                    <div class="ffs-review-row">
                        <div class="ffs-review-top">
                            <span class="ffs-review-stars">@(new string('\u2605', review.Rating))<span class="off">@(new string('\u2606', 5 - review.Rating))</span></span>
                            <span class="ffs-review-who">@(review.Customer?.FullName ?? "Fashion Fix Customer")</span>
                            @if (review.IsVerifiedPurchase)
                            {
                                <span class="ffs-review-verified">Verified purchase</span>
                            }
                            <span class="ffs-review-date">@review.DateCreated.ToString("dd MMM yyyy")</span>
                        </div>
                        <div class="ffs-review-body">
                            @if (!string.IsNullOrWhiteSpace(review.Comment))
                            {
                                <p>@review.Comment</p>
                            }
                            @if (review.Photos.Count > 0)
                            {
                                <div class="ffs-review-photos">
                                    @foreach (var photo in review.Photos)
                                    {
                                        <a href="@photo" target="_blank" rel="noopener"><img src="@photo.Sized(120)" alt="Review photo" loading="lazy" /></a>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
