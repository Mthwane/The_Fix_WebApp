@model ProductDetailViewModel
@{
    var product = Model.Product;
    ViewData["Title"] = product.Name;
    Layout = "_StorefrontLayout";

    string Ph(string label, int w = 800, int h = 1000) => $"https://placehold.co/{w}x{h}/E4DEC9/24211B?text={Uri.EscapeDataString(label)}";

    var galleryImages = new List<string>();
    if (!string.IsNullOrWhiteSpace(product.ImageUrl)) galleryImages.Add(product.ImageUrl);
    galleryImages.AddRange(Model.Images.Select(i => i.ImageUrl));
    if (galleryImages.Count == 0) galleryImages.Add(Ph(product.Name));

    var activeVariants = product.Variants.Where(v => v.IsActive && v.StockQuantity > 0).ToList();
}

<section class="ffs-section" style="padding-top:28px;">
    <div class="ffs-container">
        <div style="font-size:0.78rem;color:var(--ffs-ink-muted);margin-bottom:18px;">
            <a asp-controller="Home" asp-action="Index">Home</a>
            @if (product.Department is not null)
            {
                <text> &rsaquo; <a asp-controller="Shop" asp-action="Department" asp-route-slug="@product.Department.Slug">@product.Department.Name</a></text>
            }
            <text> &rsaquo; @product.Name</text>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:44px;align-items:flex-start;">
            <div>
                <div class="ffs-hero-image" style="aspect-ratio:4/5;margin-bottom:10px;">
                    <img id="mainProductImage" src="@galleryImages[0]" alt="@product.Name" />
                </div>
                @if (galleryImages.Count > 1)
                {
                    <div style="display:flex;gap:8px;">
                        @foreach (var img in galleryImages)
                        {
                            <button type="button" onclick="document.getElementById('mainProductImage').src='@img'"
                                    style="border:1px solid var(--ffs-border);border-radius:8px;overflow:hidden;padding:0;width:64px;height:80px;background:none;cursor:pointer;">
                                <img src="@img" alt="" style="width:100%;height:100%;object-fit:cover;display:block;" />
                            </button>
                        }
                    </div>
                }
            </div>

            <div>
                @if (!string.IsNullOrWhiteSpace(product.Badge))
                {
                    <span class="ffs-product-badge @(product.IsOnSale ? "ffs-badge-clay" : "")" style="position:static;display:inline-block;margin-bottom:10px;">@product.Badge</span>
                }
                <h1 style="font-size:1.9rem;margin-bottom:8px;">@product.Name</h1>

                @if (product.ReviewCount > 0)
                {
                    <div class="ffs-product-rating" style="font-size:0.85rem;margin-bottom:12px;">
                        <span class="star">&#9733;</span> @product.AverageRating.ToString("0.0") <span>(@product.ReviewCount review@(product.ReviewCount == 1 ? "" : "s"))</span>
                    </div>
                }

                <div class="ffs-product-price-row" style="margin-bottom:16px;">
                    <span class="ffs-price" style="font-size:1.4rem;">R@product.SellingPrice.ToString("N2")</span>
                    @if (product.IsOnSale)
                    {
                        <span class="ffs-price-was">R@product.CompareAtPrice!.Value.ToString("N2")</span>
                        <span class="ffs-product-badge ffs-badge-clay" style="position:static;">@(product.DiscountPercentage)% off</span>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(product.Description))
                {
                    <p style="color:var(--ffs-ink-muted);font-size:0.92rem;margin-bottom:20px;">@product.Description</p>
                }

                <div style="display:flex;gap:18px;flex-wrap:wrap;font-size:0.82rem;color:var(--ffs-ink-muted);margin-bottom:24px;">
                    @if (!string.IsNullOrWhiteSpace(product.Material))
                    {
                        <span><b style="color:var(--ffs-ink);">Material:</b> @product.Material</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(product.Fit))
                    {
                        <span><b style="color:var(--ffs-ink);">Fit:</b> @product.Fit</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(product.Brand))
                    {
                        <span><b style="color:var(--ffs-ink);">Brand:</b> @product.Brand</span>
                    }
                </div>

                @if (activeVariants.Count > 0)
                {
                    <form asp-controller="Shop" asp-action="AddToCart" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                        <label style="font-size:0.82rem;font-weight:600;display:block;margin-bottom:6px;">Size / Colour</label>
                        <select name="variantId" class="form-select" style="max-width:320px;margin-bottom:14px;">
                            @foreach (var v in activeVariants)
                            {
                                <option value="@v.ProductVariantId">@v.Size / @v.Color &mdash; @v.StockQuantity in stock</option>
                            }
                        </select>
                        <div style="display:flex;gap:10px;align-items:center;">
                            <input type="number" name="quantity" value="1" min="1" class="form-control" style="width:80px;" />
                            <button type="submit" class="ffs-btn ffs-btn-forest">Add to Cart</button>
                        </div>
                    </form>
                }
                else
                {
                    <div class="ffs-btn ffs-btn-outline" style="opacity:.6;display:inline-block;">Currently out of stock</div>
                }

                <div style="margin-top:16px;">
                    @if (Model.IsWishlisted)
                    {
                        <form asp-controller="Customer" asp-action="ToggleWishlist" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@product.ProductId" />
                            <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                            <button type="submit" class="ffs-btn ffs-btn-outline" style="font-size:0.82rem;">&#9829; Saved to Wishlist</button>
                        </form>
                    }
                    else
                    {
                        <button type="button" class="ffs-btn ffs-btn-outline" style="font-size:0.82rem;"
                                onclick="location.href='@Url.Action("Login", "Account", new { returnUrl = Model.ReturnUrl })'">
                            &#9825; Save to Wishlist
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<section class="ffs-section ffs-section-alt">
    <div class="ffs-container" style="max-width:820px;">
        <h2 style="margin-bottom:24px;">Reviews</h2>

        @if (Model.CanReview)
        {
            <form asp-controller="Shop" asp-action="SubmitReview" method="post" style="background:var(--ffs-card);border:1px solid var(--ffs-border);border-radius:var(--ffs-radius);padding:20px;margin-bottom:28px;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="productId" value="@product.ProductId" />
                <label style="font-size:0.85rem;font-weight:600;display:block;margin-bottom:6px;">Your rating</label>
                <select name="rating" class="form-select" style="max-width:160px;margin-bottom:12px;" required>
                    <option value="">Choose...</option>
                    <option value="5">&#9733;&#9733;&#9733;&#9733;&#9733; Excellent</option>
                    <option value="4">&#9733;&#9733;&#9733;&#9733; Good</option>
                    <option value="3">&#9733;&#9733;&#9733; Average</option>
                    <option value="2">&#9733;&#9733; Poor</option>
                    <option value="1">&#9733; Very Poor</option>
                </select>
                <label style="font-size:0.85rem;font-weight:600;display:block;margin-bottom:6px;">Your review (optional)</label>
                <textarea name="comment" class="form-control" rows="3" maxlength="2000" style="margin-bottom:14px;" placeholder="How did this piece wear? Fit, fabric, comfort..."></textarea>
                <button type="submit" class="ffs-btn ffs-btn-forest">Post Review</button>
            </form>
        }
        else if (User.Identity?.IsAuthenticated != true)
        {
            <p style="color:var(--ffs-ink-muted);font-size:0.88rem;margin-bottom:28px;">
                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Sign in</a> to write a review.
            </p>
        }

        @if (Model.Reviews.Count == 0)
        {
            <p style="color:var(--ffs-ink-muted);">No reviews yet - be the first to share how this piece wears.</p>
        }
        else
        {
            <div style="display:flex;flex-direction:column;gap:18px;">
                @foreach (var review in Model.Reviews)
                {
                    <div style="border-bottom:1px solid var(--ffs-border);padding-bottom:16px;">
                        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
                            <div>
                                <span style="color:var(--ffs-clay);">@(new string('\u2605', review.Rating))@(new string('\u2606', 5 - review.Rating))</span>
                                @if (review.IsVerifiedPurchase)
                                {
                                    <span style="font-size:0.7rem;color:var(--ffs-forest);font-weight:600;margin-left:6px;">VERIFIED PURCHASE</span>
                                }
                            </div>
                            <span style="font-size:0.75rem;color:var(--ffs-ink-muted);">@review.DateCreated.ToString("MMM d, yyyy")</span>
                        </div>
                        <p style="font-size:0.8rem;color:var(--ffs-ink-muted);margin-bottom:4px;">@(review.Customer?.FullName ?? "Fashion Fix Customer")</p>
                        @if (!string.IsNullOrWhiteSpace(review.Comment))
                        {
                            <p style="font-size:0.9rem;margin:0;">@review.Comment</p>
                        }
                    </div>
                }
            </div>
        }
    </div>
</section>
