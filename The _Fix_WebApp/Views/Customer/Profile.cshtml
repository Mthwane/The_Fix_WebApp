@model CustomerProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="container py-4" style="max-width: 900px;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">My Profile</h2>
        <div class="d-flex gap-2">
            <a asp-controller="Customer" asp-action="Orders" class="btn btn-outline-secondary btn-sm">&larr; My Orders</a>
            <a asp-controller="Shop" asp-action="Index" class="btn btn-danger btn-sm"><i class="bi bi-cart3"></i> Shop Now</a>
        </div>
    </div>

    @if (TempData["ProfileMessage"] is string msg)
    {
        <div class="alert alert-success">@msg</div>
    }

    <div class="mb-4" style="max-width: 500px;">
        <label class="form-label">Customer ID</label>
        <div class="input-group">
            <input type="text" id="customerIdField" class="form-control" value="@Model.CustomerId" readonly />
            <button type="button" class="btn btn-outline-secondary" onclick="navigator.clipboard.writeText(document.getElementById('customerIdField').value); this.textContent='Copied!'; setTimeout(() => this.textContent='Copy', 1500);">Copy</button>
        </div>
        <div class="form-text">Give this to store staff at checkout so a purchase links to your account and order history.</div>
    </div>

    <form asp-controller="Customer" asp-action="Profile" method="post" style="max-width: 500px;">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="FullName" class="form-label"></label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" type="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="PhoneNumber" class="form-label"></label>
            <input asp-for="PhoneNumber" class="form-control" />
            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-danger">Save Changes</button>
    </form>

    <hr class="my-4" />

    <!-- Saved delivery addresses - picked at checkout so the customer never retypes an
         address. First one added becomes the default automatically. -->
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h4 class="mb-0"><i class="bi bi-geo-alt"></i> Delivery Addresses</h4>
        <a asp-controller="Customer" asp-action="AddAddress" class="btn btn-sm btn-outline-danger"><i class="bi bi-plus-lg"></i> Add Address</a>
    </div>

    @{
        var addresses = (List<CustomerAddress>)(ViewBag.Addresses ?? new List<CustomerAddress>());
    }
    @if (!addresses.Any())
    {
        <div class="alert alert-light border">No saved addresses yet. Add one so checkout can skip straight to payment next time.</div>
    }
    else
    {
        <div class="row g-2 mb-2">
            @foreach (var address in addresses)
            {
                <div class="col-12 col-md-6">
                    <div class="card h-100 @(address.IsDefault ? "border-danger" : "")">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <h6 class="card-title mb-1">
                                    @address.Label
                                    @if (address.IsDefault)
                                    {
                                        <span class="badge bg-danger ms-1">Default</span>
                                    }
                                </h6>
                            </div>
                            <p class="card-text small text-muted mb-2">
                                @address.RecipientName &middot; @address.PhoneNumber<br />
                                @address.AddressLine1
                                @if (!string.IsNullOrWhiteSpace(address.AddressLine2))
                                {
                                    <text>, @address.AddressLine2</text>
                                }
                                <br />
                                @address.City, @address.Province @address.PostalCode
                            </p>
                            <div class="d-flex gap-2">
                                <a asp-controller="Customer" asp-action="EditAddress" asp-route-id="@address.CustomerAddressId" class="btn btn-sm btn-outline-secondary">Edit</a>
                                @if (!address.IsDefault)
                                {
                                    <form asp-controller="Customer" asp-action="SetDefaultAddress" asp-route-id="@address.CustomerAddressId" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-primary">Make Default</button>
                                    </form>
                                }
                                <form asp-controller="Customer" asp-action="DeleteAddress" asp-route-id="@address.CustomerAddressId" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Remove this address?');">Remove</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <hr class="my-4" />

    <!-- Saved cards. Only ever populated automatically - after a checkout where the customer
         ticked "save this card" - never typed in here, since a real card number is only ever
         seen by Paystack, not this app. -->
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h4 class="mb-0"><i class="bi bi-credit-card"></i> Saved Cards</h4>
    </div>

    @{
        var paymentMethods = (List<CustomerPaymentMethod>)(ViewBag.PaymentMethods ?? new List<CustomerPaymentMethod>());
    }
    @if (!paymentMethods.Any())
    {
        <div class="alert alert-light border">No saved cards yet. Tick "Save this card for next time" during checkout and it'll show up here.</div>
    }
    else
    {
        <div class="row g-2">
            @foreach (var card in paymentMethods)
            {
                <div class="col-12 col-md-6">
                    <div class="card h-100 @(card.IsDefault ? "border-danger" : "")">
                        <div class="card-body d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-semibold text-capitalize">
                                    <i class="bi bi-credit-card-2-front"></i> @(card.CardType ?? "Card") ending in @card.Last4
                                    @if (card.IsDefault)
                                    {
                                        <span class="badge bg-danger ms-1">Default</span>
                                    }
                                </div>
                                <div class="small text-muted">
                                    Expires @(card.ExpiryMonth?.ToString("00") ?? "--")/@(card.ExpiryYear?.ToString() ?? "----")
                                    @if (!string.IsNullOrWhiteSpace(card.Bank))
                                    {
                                        <text>&middot; @card.Bank</text>
                                    }
                                </div>
                            </div>
                            <div class="d-flex flex-column gap-1">
                                @if (!card.IsDefault)
                                {
                                    <form asp-controller="Customer" asp-action="SetDefaultPaymentMethod" asp-route-id="@card.CustomerPaymentMethodId" method="post">
                                        <button type="submit" class="btn btn-sm btn-outline-primary">Make Default</button>
                                    </form>
                                }
                                <form asp-controller="Customer" asp-action="RemovePaymentMethod" asp-route-id="@card.CustomerPaymentMethodId" method="post">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Remove this card?');">Remove</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
