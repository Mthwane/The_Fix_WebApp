@model CustomerProfileViewModel
@{
    ViewData["Title"] = "My Profile";
    Layout = "_StorefrontLayout";
    var addresses = (List<CustomerAddress>)(ViewBag.Addresses ?? new List<CustomerAddress>());
    var paymentMethods = (List<CustomerPaymentMethod>)(ViewBag.PaymentMethods ?? new List<CustomerPaymentMethod>());
}

<section class="ffs-section" style="padding-top:32px;">
    <div class="ffs-container" style="max-width:760px;">
        <div class="ffs-section-head">
            <div>
                <span class="ffs-eyebrow">Account</span>
                <h1 style="font-family:'Fraunces',serif;font-size:1.9rem;">My Profile</h1>
            </div>
            <div style="display:flex;gap:10px;">
                <a asp-controller="Customer" asp-action="Orders" class="ffs-btn ffs-btn-outline">&larr; My Orders</a>
                <a asp-controller="Shop" asp-action="Index" class="ffs-btn ffs-btn-forest">Shop Now</a>
            </div>
        </div>

        @if (TempData["ProfileMessage"] is string msg)
        {
            <div style="background:var(--ffs-sage);color:var(--ffs-sage-text);border-radius:var(--ffs-radius);padding:12px 18px;font-size:0.88rem;margin-bottom:20px;">@msg</div>
        }

        <div style="margin-bottom:28px;">
            <label style="font-size:0.85rem;font-weight:600;display:block;margin-bottom:6px;">Customer ID</label>
            <div style="display:flex;gap:8px;">
                <input type="text" id="customerIdField" readonly value="@Model.CustomerId"
                       style="flex:1;border:1px solid var(--ffs-border);border-radius:8px;padding:9px 14px;font-size:0.85rem;background:var(--ffs-cream-alt);" />
                <button type="button" class="ffs-btn ffs-btn-outline" style="padding:9px 16px;font-size:0.8rem;"
                        onclick="navigator.clipboard.writeText(document.getElementById('customerIdField').value); this.textContent='Copied!'; setTimeout(() => this.textContent='Copy', 1500);">Copy</button>
            </div>
            <div style="font-size:0.78rem;color:var(--ffs-ink-muted);margin-top:4px;">Give this to store staff at checkout so a purchase links to your account and order history.</div>
        </div>

        <form asp-controller="Customer" asp-action="Profile" method="post" style="margin-bottom:32px;">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" style="color:var(--ffs-clay);margin-bottom:10px;"></div>

            <div style="margin-bottom:14px;">
                <label asp-for="FullName" class="form-label" style="font-size:0.85rem;font-weight:600;"></label>
                <input asp-for="FullName" style="width:100%;border:1px solid var(--ffs-border);border-radius:8px;padding:9px 14px;font-size:0.88rem;" />
                <span asp-validation-for="FullName" style="color:var(--ffs-clay);font-size:0.8rem;"></span>
            </div>
            <div style="margin-bottom:14px;">
                <label asp-for="Email" class="form-label" style="font-size:0.85rem;font-weight:600;"></label>
                <input asp-for="Email" type="email" style="width:100%;border:1px solid var(--ffs-border);border-radius:8px;padding:9px 14px;font-size:0.88rem;" />
                <span asp-validation-for="Email" style="color:var(--ffs-clay);font-size:0.8rem;"></span>
            </div>
            <div style="margin-bottom:18px;">
                <label asp-for="PhoneNumber" class="form-label" style="font-size:0.85rem;font-weight:600;"></label>
                <input asp-for="PhoneNumber" style="width:100%;border:1px solid var(--ffs-border);border-radius:8px;padding:9px 14px;font-size:0.88rem;" />
                <span asp-validation-for="PhoneNumber" style="color:var(--ffs-clay);font-size:0.8rem;"></span>
            </div>

            <button type="submit" class="ffs-btn ffs-btn-forest">Save Changes</button>
        </form>

        <hr style="border-color:var(--ffs-border);margin:28px 0;" />

        <div class="ffs-section-head" style="margin-bottom:14px;">
            <h4 style="font-family:'Fraunces',serif;font-size:1.2rem;margin:0;">Delivery Addresses</h4>
            <a asp-controller="Customer" asp-action="AddAddress" class="ffs-btn ffs-btn-outline" style="padding:7px 14px;font-size:0.8rem;">+ Add Address</a>
        </div>

        @if (!addresses.Any())
        {
            <div style="background:var(--ffs-cream-alt);border-radius:var(--ffs-radius);padding:14px 18px;font-size:0.85rem;color:var(--ffs-ink-muted);margin-bottom:8px;">
                No saved addresses yet. Add one so checkout can skip straight to payment next time.
            </div>
        }
        else
        {
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:8px;">
                @foreach (var address in addresses)
                {
                    <div style="border:1px solid @(address.IsDefault ? "var(--ffs-forest)" : "var(--ffs-border)");border-radius:var(--ffs-radius);padding:14px;">
                        <div style="font-weight:600;margin-bottom:6px;">
                            @address.Label
                            @if (address.IsDefault)
                            {
                                <span class="ffs-product-badge" style="position:static;font-size:0.6rem;margin-left:6px;">Default</span>
                            }
                        </div>
                        <p style="font-size:0.82rem;color:var(--ffs-ink-muted);margin-bottom:10px;">
                            @address.RecipientName &middot; @address.PhoneNumber<br />
                            @address.AddressLine1
                            @if (!string.IsNullOrWhiteSpace(address.AddressLine2))
                            {
                                <text>, @address.AddressLine2</text>
                            }
                            <br />
                            @address.City, @address.Province @address.PostalCode
                        </p>
                        <div style="display:flex;gap:8px;flex-wrap:wrap;">
                            <a asp-controller="Customer" asp-action="EditAddress" asp-route-id="@address.CustomerAddressId" class="ffs-btn ffs-btn-outline" style="padding:5px 12px;font-size:0.75rem;">Edit</a>
                            @if (!address.IsDefault)
                            {
                                <form asp-controller="Customer" asp-action="SetDefaultAddress" asp-route-id="@address.CustomerAddressId" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="ffs-btn ffs-btn-outline" style="padding:5px 12px;font-size:0.75rem;">Make Default</button>
                                </form>
                            }
                            <form asp-controller="Customer" asp-action="DeleteAddress" asp-route-id="@address.CustomerAddressId" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="ffs-btn ffs-btn-outline" style="padding:5px 12px;font-size:0.75rem;color:var(--ffs-clay);border-color:var(--ffs-clay);" onclick="return confirm('Remove this address?');">Remove</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }

        <hr style="border-color:var(--ffs-border);margin:28px 0;" />

        <h4 style="font-family:'Fraunces',serif;font-size:1.2rem;margin-bottom:14px;">Saved Cards</h4>

        @if (!paymentMethods.Any())
        {
            <div style="background:var(--ffs-cream-alt);border-radius:var(--ffs-radius);padding:14px 18px;font-size:0.85rem;color:var(--ffs-ink-muted);">
                No saved cards yet. Tick "Save this card for next time" during checkout and it'll show up here.
            </div>
        }
        else
        {
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                @foreach (var card in paymentMethods)
                {
                    <div style="border:1px solid @(card.IsDefault ? "var(--ffs-forest)" : "var(--ffs-border)");border-radius:var(--ffs-radius);padding:14px;display:flex;justify-content:space-between;align-items:center;">
                        <div>
                            <div style="font-weight:600;text-transform:capitalize;font-size:0.9rem;">
                                @(card.CardType ?? "Card") ending in @card.Last4
                                @if (card.IsDefault)
                                {
                                    <span class="ffs-product-badge" style="position:static;font-size:0.6rem;margin-left:6px;">Default</span>
                                }
                            </div>
                            <div style="font-size:0.78rem;color:var(--ffs-ink-muted);">
                                Expires @(card.ExpiryMonth?.ToString("00") ?? "--")/@(card.ExpiryYear?.ToString() ?? "----")
                                @if (!string.IsNullOrWhiteSpace(card.Bank))
                                {
                                    <text>&middot; @card.Bank</text>
                                }
                            </div>
                        </div>
                        <div style="display:flex;flex-direction:column;gap:6px;">
                            @if (!card.IsDefault)
                            {
                                <form asp-controller="Customer" asp-action="SetDefaultPaymentMethod" asp-route-id="@card.CustomerPaymentMethodId" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="ffs-btn ffs-btn-outline" style="padding:5px 12px;font-size:0.72rem;">Make Default</button>
                                </form>
                            }
                            <form asp-controller="Customer" asp-action="RemovePaymentMethod" asp-route-id="@card.CustomerPaymentMethodId" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="ffs-btn ffs-btn-outline" style="padding:5px 12px;font-size:0.72rem;color:var(--ffs-clay);border-color:var(--ffs-clay);" onclick="return confirm('Remove this card?');">Remove</button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
