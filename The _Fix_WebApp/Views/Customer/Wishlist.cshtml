@model List<WishlistItem>
@{
    ViewData["Title"] = "My Wishlist";
    Layout = "_StorefrontLayout";
    var fallbackImage = "https://placehold.co/400x500/E4DEC9/24211B?text=No+Image";
}

<section class="ffs-section" style="padding-top:32px;">
    <div class="ffs-container">
        <div class="ffs-section-head">
            <div>
                <span class="ffs-eyebrow">Account</span>
                <h1 style="font-family:'Fraunces',serif;font-size:1.9rem;">My Wishlist</h1>
                <p>Products you've saved for later.</p>
            </div>
            <a asp-controller="Shop" asp-action="Index" class="ffs-btn ffs-btn-forest">Continue Shopping</a>
        </div>

        @if (!Model.Any())
        {
            <div style="text-align:center;padding:64px 0;color:var(--ffs-ink-muted);">
                <p style="margin-bottom:16px;">Your wishlist is empty.</p>
                <a asp-controller="Shop" asp-action="Index" class="ffs-btn ffs-btn-outline">Browse the Shop</a>
            </div>
        }
        else
        {
            <div class="ffs-product-grid">
                @foreach (var item in Model)
                {
                    var product = item.Product;
                    var inStock = product.Variants.Any(v => v.IsActive && v.StockQuantity > 0);
                    <div class="ffs-product-card">
                        <a asp-controller="Shop" asp-action="Product" asp-route-id="@product.ProductId" class="ffs-product-img-wrap" style="display:block;">
                            <img src="@(product.ImageUrl ?? fallbackImage)" alt="@product.Name" />
                            @if (!inStock)
                            {
                                <span class="ffs-product-badge ffs-badge-clay">Out of Stock</span>
                            }
                        </a>
                        <form asp-controller="Customer" asp-action="ToggleWishlist" method="post" class="ffs-wishlist-btn" style="padding:0;border:none;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@product.ProductId" />
                            <input type="hidden" name="returnUrl" value="@Url.Action("Wishlist")" />
                            <button type="submit" title="Remove from wishlist" style="width:100%;height:100%;background:rgba(255,255,255,.9);border:none;border-radius:50%;color:var(--ffs-clay);cursor:pointer;">&times;</button>
                        </form>
                        <div class="ffs-product-meta">
                            <a asp-controller="Shop" asp-action="Product" asp-route-id="@product.ProductId" class="ffs-product-name" style="display:block;">@product.Name</a>
                            <div class="ffs-product-price-row">
                                <span class="ffs-price">R@product.SellingPrice.ToString("N2")</span>
                            </div>
                            <a asp-controller="Shop" asp-action="Product" asp-route-id="@product.ProductId" class="ffs-btn @(inStock ? "ffs-btn-forest" : "ffs-btn-outline")" style="width:100%;justify-content:center;margin-top:10px;padding:8px;font-size:0.8rem;">
                                @(inStock ? "View" : "Out of stock")
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
