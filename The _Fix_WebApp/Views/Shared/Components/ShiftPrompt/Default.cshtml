@{
    string firstName = ViewBag.FirstName as string ?? "";
    string returnUrl = ViewBag.ReturnUrl as string ?? "/";
}
<style>
    .shiftp-backdrop { position: fixed; inset: 0; z-index: 1090; background: rgba(10,34,23,.55); display: flex; align-items: center; justify-content: center; padding: 16px; animation: shiftpFade .18s ease-out; }
    .shiftp-backdrop[hidden] { display: none; }
    .shiftp-card { width: 100%; max-width: 440px; background: #fff; border-radius: var(--stf-radius-lg); box-shadow: 0 20px 50px rgba(10,34,23,.3); overflow: hidden; animation: shiftpRise .22s ease-out; }
    .shiftp-head { background: var(--stf-primary); color: #fff; padding: 22px 26px 18px; }
    .shiftp-head .shiftp-eyebrow { font-size: .7rem; letter-spacing: .1em; text-transform: uppercase; color: var(--stf-on-primary-container); font-weight: 600; display: block; margin-bottom: 6px; }
    .shiftp-head h2 { font-family: 'Newsreader', serif; font-weight: 400; font-size: 1.55rem; margin: 0; color: #fff; }
    .shiftp-body { padding: 22px 26px 8px; }
    .shiftp-body p { margin: 0 0 16px; font-size: .88rem; color: var(--stf-on-surface-variant); }
    .shiftp-body label { display: block; font-size: .85rem; font-weight: 600; margin-bottom: 6px; }
    .shiftp-body input[type=number] { width: 100%; border: 1px solid var(--stf-outline-variant); border-radius: 8px; padding: 11px 16px; font-size: 1.1rem; font-family: inherit; }
    .shiftp-body input[type=number]:focus { outline: none; border-color: var(--stf-primary-container); box-shadow: 0 0 0 3px var(--stf-primary-fixed); }
    .shiftp-foot { padding: 14px 26px 22px; display: flex; gap: 10px; flex-direction: column; }
    .shiftp-foot .stf-btn { justify-content: center; width: 100%; }
    .shiftp-skip { background: none; border: none; font: inherit; font-size: .85rem; color: var(--stf-on-surface-variant); cursor: pointer; text-align: center; padding: 4px; }
    .shiftp-skip:hover { color: var(--stf-on-surface); text-decoration: underline; }
    @@keyframes shiftpFade { from { opacity: 0; } to { opacity: 1; } }
    @@keyframes shiftpRise { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
</style>

<div class="shiftp-backdrop" id="shiftPrompt" role="dialog" aria-modal="true" aria-labelledby="shiftPromptTitle">
    <div class="shiftp-card">
        <div class="shiftp-head">
            <span class="shiftp-eyebrow">Operations Core</span>
            <h2 id="shiftPromptTitle">@(string.IsNullOrWhiteSpace(firstName) ? "Ready to start your shift?" : $"Welcome back, {firstName}")</h2>
        </div>
        <form asp-controller="Pos" asp-action="StartShift" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <div class="shiftp-body">
                <p>Count the cash in your drawer and enter it below to clock on. Anything short or over at close-out will then be visible.</p>
                <label for="shiftPromptFloat">Opening Float</label>
                <input type="number" id="shiftPromptFloat" name="openingFloat" step="0.01" min="0" required placeholder="0.00" />
            </div>
            <div class="shiftp-foot">
                <button type="submit" class="stf-btn stf-btn-primary">Start Shift</button>
                <button type="button" class="shiftp-skip" id="shiftPromptSkip">Not now</button>
            </div>
        </form>
    </div>
</div>
<script>
    (function () {
        var box = document.getElementById('shiftPrompt');
        if (!box) return;
        function close() { box.hidden = true; document.removeEventListener('keydown', onKey); }
        function onKey(e) { if (e.key === 'Escape') close(); }
        document.getElementById('shiftPromptSkip').addEventListener('click', close);
        document.addEventListener('keydown', onKey);
        var f = document.getElementById('shiftPromptFloat'); if (f) f.focus();
    })();
</script>
