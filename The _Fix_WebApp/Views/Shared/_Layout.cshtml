<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Fashion Fix</title>

    <!-- Bootstrap 5 (CDN for now, swap for local libman/npm copy later if you need offline builds) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

@* Landing/login page renders full-bleed with no sidebar - everything else gets the app shell.
   Every link below is gated on a PERMISSION CLAIM (see Security/Permissions.cs), never a role
   name - so a brand-new role assembled on the Roles screen shows exactly the right nav items
   automatically, with no code changes. *@
@if (ViewData["HideNav"] as bool? == true)
{
    @RenderBody()
}
else
{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isCustomer = User.IsInRole("Customer") &&
                      !(User.IsInRole("Administrator") || User.IsInRole("Manager") || User.IsInRole("Employee") || User.IsInRole("Owner"));

    bool Can(string permission) => User.HasClaim(Permissions.ClaimType, permission);

    <div class="app-shell" id="appShell">

        <aside class="sidebar">
            <div class="sidebar-brand">
                <span class="brand-text">Fashion Fix</span>
            </div>

            <nav class="sidebar-nav nav flex-column">
                @if (isAuthenticated)
                {
                    if (Can(Permissions.DashboardView))
                    {
                        <a class="nav-link" asp-controller="Home" asp-action="Dashboard">
                            <span class="nav-icon">📊</span><span class="nav-label">Dashboard</span>
                        </a>
                    }

                    if (Can(Permissions.ProductsManage) || Can(Permissions.PosUse) || Can(Permissions.ReturnsProcess))
                    {
                        <div class="sidebar-section-label">Store</div>
                    }
                    if (Can(Permissions.ProductsManage))
                    {
                        <a class="nav-link" asp-controller="Products" asp-action="Index">
                            <span class="nav-icon">🏷️</span><span class="nav-label">Products</span>
                        </a>
                    }
                    if (Can(Permissions.PosUse))
                    {
                        <a class="nav-link" asp-controller="Pos" asp-action="Index">
                            <span class="nav-icon">🧾</span><span class="nav-label">POS</span>
                        </a>
                    }
                    if (Can(Permissions.ReturnsProcess))
                    {
                        <a class="nav-link" asp-controller="Returns" asp-action="Index">
                            <span class="nav-icon">↩️</span><span class="nav-label">Returns</span>
                        </a>
                    }

                    if (Can(Permissions.PurchaseOrdersManage) || Can(Permissions.SuppliersManage))
                    {
                        <div class="sidebar-section-label">Purchasing</div>
                    }
                    if (Can(Permissions.PurchaseOrdersManage))
                    {
                        <a class="nav-link" asp-controller="PurchaseOrders" asp-action="Index">
                            <span class="nav-icon">📦</span><span class="nav-label">Purchase Orders</span>
                        </a>
                    }
                    if (Can(Permissions.SuppliersManage))
                    {
                        <a class="nav-link" asp-controller="Suppliers" asp-action="Index">
                            <span class="nav-icon">🚚</span><span class="nav-label">Suppliers</span>
                        </a>
                    }

                    if (Can(Permissions.ReportsView))
                    {
                        <div class="sidebar-section-label">Insight</div>
                        <a class="nav-link" asp-controller="Reports" asp-action="Index">
                            <span class="nav-icon">📈</span><span class="nav-label">Reports</span>
                        </a>
                    }

                    if (Can(Permissions.EmployeesManage) || Can(Permissions.RolesManage) || Can(Permissions.AuditLogsView))
                    {
                        <div class="sidebar-section-label">Administration</div>
                    }
                    if (Can(Permissions.EmployeesManage))
                    {
                        <a class="nav-link" asp-controller="Employees" asp-action="Index">
                            <span class="nav-icon">👥</span><span class="nav-label">Employees</span>
                        </a>
                    }
                    if (Can(Permissions.RolesManage))
                    {
                        <a class="nav-link" asp-controller="Roles" asp-action="Index">
                            <span class="nav-icon">🔐</span><span class="nav-label">Roles & Permissions</span>
                        </a>
                    }
                    if (Can(Permissions.AuditLogsView))
                    {
                        <a class="nav-link" asp-controller="Employees" asp-action="AuditLogs">
                            <span class="nav-icon">📝</span><span class="nav-label">Audit Logs</span>
                        </a>
                    }

                    if (isCustomer)
                    {
                        <div class="sidebar-section-label">My Account</div>
                        <a class="nav-link" asp-controller="Customer" asp-action="Orders">
                            <span class="nav-icon">🛍️</span><span class="nav-label">My Orders</span>
                        </a>
                        <a class="nav-link" asp-controller="Customer" asp-action="Profile">
                            <span class="nav-icon">👤</span><span class="nav-label">My Profile</span>
                        </a>
                    }

                    <div class="sidebar-section-label">Account</div>
                    <a class="nav-link" asp-controller="Account" asp-action="ChangePassword">
                        <span class="nav-icon">🔑</span><span class="nav-label">Change Password</span>
                    </a>
                }
            </nav>

            @if (isAuthenticated)
            {
                <div class="sidebar-footer">
                    <div class="footer-text text-white-50 small mb-2">
                        Signed in as <strong class="text-white">@User.Identity!.Name</strong>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="btn btn-outline-light btn-sm w-100">Logout</button>
                    </form>
                </div>
            }
        </aside>

        <div class="content-area">
            <div class="topbar">
                <button type="button" class="sidebar-toggle-btn" id="sidebarToggleBtn" aria-label="Toggle sidebar" title="Toggle sidebar">
                    &#9776;
                </button>

                @if (!isAuthenticated)
                {
                    <div class="ms-auto">
                        <a class="btn btn-outline-dark btn-sm me-2" asp-controller="Home" asp-action="Index">Customer Login</a>
                        <a class="btn btn-dark btn-sm" asp-controller="Account" asp-action="EmployeeLogin">Employee Login</a>
                    </div>
                }
            </div>

            <main role="main">
                @RenderBody()
            </main>
        </div>
    </div>

    <script>
        (function () {
            var shell = document.getElementById('appShell');
            var toggleBtn = document.getElementById('sidebarToggleBtn');
            var isMobile = function () { return window.innerWidth < 768; };
            var STORAGE_KEY = 'fashionfix.sidebarCollapsed';

            // Restore desktop collapsed/expanded preference between page loads.
            if (!isMobile() && localStorage.getItem(STORAGE_KEY) === '1') {
                shell.classList.add('sidebar-collapsed');
            }

            toggleBtn.addEventListener('click', function () {
                if (isMobile()) {
                    shell.classList.toggle('sidebar-mobile-open');
                } else {
                    shell.classList.toggle('sidebar-collapsed');
                    localStorage.setItem(STORAGE_KEY, shell.classList.contains('sidebar-collapsed') ? '1' : '0');
                }
            });

            // Tapping the dimmed backdrop on mobile closes the drawer.
            shell.addEventListener('click', function (e) {
                if (isMobile() && shell.classList.contains('sidebar-mobile-open') && e.target === shell) {
                    shell.classList.remove('sidebar-mobile-open');
                }
            });
        })();
    </script>
}

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
