@model SupportTicket
@using FashionFix.Web.Models.Entities
@{
    ViewData["Title"] = $"Ticket: {Model.Subject}";
    Layout = "_StaffLayout";
    var staffOptions = (ViewBag.StaffOptions as List<ApplicationUser>) ?? new List<ApplicationUser>();
    var managerOptions = (ViewBag.ManagerOptions as IList<ApplicationUser>) ?? new List<ApplicationUser>();

    (string bg, string fg) BadgeFor(TicketStatus s) => s switch
    {
        TicketStatus.Resolved or TicketStatus.Closed => ("var(--stf-surface-container)", "var(--stf-on-surface-variant)"),
        TicketStatus.Escalated => ("var(--stf-error-container)", "var(--stf-error)"),
        TicketStatus.InProgress => ("var(--stf-secondary-container)", "var(--stf-secondary)"),
        _ => ("var(--stf-primary-container)", "var(--stf-on-primary-container)")
    };
    var (badgeBg, badgeFg) = BadgeFor(Model.Status);
}

<div class="stf-content" style="max-width:900px;">
    <div style="margin-bottom:14px;">
        <a asp-action="Index" style="color:var(--stf-on-surface-variant);font-size:0.85rem;text-decoration:none;">&larr; Back to Support Tickets</a>
    </div>

    <div class="stf-page-head">
        <div>
            <span class="stf-eyebrow">@Model.Category &bull; @Model.Priority Priority</span>
            <h1>@Model.Subject</h1>
            <p>
                @Model.Customer?.FullName (@Model.Customer?.Email) &bull; Opened @Model.DateCreated.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                @if (Model.Order is not null)
                {
                    <text> &bull; <a asp-controller="Orders" asp-action="Details" asp-route-id="@Model.Order.OrderId">Order #@Model.Order.OrderNumber</a></text>
                }
            </p>
        </div>
        <span style="background:@badgeBg;color:@badgeFg;font-size:0.8rem;font-weight:600;padding:6px 14px;border-radius:999px;white-space:nowrap;">@Model.Status</span>
    </div>

    @if (Model.Status != TicketStatus.Closed)
    {
        var hasOrder = Model.Order is not null;
        var cancellable = hasOrder && Model.Order!.Status is OrderStatus.Pending or OrderStatus.Processing or OrderStatus.Shipped;
        <form asp-action="QuickAction" asp-route-id="@Model.SupportTicketId" method="post" id="quickActionForm" class="stf-card" style="margin-bottom:16px;">
            @Html.AntiForgeryToken()
            <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
                <strong style="font-size:0.85rem;">Quick actions</strong>
                <select name="action" id="qaAction" required style="flex:1 1 280px;border:1px solid var(--stf-outline-variant);border-radius:8px;padding:8px 12px;font-size:0.85rem;">
                    <option value="">-- Choose an action --</option>
                    <optgroup label="Order">
                        <option value="cancel_order" disabled="@(!cancellable)">Cancel order and refund to original payment@(hasOrder && !cancellable ? $" (order is {Model.Order!.Status})" : "")@(!hasOrder ? " (no order linked)" : "")</option>
                        <option value="process_return" disabled="@(!hasOrder)">Issue refund / process a return&hellip;@(!hasOrder ? " (no order linked)" : "")</option>
                        <option value="refund_wallet" disabled="@(!hasOrder)">Goodwill refund to FixCash wallet@(!hasOrder ? " (no order linked)" : "")</option>
                    </optgroup>
                    <optgroup label="Conversation">
                        <option value="request_info">Ask the customer for more information</option>
                        <option value="mark_resolved">Mark as resolved</option>
                        <option value="close_ticket">Resolve and close (save to history)</option>
                    </optgroup>
                </select>
                <button type="submit" class="stf-btn stf-btn-primary" style="padding:8px 18px;font-size:0.82rem;">Apply</button>
                @if (hasOrder)
                {
                    <a asp-controller="Orders" asp-action="Details" asp-route-id="@Model.Order!.OrderId" class="stf-btn stf-btn-outline" style="padding:8px 14px;font-size:0.8rem;">View order #@Model.Order.OrderNumber</a>
                }
            </div>
            <div id="qaExtra" style="display:none;margin-top:10px;gap:10px;flex-wrap:wrap;">
                <input type="number" step="0.01" min="0.01" name="amount" id="qaAmount" placeholder="Amount (R)" style="display:none;width:150px;border:1px solid var(--stf-outline-variant);border-radius:8px;padding:8px 12px;font-size:0.85rem;" />
                <input type="text" name="note" id="qaNote" maxlength="250" placeholder="Reason / note (shown to the customer where relevant)" style="flex:1 1 280px;border:1px solid var(--stf-outline-variant);border-radius:8px;padding:8px 12px;font-size:0.85rem;" />
            </div>
            @if (hasOrder)
            {
                <p style="font-size:0.75rem;color:var(--stf-on-surface-variant);margin:10px 0 0;">
                    Cancelling restocks the items and returns the money to the way the customer paid: the FixCash part back to their wallet and the card part back to their card (the delivery fee included).
                </p>
            }
        </form>
        <script>
            (function () {
                var sel = document.getElementById('qaAction');
                var extra = document.getElementById('qaExtra');
                var amount = document.getElementById('qaAmount');
                var note = document.getElementById('qaNote');
                var form = document.getElementById('quickActionForm');
                var needsNote = ['cancel_order', 'refund_wallet', 'request_info'];
                sel.addEventListener('change', function () {
                    extra.style.display = needsNote.indexOf(sel.value) !== -1 ? 'flex' : 'none';
                    amount.style.display = sel.value === 'refund_wallet' ? '' : 'none';
                    note.placeholder = sel.value === 'request_info' ? 'Message to the customer (leave blank for the standard request)' : 'Reason / note';
                });
                form.addEventListener('submit', function (e) {
                    if (sel.value === 'cancel_order' && !confirm('Cancel this order and refund the customer to their original payment? This cannot be undone.')) e.preventDefault();
                    if (sel.value === 'close_ticket' && !confirm('Close this ticket? The conversation will be locked.')) e.preventDefault();
                    if (sel.value === 'refund_wallet' && !amount.value) { alert('Enter the refund amount.'); e.preventDefault(); }
                });
            })();
        </script>
    }

    <div class="stf-card" style="margin-bottom:16px;">
        <div style="display:flex;flex-direction:column;gap:14px;max-height:420px;overflow-y:auto;padding-right:4px;">
            @foreach (var m in Model.Messages.OrderBy(m => m.DateSent))
            {
                var isEmployee = m.SenderType == TicketSenderType.Employee;
                var isSystem = m.SenderType == TicketSenderType.System;
                <div style="align-self:@(isEmployee ? "flex-end" : "flex-start");max-width:80%;">
                    @if (isSystem)
                    {
                        <div style="text-align:center;color:var(--stf-on-surface-variant);font-size:0.78rem;font-style:italic;">@m.Body</div>
                    }
                    else
                    {
                        <div style="background:@(isEmployee ? "var(--stf-primary)" : "var(--stf-surface-container)");color:@(isEmployee ? "#fff" : "var(--stf-on-surface)");border-radius:12px;padding:12px 16px;">
                            <div style="font-size:0.72rem;font-weight:600;margin-bottom:4px;opacity:0.8;">
                                @(m.Sender?.FullName ?? (isEmployee ? "Staff" : "Customer")) &bull; @m.DateSent.ToLocalTime().ToString("dd MMM, HH:mm")
                            </div>
                            <div style="font-size:0.9rem;white-space:pre-line;">@m.Body</div>
                            @if (m.Attachments.Count > 0)
                            {
                                <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:8px;">
                                    @foreach (var a in m.Attachments)
                                    {
                                        <a href="@a" target="_blank" rel="noopener"><img src="@a" alt="Attachment" loading="lazy" style="width:84px;height:84px;object-fit:cover;border-radius:8px;border:1px solid rgba(0,0,0,.15);" /></a>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    @if (Model.Status == TicketStatus.Closed)
    {
        <div class="stf-card" style="margin-bottom:16px;display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;">
            <span style="font-size:0.9rem;color:var(--stf-on-surface-variant);">This conversation is closed and saved to Ticket History.</span>
            @if (Model.TranscriptText is not null)
            {
                <a asp-action="Transcript" asp-route-id="@Model.SupportTicketId" class="stf-btn stf-btn-primary">Download transcript (.txt)</a>
            }
        </div>
    }
    else
    {
    <form asp-action="Reply" asp-route-id="@Model.SupportTicketId" method="post" enctype="multipart/form-data" class="stf-card" style="margin-bottom:16px;">
        <textarea name="message" rows="3" placeholder="Reply to the customer..." style="width:100%;border:1px solid var(--stf-outline-variant);border-radius:8px;padding:9px 14px;font-size:0.9rem;margin-bottom:10px;"></textarea>
        <label class="stf-btn stf-btn-outline" style="cursor:pointer;margin-bottom:10px;font-size:0.8rem;padding:7px 14px;">
            &#128247; Attach images (max 3)
            <input type="file" name="attachments" accept="image/jpeg,image/png,image/webp" multiple style="display:none;" onchange="this.parentNode.querySelector('.n').textContent = this.files.length ? ' - ' + this.files.length + ' selected' : ''" />
            <span class="n"></span>
        </label>
        <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
            <button type="submit" class="stf-btn stf-btn-primary">Send Reply</button>
            <label style="font-size:0.82rem;display:flex;align-items:center;gap:6px;">
                and set status to
                <select name="newStatus" style="border:1px solid var(--stf-outline-variant);border-radius:8px;padding:6px 10px;font-size:0.85rem;">
                    <option value="">(no change)</option>
                    @foreach (TicketStatus s in Enum.GetValues<TicketStatus>())
                    {
                        <option value="@s" selected="@(s == Model.Status)">@s</option>
                    }
                </select>
            </label>
        </div>
    </form>
    }

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
        <form asp-action="Assign" asp-route-id="@Model.SupportTicketId" method="post" class="stf-card">
            @Html.AntiForgeryToken()
            <label style="font-size:0.85rem;font-weight:600;display:block;margin-bottom:8px;">Assign To</label>
            <div style="display:flex;gap:8px;">
                <select name="employeeId" style="flex:1;border:1px solid var(--stf-outline-variant);border-radius:8px;padding:8px 12px;font-size:0.85rem;">
                    @foreach (var s in staffOptions)
                    {
                        <option value="@s.Id" selected="@(s.Id == Model.AssignedEmployeeId)">@s.FullName</option>
                    }
                </select>
                <button type="submit" class="stf-btn stf-btn-outline" style="padding:8px 16px;font-size:0.82rem;">Assign</button>
            </div>
        </form>

        <form asp-action="Escalate" asp-route-id="@Model.SupportTicketId" method="post" class="stf-card">
            @Html.AntiForgeryToken()
            <label style="font-size:0.85rem;font-weight:600;display:block;margin-bottom:8px;">Escalate To Manager</label>
            @if (managerOptions.Any())
            {
                <div style="display:flex;gap:8px;">
                    <select name="managerId" style="flex:1;border:1px solid var(--stf-outline-variant);border-radius:8px;padding:8px 12px;font-size:0.85rem;">
                        @foreach (var m in managerOptions)
                        {
                            <option value="@m.Id" selected="@(m.Id == Model.EscalatedToManagerId)">@m.FullName</option>
                        }
                    </select>
                    <button type="submit" class="stf-btn stf-btn-outline" style="padding:8px 16px;font-size:0.82rem;color:var(--stf-error);border-color:var(--stf-error);">Escalate</button>
                </div>
            }
            else
            {
                <p style="color:var(--stf-on-surface-variant);font-size:0.82rem;">No managers on file to escalate to.</p>
            }
        </form>
    </div>
</div>
