@model ProductViewModel
@{
    ViewData["Title"] = "Edit Product";
}

<h1>Edit Product</h1>

<!-- TODO: same field set as Create.cshtml - consider extracting a shared _ProductForm partial -->
<form asp-action="Edit" asp-route-id="@Model.ProductId" method="post">
    <input type="hidden" asp-for="ProductId" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="SellingPrice" class="form-label"></label>
        <input asp-for="SellingPrice" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="LowStockThreshold" class="form-label"></label>
        <input asp-for="LowStockThreshold" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
</form>
<form asp-action="Deactivate" asp-route-id="@Model.ProductId" method="post" class="d-inline">
    <button type="submit" class="btn btn-outline-danger">Deactivate</button>
</form>
