@model ProductViewModel
@{
    ViewData["Title"] = "Add Product";
    Layout = "_StaffLayout";
    var categories = (List<string>)ViewBag.Categories;
    var sizes = (List<string>)ViewBag.Sizes;
    var colors = (List<string>)ViewBag.Colors;
    var brands = (List<string>)ViewBag.Brands;
}
<div class="stf-content" style="max-width:1100px;">
    <span class="stf-eyebrow">Catalogue</span>
    <h1 style="margin-bottom:20px;">Add New Product</h1>

    <form asp-action="Create" method="post" enctype="multipart/form-data" id="productForm" class="stf-card">
        <div asp-validation-summary="ModelOnly" style="color:var(--stf-error);margin-bottom:10px;"></div>
        @{ string L = "font-size:0.85rem;font-weight:600;display:block;margin-bottom:6px;"; string F = "width:100%;border:1px solid var(--stf-outline-variant);border-radius:8px;padding:9px 14px;font-size:0.9rem;"; string EV = "color:var(--stf-error);font-size:0.8rem;"; string HINT = "font-size:0.75rem;color:var(--stf-on-surface-variant);margin-top:4px;"; }

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;">
            <div>
                <label asp-for="Name" style="@L"></label>
                <input asp-for="Name" style="@F" />
                <span asp-validation-for="Name" style="@EV"></span>
            </div>
            <div>
                <label style="@L">Style Code</label>
                <input type="text" value="Generated automatically after saving" disabled style="@F background:var(--stf-surface-container);" />
                <div style="@HINT">Assigned from the category (e.g. "CLO-0001") once the product is created. Each size/colour below gets its own SKU built from this code.</div>
            </div>
        </div>

        <label asp-for="Description" style="@L"></label>
        <textarea asp-for="Description" rows="3" style="@F margin-bottom:14px;" placeholder="Shown to customers browsing the shop, and to staff on the POS scan popup"></textarea>
        <span asp-validation-for="Description" style="@EV"></span>

        <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:14px;margin-bottom:14px;">
            <div>
                <label asp-for="Category" style="@L"></label>
                <select asp-for="Category" style="@F">
                    <option value="">-- Choose a category --</option>
                    @foreach (var c in categories) { <option value="@c">@c</option> }
                </select>
                <span asp-validation-for="Category" style="@EV"></span>
            </div>
            <div>
                <label asp-for="Brand" style="@L"></label>
                <input asp-for="Brand" style="@F" list="brandOptions" autocomplete="off" placeholder="Choose or type a new brand" />
                <datalist id="brandOptions">@foreach (var b in brands) { <option value="@b"></option> }</datalist>
                <span asp-validation-for="Brand" style="@EV"></span>
                <div style="font-size:0.75rem;color:var(--stf-on-surface-variant);margin-top:-8px;margin-bottom:10px;">Linked to Supplier: pick a supplier below to fill this in, or type a supplier's name to select them.</div>
            </div>
            <div>
                <label asp-for="CostPrice" style="@L"></label>
                <input asp-for="CostPrice" id="costPriceInput" style="@F" />
                <span asp-validation-for="CostPrice" style="@EV"></span>
            </div>
            <div>
                <label asp-for="SellingPrice" style="@L"></label>
                <input asp-for="SellingPrice" id="sellingPriceInput" style="@F" disabled />
                <div style="font-size:0.75rem;display:flex;align-items:center;gap:6px;margin-top:6px;">
                    <input asp-for="AutoCalculatePrice" id="autoCalcCheckbox" />
                    <label for="autoCalcCheckbox">Auto-calculate from markup (<a asp-controller="Pricing" asp-action="Index" target="_blank" style="color:var(--stf-secondary);">edit rates</a>)</label>
                </div>
                <span asp-validation-for="SellingPrice" style="@EV"></span>
            </div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;margin-bottom:14px;">
            <div>
                <label asp-for="CompareAtPrice" style="@L"></label>
                <input asp-for="CompareAtPrice" style="@F" />
                <span asp-validation-for="CompareAtPrice" style="@EV"></span>
            </div>
            <div>
                <label style="@L">Main Photo</label>
                <input type="file" name="imageFile" accept="image/jpeg,image/png,image/webp,image/gif" style="@F" />
                <input asp-for="ImageUrl" style="@F margin-top:6px;" placeholder="...or paste an image URL (https://...)" />
                <span asp-validation-for="ImageUrl" style="@EV"></span>
                <div style="@HINT">Upload a JPG, PNG or WebP (max 5 MB), or paste a link. An uploaded file takes priority.</div>
            </div>
            <div>
                <label asp-for="LowStockThreshold" style="@L"></label>
                <input asp-for="LowStockThreshold" style="@F" />
                <span asp-validation-for="LowStockThreshold" style="@EV"></span>
            </div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:14px;margin-bottom:14px;">
            <div>
                <label asp-for="SubCategory" style="@L"></label>
                <input asp-for="SubCategory" style="@F" placeholder="e.g. Trail & Running (optional)" />
            </div>
            <div>
                <label asp-for="Material" style="@L"></label>
                <input asp-for="Material" style="@F" placeholder="e.g. Organic Cotton (optional)" />
            </div>
            <div>
                <label asp-for="Fit" style="@L"></label>
                <input asp-for="Fit" style="@F" placeholder="e.g. Relaxed (optional)" />
            </div>
            <div>
                <label asp-for="Badge" style="@L"></label>
                <input asp-for="Badge" style="@F" placeholder="e.g. Bestseller (optional)" />
            </div>
        </div>

        <label asp-for="DepartmentId" style="@L">Department</label>
        <select asp-for="DepartmentId" style="@F">
            <option value="">-- None --</option>
            @foreach (var d in (List<Department>)ViewBag.Departments) { <option value="@d.DepartmentId">@d.Name</option> }
        </select>
        <div style="@HINT margin-bottom:20px;">Which storefront department (Women/Men/Kids/...) this style appears under. Optional - can be set later from the catalogue.</div>

        <label asp-for="SupplierId" style="@L">Supplier</label>
        <select asp-for="SupplierId" style="@F">
            <option value="">-- None --</option>
            @foreach (var sup in (List<Supplier>)ViewBag.Suppliers) { <option value="@sup.SupplierId">@sup.Name</option> }
        </select>
        <div style="@HINT margin-bottom:20px;">Who you buy this style from. Purchase orders only list a supplier's own products, so set this for anything you restock.</div>

        <hr style="border-color:var(--stf-outline-variant);margin:16px 0;" />
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
            <h5 style="font-family:'Newsreader',serif;font-size:1.1rem;margin:0;">Sizes &amp; Colours</h5>
            <button type="button" id="addVariantRow" class="stf-btn stf-btn-outline" style="padding:6px 14px;font-size:0.78rem;">+ Add Size/Colour</button>
        </div>
        <p style="font-size:0.8rem;color:var(--stf-on-surface-variant);">Every size/colour combination this style is sold in, each with its own stock count. At least one is required.</p>

        <table class="stf-table" id="variantTable" style="margin-bottom:20px;">
            <thead>
                <tr><th>Size</th><th>Colour</th><th>Colour Hex (optional)</th><th>Stock</th><th>Price Override (optional)</th><th></th></tr>
            </thead>
            <tbody id="variantRows">
                @for (var i = 0; i < Model.Variants.Count; i++)
                {
                    <tr class="variant-row">
                        <td><input class="variant-size-input" name="Variants[@i].Size" value="@Model.Variants[i].Size" style="@F" list="sizeOptions" autocomplete="off" placeholder="e.g. M" /></td>
                        <td>
                            <select name="Variants[@i].Color" style="@F">
                                <option value="">-- Colour --</option>
                                @foreach (var c in colors) { <option value="@c" selected="@(Model.Variants[i].Color == c)">@c</option> }
                            </select>
                        </td>
                        <td><input name="Variants[@i].ColorHex" value="@Model.Variants[i].ColorHex" style="@F" placeholder="#000000" /></td>
                        <td><input type="number" name="Variants[@i].StockQuantity" value="@Model.Variants[i].StockQuantity" style="@F" min="0" /></td>
                        <td><input type="number" step="0.01" name="Variants[@i].PriceOverride" value="@Model.Variants[i].PriceOverride" style="@F" /></td>
                        <td style="text-align:right;"><button type="button" class="stf-btn stf-btn-danger-outline remove-variant-row" style="padding:6px 10px;font-size:0.75rem;">Remove</button></td>
                    </tr>
                }
            </tbody>
        </table>
        <datalist id="sizeOptions">@foreach (var s in sizes) { <option value="@s"></option> }</datalist>

        <div style="display:flex;gap:10px;">
            <button type="submit" class="stf-btn stf-btn-primary">Save Product</button>
            <a asp-action="Index" style="font-size:0.85rem;color:var(--stf-on-surface-variant);align-self:center;">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        window.FFFootwear = { category: '@ViewBag.FootwearCategory', sizes: @Html.Raw(Json.Serialize(ViewBag.FootwearSizes)) };
    </script>
    <script src="~/js/variant-sizes.js" asp-append-version="true"></script>
    <script>
        // Brand <-> Supplier link: choosing a supplier fills the brand with the supplier's name
        // (unless the user has typed a different brand); typing a brand that matches a supplier selects them.
        (function () {
            var brand = document.getElementById('Brand');
            var sup = document.getElementById('SupplierId');
            if (!brand || !sup) return;

            function nameOf(select) {
                return select.value ? select.options[select.selectedIndex].text.trim() : '';
            }
            var previous = nameOf(sup);

            sup.addEventListener('change', function () {
                var current = nameOf(sup);
                var typed = brand.value.trim().toLowerCase();
                if (current && (typed === '' || typed === previous.toLowerCase())) {
                    brand.value = current;
                }
                previous = current;
            });

            brand.addEventListener('input', function () {
                var typed = brand.value.trim().toLowerCase();
                if (!typed) return;
                for (var i = 0; i < sup.options.length; i++) {
                    var o = sup.options[i];
                    if (o.value && o.text.trim().toLowerCase() === typed) {
                        sup.value = o.value;
                        previous = o.text.trim();
                        break;
                    }
                }
            });
        })();
    </script>
    <script>
        (function () {
            var markupByCategory = @Html.Raw(Json.Serialize(ViewBag.MarkupByCategory));
            var defaultMarkup = @Html.Raw(Json.Serialize(ViewBag.DefaultMarkupPercentage));
            var costInput = document.getElementById('costPriceInput');
            var sellingInput = document.getElementById('sellingPriceInput');
            var autoCheckbox = document.getElementById('autoCalcCheckbox');
            var categorySelect = document.getElementById('Category');

            function recalculate() {
                if (!autoCheckbox.checked) return;
                var cost = parseFloat(costInput.value) || 0;
                var markup = markupByCategory[categorySelect.value];
                if (markup === undefined) markup = defaultMarkup;
                sellingInput.value = (cost * (1 + markup / 100)).toFixed(2);
            }

            function toggleAuto() {
                sellingInput.disabled = autoCheckbox.checked;
                if (autoCheckbox.checked) recalculate();
            }

            autoCheckbox.addEventListener('change', toggleAuto);
            costInput.addEventListener('input', recalculate);
            categorySelect.addEventListener('change', recalculate);
            toggleAuto();
        })();
    </script>
    <script>
        (function () {
            var rowIndex = @Model.Variants.Count;
            var colorOptions = @Html.Raw(Json.Serialize(colors));
            var colorHexMap = @Html.Raw(Json.Serialize(ProductViewModel.ColorHexMap));
            document.addEventListener('change', function (e) {
                var sel = e.target;
                if (!sel.matches || !sel.matches('select[name$=".Color"]')) return;
                var hex = sel.closest('tr').querySelector('input[name$=".ColorHex"]');
                if (hex && colorHexMap[sel.value]) hex.value = colorHexMap[sel.value];
            });
            var fieldStyle = 'width:100%;border:1px solid var(--stf-outline-variant);border-radius:8px;padding:9px 14px;font-size:0.9rem;';

            document.getElementById('addVariantRow').addEventListener('click', function () {
                var tbody = document.getElementById('variantRows');
                var colorSelectOptions = '<option value="">-- Colour --</option>' +
                    colorOptions.map(function (c) { return '<option value="' + c + '">' + c + '</option>'; }).join('');

                var row = document.createElement('tr');
                row.className = 'variant-row';
                row.innerHTML =
                    '<td><input class="variant-size-input" name="Variants[' + rowIndex + '].Size" style="' + fieldStyle + '" list="sizeOptions" autocomplete="off" placeholder="e.g. M" /></td>' +
                    '<td><select name="Variants[' + rowIndex + '].Color" style="' + fieldStyle + '">' + colorSelectOptions + '</select></td>' +
                    '<td><input name="Variants[' + rowIndex + '].ColorHex" style="' + fieldStyle + '" placeholder="#000000" /></td>' +
                    '<td><input type="number" name="Variants[' + rowIndex + '].StockQuantity" value="0" style="' + fieldStyle + '" min="0" /></td>' +
                    '<td><input type="number" step="0.01" name="Variants[' + rowIndex + '].PriceOverride" style="' + fieldStyle + '" /></td>' +
                    '<td style="text-align:right;"><button type="button" class="stf-btn stf-btn-danger-outline remove-variant-row" style="padding:6px 10px;font-size:0.75rem;">Remove</button></td>';
                tbody.appendChild(row);
                rowIndex++;
                wireRemoveButtons();
            });

            function wireRemoveButtons() {
                document.querySelectorAll('.remove-variant-row').forEach(function (btn) {
                    btn.onclick = function () {
                        var rows = document.querySelectorAll('.variant-row');
                        if (rows.length <= 1) {
                            alert('A style needs at least one size/colour.');
                            return;
                        }
                        btn.closest('tr').remove();
                    };
                });
            }
            wireRemoveButtons();
        })();
    </script>
}
