@model List<Product>
@{
    ViewData["Title"] = "Low Stock";
}
<div class="container-fluid py-4">
    <a asp-controller="Home" asp-action="Dashboard" class="btn btn-outline-secondary btn-sm mb-3">&larr; Dashboard</a>

    <h2><i class="bi bi-exclamation-triangle"></i> Low Stock</h2>
    <p class="text-muted">Every active product currently at or below its restock threshold, most urgent first. Click Restock to jump straight to that product's Edit page.</p>

    @if (!Model.Any())
    {
        <div class="alert alert-success"><i class="bi bi-check-circle"></i> Nothing is low on stock right now.</div>
    }
    else
    {
        <table class="table table-hover align-middle">
            <thead><tr><th>Product</th><th>SKU</th><th>Category</th><th>Current Stock</th><th>Threshold</th><th></th></tr></thead>
            <tbody>
                @foreach (var p in Model)
                {
                    var isOutOfStock = p.StockQuantity == 0;
                    <tr class="@(isOutOfStock ? "table-danger" : "table-warning")">
                        <td>@p.Name</td>
                        <td>@p.SKU</td>
                        <td>@p.Category</td>
                        <td>
                            <strong>@p.StockQuantity</strong>
                            @if (isOutOfStock)
                            {
                                <span class="badge bg-danger ms-1">Out of stock</span>
                            }
                        </td>
                        <td>@p.LowStockThreshold</td>
                        <td class="text-end">
                            <a asp-controller="Products" asp-action="Edit" asp-route-id="@p.ProductId" class="btn btn-sm btn-danger">
                                <i class="bi bi-box-seam"></i> Restock
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
