@model PermissionMatrixViewModel
@{
    ViewData["Title"] = "Roles & Permissions";
    Layout = "_StaffLayout";
    string RoleTag(RoleMatrixColumnViewModel r) => r.Name switch
    {
        "Administrator" => "System Protected",
        "Customer" => "External Client",
        "Manager" or "Employee" or "Owner" => "Built-In",
        _ => "Custom"
    };
    var totalPermissions = Model.AllPermissions.Count;
}

<div class="stf-content">
    <div class="stf-page-head">
        <div>
            <span class="stf-eyebrow">Security Context &bull; Policy-Driven Identity Guard</span>
            <h1>Roles &amp; Permission Governance</h1>
            <p>Every screen in FashionFix authorizes against a permission claim, never a role name - toggle a box below and it takes effect the moment you save, no redeploy required.</p>
        </div>

        @if (ViewBag.AtRoleCap == true)
        {
            <span class="stf-btn stf-btn-outline" style="opacity:.6;cursor:not-allowed;" title="Maximum of @ViewBag.MaxRoles roles reached - delete an unused one to make room.">
                @Model.Roles.Count / @ViewBag.MaxRoles Roles &bull; Limit Reached
            </span>
        }
        else
        {
            <a asp-action="Create" class="stf-btn stf-btn-primary">+ Create New Role (@Model.Roles.Count/@ViewBag.MaxRoles)</a>
        }
    </div>

    @if (TempData["RoleError"] is string err)
    {
        <div style="background:var(--stf-error-container);color:var(--stf-error);border-radius:var(--stf-radius);padding:12px 18px;margin-bottom:16px;font-size:0.88rem;">@err</div>
    }

    <div class="stf-role-cards">
        @foreach (var role in Model.Roles)
        {
            var pct = totalPermissions == 0 ? 0 : (int)Math.Round(100.0 * role.GrantedPermissions.Count / totalPermissions);
            <div class="stf-role-card @(role.Name == "Administrator" ? "locked" : "")">
                <span class="stf-role-tag">@RoleTag(role)</span>
                <div class="stf-role-name">@role.Name</div>
                <div class="stf-role-bar-bg"><div class="stf-role-bar-fill" style="width:@pct%;"></div></div>
                <div class="stf-role-meta">
                    <span>@role.GrantedPermissions.Count / @totalPermissions claims</span>
                    <span>@role.MemberCount member@(role.MemberCount == 1 ? "" : "s")</span>
                </div>
            </div>
        }
    </div>

    <span class="stf-eyebrow">Permission Assembly Grid</span>
    <h2 style="font-size:1.3rem;margin-bottom:16px;">Claim Key Granularity &amp; Inheritance</h2>

    <form asp-action="SaveMatrix" method="post" id="matrixForm">
        @Html.AntiForgeryToken()
        @foreach (var role in Model.Roles)
        {
            <input type="hidden" name="roleIds" value="@role.Id" />
        }

        <div class="stf-matrix-wrap">
            <table class="stf-matrix">
                <thead>
                    <tr>
                        <th>Permission</th>
                        @foreach (var role in Model.Roles)
                        {
                            <th>@role.Name @if (role.IsProtected) {
                                <span class="stf-lock-icon">&#128274;</span>
                            }
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var perm in Model.AllPermissions)
                {
                    <tr>
                        <td>
                            <div class="stf-perm-name">@perm.Value.Split(" (")[0]</div>
                            <div class="stf-perm-desc"><code>@perm.Key</code></div>
                        </td>
                        @foreach (var role in Model.Roles)
                        {
                            var locked = role.Name == "Administrator" || role.Name == "Customer";
                            var isChecked = role.Name == "Administrator" || role.GrantedPermissions.Contains(perm.Key);
                            if (role.Name == "Customer") { isChecked = false; }
                            <td>
                                <input type="checkbox" class="matrix-checkbox"
                                       name="@(locked ? null : "selections")"
                                       value="@role.Id:@perm.Key"
                                       checked="@isChecked"
                                       disabled="@locked" />
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="stf-save-bar">
        <span id="changeCounter" style="font-size:0.85rem;">0 unsaved permission changes</span>
        <div style="display:flex;gap:10px;">
            <a asp-action="Index" class="stf-btn stf-btn-outline">Discard Changes</a>
            <button type="submit" class="stf-btn" style="background:#fff;color:var(--stf-primary);">Save Permissions Configuration</button>
        </div>
    </div>
</form>

<div style="margin-top:28px;">
    <h3 style="font-size:1.1rem;margin-bottom:10px;">Existing Roles</h3>
    <table class="stf-table">
        <thead><tr><th>Role</th><th>Members</th><th></th></tr></thead>
        <tbody>
            @foreach (var role in Model.Roles)
            {
                <tr>
                    <td>@role.Name</td>
                    <td>@role.MemberCount</td>
                    <td style="text-align:right;">
                        @if (!role.IsProtected && role.MemberCount == 0)
                        {
                            <form asp-action="Delete" asp-route-id="@role.Id" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="stf-btn stf-btn-danger-outline" style="padding:5px 12px;font-size:0.75rem;" onclick="return confirm('Delete the \'@role.Name\' role?');">Delete</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
</div>

@section Scripts {
    <script>
        (function () {
            var initial = new Map();
            document.querySelectorAll('.matrix-checkbox').forEach(function (cb) {
                initial.set(cb.value, cb.checked);
            });

            function recount() {
                var changed = 0;
                document.querySelectorAll('.matrix-checkbox').forEach(function (cb) {
                    if (initial.get(cb.value) !== cb.checked) changed++;
                });
                document.getElementById('changeCounter').textContent = changed + ' unsaved permission change' + (changed === 1 ? '' : 's');
            }

            document.querySelectorAll('.matrix-checkbox:not(:disabled)').forEach(function (cb) {
                cb.addEventListener('change', recount);
            });
        })();
    </script>
}