@model RoleEditViewModel
@{
    ViewData["Title"] = "Edit Role";
}
<div class="container py-4" style="max-width:640px;">
    <h2>Edit Role: @Model.Name</h2>

    @if (Model.IsProtected)
    {
        <div class="alert alert-info">
            This is a built-in role.
            @(Model.Name == "Administrator" ? "Administrators always keep every permission, to guarantee at least one account can always manage the system." : "Its permissions can still be adjusted below.")
        </div>
    }

    <form asp-controller="Roles" asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Name" />

        <label class="form-label">Permissions</label>
        <div class="border rounded p-3 mb-3">
            @foreach (var permission in Model.AllPermissions)
            {
                var isChecked = Model.SelectedPermissions.Contains(permission.Key);
                var isLocked = Model.Name == "Administrator";
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" name="SelectedPermissions" value="@permission.Key"
                           id="perm_@permission.Key" checked="@isChecked" disabled="@isLocked" />
                    <label class="form-check-label" for="perm_@permission.Key">@permission.Value</label>
                    @if (isLocked)
                    {
                        <input type="hidden" name="SelectedPermissions" value="@permission.Key" />
                    }
                </div>
            }
        </div>

        <button type="submit" class="btn btn-primary">Save Permissions</button>
        <a asp-controller="Roles" asp-action="Index" class="btn btn-link">Cancel</a>
    </form>
</div>
