@model RoleEditViewModel
@{
    ViewData["Title"] = "New Role";
    Layout = "_StaffLayout";
}

<div class="stf-content" style="max-width:560px;">
    <span class="stf-eyebrow">Custom Atelier</span>
    <h1 style="margin-bottom:8px;">Create New Role</h1>
    <p style="color:var(--stf-on-surface-variant);font-size:0.9rem;margin-bottom:24px;">Give it a name now - you'll choose exactly which permissions it grants on the matrix right after.</p>

    <form asp-controller="Roles" asp-action="Create" method="post" class="stf-card">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" style="color:var(--stf-error);margin-bottom:10px;"></div>

        <label asp-for="Name" style="font-size:0.85rem;font-weight:600;display:block;margin-bottom:6px;"></label>
        <input asp-for="Name" style="width:100%;border:1px solid var(--stf-outline-variant);border-radius:8px;padding:9px 14px;font-size:0.9rem;margin-bottom:6px;" placeholder="e.g. Tailoring Specialist" />
        <span asp-validation-for="Name" style="color:var(--stf-error);font-size:0.8rem;"></span>

        <div style="margin-top:20px;display:flex;gap:10px;">
            <button type="submit" class="stf-btn stf-btn-primary">Create Role</button>
            <a asp-controller="Roles" asp-action="Index" style="font-size:0.85rem;color:var(--stf-on-surface-variant);align-self:center;">Cancel</a>
        </div>
    </form>
</div>
