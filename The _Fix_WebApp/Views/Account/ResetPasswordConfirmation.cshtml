@{
    ViewData["Title"] = "Password reset";
    Layout = "_AuthLayout";
}

<main class="au-main">
    <partial name="_AuthCollage" />
    <section class="au-card">
        <div class="au-logo"><b>Fashion</b><i>Fix</i></div>
        <h1>Password updated</h1>
        <p class="au-lead">Your password has been reset. You can now sign in with the new one.</p>
        <a class="au-btn au-btn-primary" asp-controller="Account" asp-action="Login">Go to login</a>
    </section>
</main>
