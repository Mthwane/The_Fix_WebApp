@{
    ViewData["Title"] = "Check your email";
    Layout = "_AuthLayout";
}

<main class="au-main">
    <partial name="_AuthCollage" />
    <section class="au-card">
        <div class="au-logo"><b>Fashion</b><i>Fix</i></div>
        <h1>Check your email</h1>
        <p class="au-lead">If an account exists for that email, a password reset link is on its way. It may take a minute to arrive - check your spam folder too.</p>
        <div class="au-aside"><a asp-controller="Account" asp-action="Login">Back to login</a></div>
    </section>
</main>
