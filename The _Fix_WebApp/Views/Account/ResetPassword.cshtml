@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
    Layout = "_AuthLayout";
}

<main class="au-main">
    <partial name="_AuthCollage" />
    <section class="au-card">
        <div class="au-logo"><b>Fashion</b><i>Fix</i></div>
        <h1>Choose a new password</h1>
        <p class="au-lead">At least 10 characters, with upper and lower case, a number and a symbol.</p>

        <form asp-controller="Account" asp-action="ResetPassword" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="au-alert"></div>
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="Token" />

            <div class="au-field">
                <div class="au-label-row"><label asp-for="Password">New password</label></div>
                <div class="au-input-wrap">
                    <input asp-for="Password" type="password" placeholder="New password" autocomplete="new-password" autofocus />
                    <button type="button" class="au-eye" data-target="Password" aria-label="Show password"><span class="material-symbols-outlined">visibility</span></button>
                </div>
                <span asp-validation-for="Password" class="au-field-error"></span>
            </div>
            <div class="au-field">
                <div class="au-label-row"><label asp-for="ConfirmPassword">Confirm password</label></div>
                <div class="au-input-wrap">
                    <input asp-for="ConfirmPassword" type="password" placeholder="Repeat new password" autocomplete="new-password" />
                    <button type="button" class="au-eye" data-target="ConfirmPassword" aria-label="Show password"><span class="material-symbols-outlined">visibility</span></button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="au-field-error"></span>
            </div>
            <button type="submit" class="au-btn au-btn-primary">Reset password <span class="material-symbols-outlined">arrow_forward</span></button>
        </form>
    </section>
</main>
