@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
    Layout = "_AuthLayout";
}

<main class="au-main">
    <partial name="_AuthCollage" />
    <section class="au-card">
        <div class="au-logo"><b>Fashion</b><i>Fix</i></div>
        <h1>Forgot password</h1>
        <p class="au-lead">Enter the email on your account and we'll send you a link to reset your password.</p>

        <form asp-controller="Account" asp-action="ForgotPassword" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="au-alert"></div>
            <div class="au-field">
                <div class="au-label-row"><label asp-for="Email">Email</label></div>
                <div class="au-input-wrap">
                    <input asp-for="Email" type="email" placeholder="you@example.com" autocomplete="email" autofocus />
                    <span class="ico material-symbols-outlined">mail</span>
                </div>
                <span asp-validation-for="Email" class="au-field-error"></span>
            </div>
            <button type="submit" class="au-btn au-btn-primary">Send reset link <span class="material-symbols-outlined">arrow_forward</span></button>
        </form>

        <div class="au-aside"><a asp-controller="Account" asp-action="Login">Back to login</a></div>
    </section>
</main>
