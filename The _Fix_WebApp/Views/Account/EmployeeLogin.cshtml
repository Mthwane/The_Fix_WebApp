@model LoginViewModel
@{
    ViewData["Title"] = "Employee Login";
    Layout = "_AuthLayout";
}

<main class="au-main au-staff">
    <div class="au-panel">
        <div class="au-art" style="--au-art-img: url('@Url.Content("~/img/auth/staff-portal.jpg")');">
            <div class="big"><span>THE</span><strong>STAFF</strong><em>Portal</em></div>
            <div>
                <span class="node">Atelier operational terminal</span>
                <div class="legend">Fashion Fix &bull; Staff operations</div>
            </div>
        </div>

        <section class="au-form-side">
            <div class="au-form-head">
                <div class="au-logo"><b>Fashion</b><i>Fix</i></div>
                <span class="au-badge">Staff Portal</span>
            </div>

            <h1 style="font-size:2rem;margin-top:22px;">Employee Login</h1>
            <p class="au-lead" style="margin-bottom:20px;">Authorised personnel: Administrators, Managers, Employees &amp; Owners.</p>

            <form asp-controller="Account" asp-action="Login" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="au-alert"></div>
                <input type="hidden" asp-for="ReturnUrl" />
                <input type="hidden" asp-for="IsEmployeeLogin" value="true" />

                <div class="au-field">
                    <div class="au-label-row"><label asp-for="Username">Username / Staff ID</label></div>
                    <div class="au-input-wrap">
                        <input asp-for="Username" type="text" placeholder="Enter your staff username" autocomplete="username" autofocus />
                        <span class="ico material-symbols-outlined">badge</span>
                    </div>
                    <span asp-validation-for="Username" class="au-field-error"></span>
                </div>

                <div class="au-field">
                    <div class="au-label-row"><label asp-for="Password">Password</label></div>
                    <div class="au-input-wrap">
                        <input asp-for="Password" type="password" placeholder="Enter your password" autocomplete="current-password" />
                        <button type="button" class="au-eye" data-target="Password" aria-label="Show password"><span class="material-symbols-outlined">visibility</span></button>
                    </div>
                    <span asp-validation-for="Password" class="au-field-error"></span>
                </div>

                <div class="au-opts">
                    <label class="au-check"><input asp-for="RememberMe" type="checkbox" /> Keep me signed in on this device</label>
                </div>

                <button type="submit" class="au-btn au-btn-forest">Authorize &amp; login <span class="material-symbols-outlined">arrow_forward</span></button>
            </form>

            <div class="au-or">OR</div>
            <a class="au-btn au-btn-ghost" asp-controller="Account" asp-action="Login">
                <span class="material-symbols-outlined">person</span> Login as client
            </a>

            <div class="au-notice">
                <span class="material-symbols-outlined">info</span>
                <div>Staff privileges are restricted to active atelier personnel. Need access? Consult your <b>Head of Operations</b> or internal Systems Lead.</div>
            </div>
        </section>
    </div>
</main>
