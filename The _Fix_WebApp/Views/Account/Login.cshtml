@model LoginViewModel
@{
    ViewData["Title"] = "Login";
    ViewData["HideNav"] = true; // no navbar on the login screen
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,300;0,500;0,600;1,300&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

<style>
    :root {
        --page-bg: #F3EEE3;
        --shoes-bg: #EDE7DC;
        --headline-bg: #7D6957;
        --tagline-bg: #C58F4E;
        --umber: #3D3128;
        --cream: #F6F1E7;
        --clay: #B8703E;
        --taupe: #8C7355;
        --card: #FFFDF9;
    }

    .ff-login * {
        box-sizing: border-box;
    }

    .ff-login {
        font-family: 'Inter', sans-serif;
        background: var(--page-bg);
        color: var(--umber);
    }

        .ff-login .page {
            display: grid;
            grid-template-columns: 46% 54%;
            min-height: 100vh;
        }

        /* ---------------- LEFT: collage ---------------- */
        .ff-login .collage {
            display: flex;
            gap: 16px;
            padding: 16px;
            height: 100vh;
            background: var(--page-bg);
        }

        .ff-login .col-left {
            flex: 0 0 42%;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .ff-login .col-right {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .ff-login .tile {
            border-radius: 2px;
            overflow: hidden;
            position: relative;
        }

            .ff-login .tile img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }

        .ff-login .t-shoes {
            flex: 281 1 0;
            background: var(--shoes-bg);
        }

        .ff-login .t-tagline {
            flex: 601 1 0;
            background: var(--tagline-bg);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .ff-login .t-sunglasses {
            flex: 220 1 0;
        }

        .ff-login .t-tagline .wave {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            opacity: .55;
        }

        .ff-login .t-tagline h2 {
            position: relative;
            font-family: 'Fraunces', serif;
            font-weight: 300;
            font-size: clamp(22px,2.1vw,30px);
            line-height: 1.4;
            color: var(--cream);
            text-align: center;
        }

        .ff-login .t-headline {
            flex: 281 1 0;
            background: var(--headline-bg);
            padding: 28px 0 0 30px;
        }

            .ff-login .t-headline h1 {
                font-family: 'Fraunces', serif;
                font-weight: 300;
                font-size: clamp(24px,2vw,32px);
                line-height: 1.25;
                color: var(--cream);
            }

            .ff-login .t-headline .figure {
                position: absolute;
                right: 6%;
                bottom: -4%;
                width: 56%;
                opacity: .95;
            }

        .ff-login .t-portrait {
            flex: 419 1 0;
        }

        .ff-login .bottom-row {
            flex: 340 1 0;
            display: flex;
            gap: 16px;
        }

        .ff-login .t-shirt {
            flex: 1;
        }

        .ff-login .t-earrings {
            flex: 1;
        }

        /* ---------------- RIGHT: login form ---------------- */
        .ff-login .form-side {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 40px;
            background: var(--card);
        }

        .ff-login .form-wrap {
            width: 100%;
            max-width: 380px;
        }

        .ff-login .brand {
            font-family: 'Fraunces', serif;
            font-weight: 500;
            font-size: 15px;
            letter-spacing: .02em;
            color: var(--taupe);
            margin-bottom: 26px;
        }

            .ff-login .brand span {
                font-style: italic;
                font-weight: 300;
                color: var(--clay);
            }

        .ff-login .form-wrap h1 {
            font-family: 'Fraunces', serif;
            font-weight: 500;
            font-size: 38px;
            color: var(--umber);
            margin: 0;
        }

        .ff-login .form-wrap p.sub {
            color: var(--taupe);
            font-size: 14.5px;
            margin-top: 6px;
            margin-bottom: 32px;
        }

        .ff-login label {
            display: block;
            font-size: 12px;
            letter-spacing: .06em;
            text-transform: uppercase;
            color: var(--umber);
            margin-bottom: 7px;
            font-weight: 500;
        }

        .ff-login .field {
            margin-bottom: 20px;
        }

        .ff-login input[type=text], .ff-login input[type=password] {
            width: 100%;
            border: none;
            border-bottom: 1.5px solid #DCD3C4;
            background: transparent;
            padding: 10px 2px;
            font-size: 15px;
            font-family: 'Inter', sans-serif;
            color: var(--umber);
            transition: border-color .2s ease;
        }

            .ff-login input[type=text]:focus, .ff-login input[type=password]:focus {
                outline: none;
                border-bottom-color: var(--clay);
                box-shadow: none;
            }

        .ff-login input::placeholder {
            color: #B7AA96;
        }

        .ff-login .row-between {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin: 22px 0 26px;
            font-size: 13.5px;
        }

        .ff-login .remember {
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--taupe);
            margin-bottom: 0;
            text-transform: none;
            font-size: 13.5px;
            letter-spacing: normal;
            font-weight: 400;
        }

            .ff-login .remember input {
                accent-color: var(--clay);
                width: 15px;
                height: 15px;
                margin: 0;
            }

        .ff-login a.link {
            color: var(--clay);
            text-decoration: none;
            font-weight: 500;
        }

            .ff-login a.link:hover {
                text-decoration: underline;
            }

        .ff-login button.primary {
            width: 100%;
            background: var(--clay);
            color: var(--cream);
            border: none;
            padding: 14px;
            font-size: 14px;
            letter-spacing: .06em;
            text-transform: uppercase;
            font-weight: 600;
            border-radius: 3px;
            cursor: pointer;
            transition: background .2s ease;
        }

            .ff-login button.primary:hover {
                background: #A05F32;
                color: var(--cream);
            }

        .ff-login .divider {
            display: flex;
            align-items: center;
            gap: 12px;
            margin: 22px 0;
            color: #B7AA96;
            font-size: 11px;
            letter-spacing: .1em;
        }

            .ff-login .divider::before, .ff-login .divider::after {
                content: "";
                flex: 1;
                height: 1px;
                background: #E4DBCB;
            }

        .ff-login .btn-secondary-outline {
            display: block;
            width: 100%;
            background: transparent;
            border: 1.5px solid var(--umber);
            color: var(--umber);
            padding: 13px;
            font-size: 14px;
            letter-spacing: .06em;
            text-transform: uppercase;
            font-weight: 500;
            border-radius: 3px;
            cursor: pointer;
            transition: all .2s ease;
            text-align: center;
            text-decoration: none;
        }

            .ff-login .btn-secondary-outline:hover {
                background: var(--umber);
                color: var(--cream);
            }

        .ff-login .register {
            text-align: center;
            margin-top: 26px;
            font-size: 13.5px;
            color: var(--taupe);
        }

        .ff-login .text-danger {
            font-size: 12.5px;
        }

    @@media (max-width: 880px) {
        .ff-login .page {
            grid-template-columns: 1fr;
        }

        .ff-login .collage {
            display: none;
        }

        .ff-login .form-side {
            min-height: 100vh;
        }
    }
</style>

<div class="ff-login">
    <div class="page">

        <!-- LEFT: image collage -->
        <div class="collage">
            <div class="col-left">
                <div class="tile t-shoes">
                    <img src="https://images.unsplash.com/photo-1543163521-1bf539c55dd2?w=500&amp;q=80" alt="">
                </div>

                <div class="tile t-tagline">
                    <svg class="wave" viewBox="0 0 300 700" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
                        <g stroke="#F6F1E7" stroke-width="1.1" fill="none" opacity=".9">
                            <path d="M-20 60 Q 20 20 60 60 T 140 60 T 220 60 T 300 60 T 380 60" />
                            <path d="M-20 100 Q 20 60 60 100 T 140 100 T 220 100 T 300 100 T 380 100" />
                            <path d="M-20 140 Q 20 100 60 140 T 140 140 T 220 140 T 300 140 T 380 140" />
                            <path d="M-20 180 Q 20 140 60 180 T 140 180 T 220 180 T 300 180 T 380 180" />
                            <path d="M-20 600 Q 20 560 60 600 T 140 600 T 220 600 T 300 600 T 380 600" />
                            <path d="M-20 640 Q 20 600 60 640 T 140 640 T 220 640 T 300 640 T 380 640" />
                            <path d="M-20 680 Q 20 640 60 680 T 140 680 T 220 680 T 300 680 T 380 680" />
                        </g>
                    </svg>
                    <h2>As<br>unique<br>as<br>you are</h2>
                </div>

                <div class="tile t-sunglasses">
                    <img src="https://images.unsplash.com/photo-1511499767150-a48a237f0083?w=500&amp;q=80" alt="">
                </div>
            </div>

            <div class="col-right">
                <div class="tile t-headline">
                    <h1>Effortlessly<br>Chic</h1>
                    <svg class="figure" viewBox="0 0 200 220" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="128" cy="30" r="16" stroke="#F6F1E7" stroke-width="1.3" />
                        <path d="M75 90c5-22 25-38 50-38 20 0 37 11 45 28" stroke="#F6F1E7" stroke-width="1.3" />
                        <path d="M60 120c0-14 10-26 24-30l8 40-10 60c-2 8 2 16 10 18l4 1" stroke="#F6F1E7" stroke-width="1.3" />
                        <path d="M150 70c10 6 16 18 14 30l-10 46c-2 9-10 15-19 15h-3" stroke="#F6F1E7" stroke-width="1.3" />
                        <path d="M92 130l-14 55c-2 7 2 14 9 16" stroke="#F6F1E7" stroke-width="1.3" />
                        <path d="M84 205c-4 4-4 10 0 14" stroke="#F6F1E7" stroke-width="1.3" />
                    </svg>
                </div>

                <div class="tile t-portrait">
                    <img src="https://images.unsplash.com/photo-1509631179647-0177331693ae?w=600&amp;q=80" alt="">
                </div>

                <div class="bottom-row">
                    <div class="tile t-shirt">
                        <img src="https://images.unsplash.com/photo-1516762689617-e1cffcef479d?w=500&amp;q=80" alt="">
                    </div>
                    <div class="tile t-earrings">
                        <img src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?w=500&amp;q=80" alt="">
                    </div>
                </div>
            </div>
        </div>

        <!-- RIGHT: login form -->
        <div class="form-side">
            <div class="form-wrap">
                <div class="brand">Fashion <span>Fix</span></div>
                <h1>Login</h1>
                <p class="sub">Enter your credentials to access your account</p>

                <form asp-controller="Account" asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="ReturnUrl" />
                    <input type="hidden" asp-for="IsEmployeeLogin" value="false" />

                    <div class="field">
                        <label asp-for="Username"></label>
                        <input asp-for="Username" type="text" placeholder="Enter your username" />
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>

                    <div class="field">
                        <label asp-for="Password"></label>
                        <input asp-for="Password" type="password" placeholder="Enter your password" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="row-between">
                        <label class="remember"><input asp-for="RememberMe" type="checkbox" /> Remember me</label>
                        
                    </div>

                    <button type="submit" class="primary">Login</button>
                </form>

                <div class="divider">OR</div>

                <a asp-controller="Account" asp-action="EmployeeLogin" class="btn-secondary-outline">
                    Login as Employee
                </a>

                <p class="register">
                    Don't have an account?
                    <a class="link" asp-controller="Account" asp-action="Register">Register</a>
                </p>
            </div>
        </div>

    </div>
</div>
