@model LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "_AuthLayout";
}

<main class="au-main">
    <partial name="_AuthCollage" />

    <section class="au-card">
        <div class="au-logo"><b>Fashion</b><i>Fix</i></div>
        <span class="au-kicker">Private Client Access</span>

        <h1>Login</h1>
        <p class="au-lead">Enter your credentials to access your curated wardrobe &amp; consultations.</p>

        <form asp-controller="Account" asp-action="Login" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="au-alert"></div>
            <input type="hidden" asp-for="ReturnUrl" />
            <input type="hidden" asp-for="IsEmployeeLogin" value="false" />

            <div class="au-field">
                <div class="au-label-row"><label asp-for="Username">Username</label><span>Client ID or Email</span></div>
                <div class="au-input-wrap">
                    <input asp-for="Username" type="text" placeholder="Enter your username or email" autocomplete="username" autofocus />
                    <span class="ico material-symbols-outlined">person</span>
                </div>
                <span asp-validation-for="Username" class="au-field-error"></span>
            </div>

            <div class="au-field">
                <div class="au-label-row"><label asp-for="Password">Password</label></div>
                <div class="au-input-wrap">
                    <input asp-for="Password" type="password" placeholder="Enter your password" autocomplete="current-password" />
                    <button type="button" class="au-eye" data-target="Password" aria-label="Show password"><span class="material-symbols-outlined">visibility</span></button>
                </div>
                <span asp-validation-for="Password" class="au-field-error"></span>
            </div>

            <div class="au-opts">
                <label class="au-check"><input asp-for="RememberMe" type="checkbox" /> Remember me</label>
            </div>

            <button type="submit" class="au-btn au-btn-primary">Login <span class="material-symbols-outlined">arrow_forward</span></button>
        </form>

        <div class="au-or">OR</div>
        <a class="au-link-btn" asp-controller="Account" asp-action="EmployeeLogin">
            <span class="material-symbols-outlined">badge</span> Login as employee
        </a>

        <div class="au-aside">
            Don't have an account? <a asp-controller="Account" asp-action="Register">Register</a>
        </div>
    </section>
</main>
