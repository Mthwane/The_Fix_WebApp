@model List<FeaturedProduct>
@{
    ViewData["Title"] = "Trending This Week";
    Layout = "_StaffLayout";
    var available = ViewBag.AvailableProducts as List<Product> ?? new();
}
<div class="stf-content">
    <span class="stf-eyebrow">Storefront</span>
    <h1 style="margin-bottom:6px;">Homepage Trending Curation</h1>
    <p style="color:var(--stf-on-surface-variant);margin-bottom:20px;">Products shown in the "Trending This Week" section of the storefront homepage. If none are added here, the homepage falls back to an automatic pick (highest rated / most reviewed).</p>

    <form asp-action="AddTrending" method="post" class="stf-card" style="display:flex;gap:10px;margin-bottom:24px;">
        @Html.AntiForgeryToken()
        <select name="productId" required style="flex:1;border:1px solid var(--stf-outline-variant);border-radius:8px;padding:9px 14px;font-size:0.9rem;">
            <option value="">-- Choose a product to feature --</option>
            @foreach (var p in available)
            {
                <option value="@p.ProductId">@p.Name (@p.Category)</option>
            }
        </select>
        <button type="submit" class="stf-btn stf-btn-primary">+ Add</button>
    </form>

    @if (!Model.Any())
    {
        <div class="stf-card" style="text-align:center;padding:40px 20px;color:var(--stf-on-surface-variant);">Nothing curated yet - the homepage is showing its automatic fallback pick.</div>
    }
    else
    {
        @foreach (var f in Model)
        {
            <form asp-action="UpdateTrending" asp-route-id="@f.FeaturedProductId" method="post" class="stf-card" style="margin-bottom:16px;">
                @Html.AntiForgeryToken()
                <div style="display:grid;grid-template-columns:80px 1fr 1fr 1fr 70px 80px;gap:14px;align-items:end;">
                    <img src="@(f.OverrideImageUrl ?? f.Product.ImageUrl ?? "https://placehold.co/150x150?text=No+Image")" style="width:80px;height:80px;object-fit:cover;border-radius:8px;" alt="" />
                    <div>
                        <div style="font-size:0.72rem;color:var(--stf-on-surface-variant);margin-bottom:4px;">Product</div>
                        <div style="font-weight:600;">@f.Product.Name</div>
                        <div style="font-size:0.8rem;color:var(--stf-on-surface-variant);">R@f.Product.SellingPrice.ToString("N2")</div>
                    </div>
                    <div>
                        <label style="font-size:0.75rem;display:block;margin-bottom:4px;">Override Title <span style="color:var(--stf-outline);">(blank = product name)</span></label>
                        <input name="overrideTitle" value="@f.OverrideTitle" style="width:100%;border:1px solid var(--stf-outline-variant);border-radius:6px;padding:6px 10px;font-size:0.85rem;" />
                    </div>
                    <div>
                        <label style="font-size:0.75rem;display:block;margin-bottom:4px;">Override Badge</label>
                        <input name="overrideBadge" value="@f.OverrideBadge" placeholder="e.g. Bestseller" style="width:100%;border:1px solid var(--stf-outline-variant);border-radius:6px;padding:6px 10px;font-size:0.85rem;" />
                    </div>
                    <div>
                        <label style="font-size:0.75rem;display:block;margin-bottom:4px;">Order</label>
                        <input type="number" name="displayOrder" value="@f.DisplayOrder" style="width:100%;border:1px solid var(--stf-outline-variant);border-radius:6px;padding:6px 10px;font-size:0.85rem;" />
                    </div>
                    <label style="font-size:0.78rem;display:flex;align-items:center;gap:6px;">
                        <input type="checkbox" name="isActive" value="true" checked="@f.IsActive" /> Active
                    </label>
                </div>
                <div style="margin-top:12px;">
                    <label style="font-size:0.75rem;display:block;margin-bottom:4px;">Override Image URL <span style="color:var(--stf-outline);">(blank = product's own image)</span></label>
                    <input name="overrideImageUrl" value="@f.OverrideImageUrl" placeholder="https://..." style="width:100%;border:1px solid var(--stf-outline-variant);border-radius:6px;padding:6px 10px;font-size:0.85rem;" />
                </div>
                <div style="margin-top:14px;display:flex;gap:10px;">
                    <button type="submit" class="stf-btn stf-btn-outline" style="padding:7px 16px;font-size:0.8rem;">Save</button>
                    <button type="submit" formaction="@Url.Action("RemoveTrending", new { id = f.FeaturedProductId })" class="stf-btn stf-btn-danger-outline" style="padding:7px 16px;font-size:0.8rem;"
                            onclick="return confirm('Remove this from Trending This Week?');">Remove</button>
                </div>
            </form>
        }
    }
</div>
