@model List<Order>
@{
    ViewData["Title"] = "Reports & Analytics";
    var bestSellers = ViewBag.BestSellers as IEnumerable<dynamic>;
    var revenueByCategory = ViewBag.RevenueByCategory as IEnumerable<dynamic>;
}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Reports & Analytics</h2>
        <div>
            <a asp-controller="Reports" asp-action="Inventory" class="btn btn-outline-secondary">Inventory Report</a>
            <a asp-controller="Reports" asp-action="Employees" class="btn btn-outline-secondary">Employee Performance</a>
        </div>
    </div>

    <form asp-controller="Reports" asp-action="Index" method="get" class="row g-2 mb-4 align-items-end">
        <div class="col-auto">
            <label class="form-label">From</label>
            <input type="date" name="from" value="@(((DateTime)ViewBag.From).ToString("yyyy-MM-dd"))" class="form-control" />
        </div>
        <div class="col-auto">
            <label class="form-label">To</label>
            <input type="date" name="to" value="@(((DateTime)ViewBag.To).ToString("yyyy-MM-dd"))" class="form-control" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Update</button>
        </div>
        <div class="col-auto">
            <a class="btn btn-outline-success"
               asp-controller="Reports" asp-action="Export"
               asp-route-format="csv"
               asp-route-from="@(((DateTime)ViewBag.From).ToString("yyyy-MM-dd"))"
               asp-route-to="@(((DateTime)ViewBag.To).ToString("yyyy-MM-dd"))">
                Export CSV
            </a>
        </div>
    </form>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card"><div class="card-body">
                <h6 class="text-muted">Total Revenue</h6>
                <h3>@(((decimal)ViewBag.TotalRevenue).ToString("C"))</h3>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card"><div class="card-body">
                <h6 class="text-muted">Orders</h6>
                <h3>@ViewBag.OrderCount</h3>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card"><div class="card-body">
                <h6 class="text-muted">Est. Cost of Goods</h6>
                <h3>@(((decimal)ViewBag.EstimatedExpenses).ToString("C"))</h3>
            </div></div>
        </div>
        <div class="col-md-3">
            <div class="card border-success"><div class="card-body">
                <h6 class="text-muted">Est. Gross Profit</h6>
                <h3>@(((decimal)ViewBag.EstimatedProfit).ToString("C"))</h3>
            </div></div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <h5>Best Sellers</h5>
            <table class="table table-sm">
                <thead><tr><th>Product</th><th>Units Sold</th><th>Revenue</th></tr></thead>
                <tbody>
                @if (bestSellers is not null)
                {
                    @foreach (var b in bestSellers)
                    {
                        <tr><td>@b.Name</td><td>@b.UnitsSold</td><td>@(((decimal)b.Revenue).ToString("C"))</td></tr>
                    }
                }
                </tbody>
            </table>
        </div>
        <div class="col-md-6">
            <h5>Revenue by Category</h5>
            <table class="table table-sm">
                <thead><tr><th>Category</th><th>Revenue</th></tr></thead>
                <tbody>
                @if (revenueByCategory is not null)
                {
                    @foreach (var c in revenueByCategory)
                    {
                        <tr><td>@c.Category</td><td>@(((decimal)c.Revenue).ToString("C"))</td></tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>

    <h5 class="mt-4">Orders in Range</h5>
    <table class="table table-sm">
        <thead><tr><th>Order #</th><th>Date</th><th>Type</th><th>Status</th><th>Payment</th><th>Total</th></tr></thead>
        <tbody>
        @foreach (var o in Model.OrderByDescending(o => o.DateCreated))
        {
            <tr>
                <td>@o.OrderNumber</td>
                <td>@o.DateCreated.ToLocalTime()</td>
                <td>@o.OrderType</td>
                <td>@o.Status</td>
                <td>@o.PaymentMethod</td>
                <td>@o.GrandTotal.ToString("C")</td>
            </tr>
        }
        </tbody>
    </table>
</div>
