@model List<Product>
@{
    ViewData["Title"] = "Inventory Report";
    var unitsSold = ViewBag.UnitsSoldLast30Days as Dictionary<int, int> ?? new();
}
<div class="container py-4">
    <h1>Inventory Report</h1>
    <p class="text-muted">Stock turnover and low-stock overview across all active products.</p>

    <table class="table table-hover">
        <thead><tr><th>Product</th><th>SKU</th><th>Category</th><th>Current Stock</th><th>Threshold</th><th>Units Sold (30d)</th><th>Status</th></tr></thead>
        <tbody>
        @foreach (var p in Model)
        {
            <tr class="@(p.IsLowStock ? "table-warning" : "")">
                <td>@p.Name</td>
                <td>@p.SKU</td>
                <td>@p.Category</td>
                <td>@p.StockQuantity</td>
                <td>@p.LowStockThreshold</td>
                <td>@(unitsSold.GetValueOrDefault(p.ProductId, 0))</td>
                <td>
                    @if (p.IsLowStock)
                    {
                        <span class="badge bg-warning text-dark">Low Stock</span>
                    }
                    else
                    {
                        <span class="badge bg-success">OK</span>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
