@{
    ViewData["Title"] = "Add Funds";
    Layout = "_StorefrontLayout";
}

<section class="ffs-section" style="padding-top:32px;">
    <div class="ffs-container" style="max-width:480px;">
        <div style="margin-bottom:18px;">
            <a asp-action="Index" style="color:var(--ffs-ink-muted);font-size:0.85rem;text-decoration:none;">&larr; Back to Wallet</a>
        </div>

        <span class="ffs-eyebrow">Wallet</span>
        <h1 style="font-family:'Fraunces',serif;font-size:1.9rem;margin-bottom:20px;">Add Funds to FixCash</h1>

        <form asp-action="Deposit" method="post" style="border:1px solid var(--ffs-border);border-radius:var(--ffs-radius);padding:24px;background:var(--ffs-card);">
            @Html.AntiForgeryToken()
            <div style="margin-bottom:8px;">
                <label style="font-size:0.85rem;font-weight:600;display:block;margin-bottom:6px;">Amount (R)</label>
                <input type="number" name="amount" step="0.01" min="10" max="50000" required placeholder="e.g. 500.00"
                       style="width:100%;border:1px solid var(--ffs-border);border-radius:8px;padding:9px 14px;font-size:0.95rem;" />
            </div>
            <p style="color:var(--ffs-ink-muted);font-size:0.78rem;margin-bottom:20px;">Minimum R10.00, maximum R50,000.00 per deposit. You'll be taken to Paystack's secure page to complete payment.</p>

            <div style="display:flex;gap:10px;">
                <button type="submit" class="ffs-btn ffs-btn-forest">Continue to Payment</button>
                <a asp-action="Index" style="align-self:center;color:var(--ffs-ink-muted);font-size:0.85rem;">Cancel</a>
            </div>
        </form>
    </div>
</section>
