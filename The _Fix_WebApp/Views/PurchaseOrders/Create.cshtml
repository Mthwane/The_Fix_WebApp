@model PurchaseOrder
@{
    ViewData["Title"] = "New Purchase Order";
    Layout = "_StaffLayout";
    var suppliers = (List<Supplier>)ViewBag.Suppliers;
    var variants = (List<ProductVariant>)ViewBag.Variants;
}

<div class="stf-content" style="max-width:960px;">
    <span class="stf-eyebrow">Supply Chain</span>
    <h1 style="margin-bottom:20px;">New Purchase Order</h1>

    <form asp-action="Create" method="post" class="stf-card">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" style="color:var(--stf-error);margin-bottom:10px;"></div>

        @{ string L = "font-size:0.85rem;font-weight:600;display:block;margin-bottom:6px;"; string F = "width:100%;border:1px solid var(--stf-outline-variant);border-radius:8px;padding:9px 14px;font-size:0.9rem;"; }

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:14px;">
            <div>
                <label style="@L">Supplier</label>
                <select name="supplierId" id="supplierSelect" style="@F" required>
                    <option value="">-- Choose a supplier --</option>
                    @foreach (var s in suppliers)
                    {
                        <option value="@s.SupplierId">@s.Name</option>
                    }
                </select>
            </div>
            <div>
                <label style="@L">Expected Delivery</label>
                <input type="date" name="dateExpected" value="@Model.DateExpected?.ToString("yyyy-MM-dd")" style="@F" />
            </div>
        </div>

        <label style="@L">Notes</label>
        <textarea name="notes" rows="2" style="@F margin-bottom:16px;" placeholder="Optional - visible to whoever approves this request.">@Model.Notes</textarea>

        <h5 style="font-family:'Newsreader',serif;font-size:1.1rem;margin:8px 0 6px;">Line Items</h5>
        <div id="supplierHint" style="font-size:0.8rem;color:var(--stf-on-surface-variant);margin-bottom:10px;">Choose a supplier first - only that supplier's products can be added.</div>

        <table class="stf-table" id="lineTable" style="margin-bottom:12px;">
            <thead>
                <tr>
                    <th>Variant</th>
                    <th style="width:110px;">Quantity</th>
                    <th style="width:130px;">Unit Cost</th>
                    <th style="width:70px;"></th>
                </tr>
            </thead>
            <tbody id="lineBody"></tbody>
        </table>

        <button type="button" id="addLine" class="stf-btn stf-btn-outline" style="margin-bottom:20px;" disabled>+ Add Line</button>

        <div style="display:flex;gap:10px;">
            <button type="submit" class="stf-btn stf-btn-primary">Save as Draft</button>
            <a asp-action="Index" style="font-size:0.85rem;color:var(--stf-on-surface-variant);align-self:center;">Cancel</a>
        </div>
    </form>
</div>

<script id="variantData" type="application/json">@Html.Raw(Json.Serialize(variants.Select(v => new { id = v.ProductVariantId, label = $"{v.Product.Name} - {v.DisplaySize}/{v.Color} ({v.SKU})", stock = v.StockQuantity, low = v.IsLowStock, cost = v.Product.CostPrice, supplierId = v.Product.SupplierId })))</script>
<script>
    (function () {
        var allVariants = JSON.parse(document.getElementById('variantData').textContent);
        var variants = [];
        var body = document.getElementById('lineBody');
        var supplierSelect = document.getElementById('supplierSelect');
        var addBtn = document.getElementById('addLine');
        var hint = document.getElementById('supplierHint');

        function optionsHtml() {
            return '<option value="">-- Choose a variant --</option>' +
                variants.map(function (v) { return '<option value="' + v.id + '" data-cost="' + v.cost + '">' + v.label + '</option>'; }).join('');
        }

        // Only the chosen supplier's products are selectable. Changing supplier clears the lines,
        // so an order can never mix one supplier's name with another supplier's stock.
        function applySupplier() {
            var sid = parseInt(supplierSelect.value, 10);
            body.innerHTML = '';
            if (!sid) {
                variants = [];
                addBtn.disabled = true;
                hint.textContent = "Choose a supplier first - only that supplier's products can be added.";
                return;
            }
            variants = allVariants.filter(function (v) { return v.supplierId === sid; });
            if (variants.length === 0) {
                addBtn.disabled = true;
                hint.textContent = "No products are linked to this supplier yet. Open a product, pick this supplier under Supplier, and save - then it will appear here.";
                return;
            }
            addBtn.disabled = false;
            hint.textContent = variants.length + " variant(s) available from this supplier.";
            addRow();
        }


        // Low-stock hint shown under the chosen variant, so the raiser can see what is actually running out.
        function stockBadge(v) {
            if (!v) return '';
            if (v.stock <= 0) return '<span class="stf-badge stf-badge-danger" style="margin-top:4px;">Out of stock</span>';
            if (v.low) return '<span class="stf-badge" style="margin-top:4px;background:var(--stf-secondary-container);color:var(--stf-secondary);">Low stock &middot; ' + v.stock + ' left</span>';
            return '<span style="display:block;margin-top:4px;font-size:0.72rem;color:var(--stf-on-surface-variant);">' + v.stock + ' in stock</span>';
        }
        function wireStock(row) {
            var sel = row.querySelector('select[name="variantIds"]');
            var out = row.querySelector('.stock-badge');
            if (!sel || !out) return;
            var pool = (typeof allVariants !== 'undefined') ? allVariants : variants;
            function upd() {
                var id = parseInt(sel.value, 10);
                out.innerHTML = stockBadge(pool.find(function (x) { return x.id === id; }));
            }
            sel.addEventListener('change', upd);
            upd();
        }

        function addRow() {
            var row = document.createElement('tr');
            row.innerHTML =
                '<td><select name="variantIds" class="line-variant" style="width:100%;border:1px solid var(--stf-outline-variant);border-radius:8px;padding:7px 10px;">' + optionsHtml() + '</select><div class="stock-badge"></div></td>' +
                '<td><input type="number" name="quantities" min="1" value="1" style="width:100%;border:1px solid var(--stf-outline-variant);border-radius:8px;padding:7px 10px;" /></td>' +
                '<td><input type="number" name="unitCosts" step="0.01" min="0" style="width:100%;border:1px solid var(--stf-outline-variant);border-radius:8px;padding:7px 10px;" /></td>' +
                '<td><button type="button" class="stf-btn stf-btn-danger-outline remove-line" style="padding:6px 10px;font-size:0.75rem;">Remove</button></td>';
            body.appendChild(row);
            wireStock(row);

            var select = row.querySelector('.line-variant');
            var costInput = row.querySelector('input[name="unitCosts"]');
            select.addEventListener('change', function () {
                var opt = select.options[select.selectedIndex];
                var cost = opt ? opt.getAttribute('data-cost') : null;
                if (cost) costInput.value = parseFloat(cost).toFixed(2);
            });
            row.querySelector('.remove-line').addEventListener('click', function () {
                if (document.querySelectorAll('.line-variant').length > 1) row.remove();
            });
        }

        addBtn.addEventListener('click', addRow);
        supplierSelect.addEventListener('change', applySupplier);
        applySupplier();
    })();
</script>
