@model PurchaseOrderViewModel
@{
    ViewData["Title"] = "Create Purchase Order";
    var suppliers = ViewBag.Suppliers as List<Supplier> ?? new();
    var products = ViewBag.Products as List<Product> ?? new();
}
<div class="container py-4">
    <h2>Create Purchase Order</h2>

    <form asp-controller="PurchaseOrders" asp-action="Create" method="post" id="poForm">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row mb-3">
            <div class="col-md-6">
                <label asp-for="SupplierId" class="form-label"></label>
                <select asp-for="SupplierId" class="form-select">
                    <option value="">-- Select supplier --</option>
                    @foreach (var s in suppliers)
                    {
                        <option value="@s.SupplierId">@s.Name (lead time: @s.LeadTimeDays days)</option>
                    }
                </select>
                <span asp-validation-for="SupplierId" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="DateExpected" class="form-label"></label>
                <input asp-for="DateExpected" class="form-control" type="date" />
            </div>
        </div>

        <h5>Line Items</h5>
        <table class="table" id="linesTable">
            <thead><tr><th>Product</th><th>Quantity</th><th>Unit Cost</th><th></th></tr></thead>
            <tbody id="linesBody">
                <tr class="line-row">
                    <td>
                        <select name="Lines[0].ProductId" class="form-select">
                            <option value="">-- Select product --</option>
                            @foreach (var p in products)
                            {
                                <option value="@p.ProductId">@p.Name (@p.SKU)</option>
                            }
                        </select>
                    </td>
                    <td><input name="Lines[0].QuantityOrdered" type="number" min="1" value="1" class="form-control" /></td>
                    <td><input name="Lines[0].UnitCost" type="number" min="0" step="0.01" value="0" class="form-control" /></td>
                    <td><button type="button" class="btn btn-outline-danger btn-sm remove-line">&times;</button></td>
                </tr>
            </tbody>
        </table>
        <button type="button" id="addLineBtn" class="btn btn-outline-secondary btn-sm mb-3">+ Add Line</button>

        <div>
            <button type="submit" class="btn btn-primary">Save Purchase Order</button>
            <a asp-controller="PurchaseOrders" asp-action="Index" class="btn btn-link">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            var products = @Html.Raw(Json.Serialize(products.Select(p => new { p.ProductId, Label = p.Name + " (" + p.SKU + ")" })));
            var linesBody = document.getElementById('linesBody');
            var addLineBtn = document.getElementById('addLineBtn');
            var lineIndex = 1;

            function productOptions() {
                var html = '<option value="">-- Select product --</option>';
                products.forEach(function (p) {
                    html += '<option value="' + p.productId + '">' + p.label + '</option>';
                });
                return html;
            }

            addLineBtn.addEventListener('click', function () {
                var row = document.createElement('tr');
                row.className = 'line-row';
                row.innerHTML =
                    '<td><select name="Lines[' + lineIndex + '].ProductId" class="form-select">' + productOptions() + '</select></td>' +
                    '<td><input name="Lines[' + lineIndex + '].QuantityOrdered" type="number" min="1" value="1" class="form-control" /></td>' +
                    '<td><input name="Lines[' + lineIndex + '].UnitCost" type="number" min="0" step="0.01" value="0" class="form-control" /></td>' +
                    '<td><button type="button" class="btn btn-outline-danger btn-sm remove-line">&times;</button></td>';
                linesBody.appendChild(row);
                lineIndex++;
            });

            linesBody.addEventListener('click', function (e) {
                if (e.target.classList.contains('remove-line')) {
                    if (linesBody.querySelectorAll('.line-row').length > 1) {
                        e.target.closest('tr').remove();
                    }
                }
            });
        })();
    </script>
}
