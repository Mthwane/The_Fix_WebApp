@model SupportTicket
@{
    ViewData["Title"] = $"Ticket: {Model.Subject}";
    Layout = "_AccountLayout";

    (string bg, string fg) BadgeColors(TicketStatus s) => s switch
    {
        TicketStatus.Resolved or TicketStatus.Closed => ("var(--ffs-cream-alt)", "var(--ffs-ink-muted)"),
        TicketStatus.Escalated => ("var(--ffs-clay)", "#fff"),
        TicketStatus.InProgress => ("var(--ffs-sage)", "var(--ffs-sage-text)"),
        _ => ("var(--ffs-forest)", "#fff")
    };
    var (badgeBg, badgeFg) = BadgeColors(Model.Status);
}

<section class="ffs-section" style="padding-top:32px;">
    <div class="ffs-container" style="max-width:720px;">
        <div style="margin-bottom:18px;">
            <a asp-action="Tickets" style="color:var(--ffs-ink-muted);font-size:0.85rem;text-decoration:none;">&larr; Back to My Tickets</a>
        </div>

        <div class="ffs-section-head">
            <div>
                <span class="ffs-eyebrow">@Model.Category</span>
                <h1 style="font-family:'Fraunces',serif;font-size:1.8rem;">@Model.Subject</h1>
                <p style="color:var(--ffs-ink-muted);font-size:0.85rem;">
                    Opened @Model.DateCreated.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                    @if (Model.Order is not null)
                    {
                        <text> &bull; Order #@Model.Order.OrderNumber</text>
                    }
                </p>
            </div>
            <span style="background:@badgeBg;color:@badgeFg;font-size:0.78rem;font-weight:600;padding:6px 14px;border-radius:999px;white-space:nowrap;">@Model.Status</span>
        </div>

        <div style="display:flex;flex-direction:column;gap:14px;margin-bottom:24px;">
            @foreach (var m in Model.Messages.OrderBy(m => m.DateSent))
            {
                var isCustomer = m.SenderType == TicketSenderType.Customer;
                var isSystem = m.SenderType == TicketSenderType.System;
                <div style="align-self:@(isCustomer ? "flex-end" : "flex-start");max-width:80%;">
                    @if (isSystem)
                    {
                        <div style="text-align:center;color:var(--ffs-ink-muted);font-size:0.78rem;font-style:italic;">@m.Body</div>
                    }
                    else
                    {
                        <div style="background:@(isCustomer ? "var(--ffs-forest)" : "var(--ffs-cream-alt)");color:@(isCustomer ? "#fff" : "var(--ffs-ink)");border-radius:var(--ffs-radius);padding:12px 16px;">
                            <div style="font-size:0.72rem;font-weight:600;margin-bottom:4px;opacity:0.8;">
                                @(isCustomer ? "You" : (m.Sender?.FullName ?? "Fashion Fix Support")) &bull; @m.DateSent.ToLocalTime().ToString("dd MMM, HH:mm")
                            </div>
                            <div style="font-size:0.9rem;white-space:pre-line;">@m.Body</div>
                            @if (m.Attachments.Count > 0)
                            {
                                <div class="tk-msg-imgs">
                                    @foreach (var a in m.Attachments)
                                    {
                                        <a href="@a" target="_blank" rel="noopener"><img src="@a" alt="Attachment" loading="lazy" /></a>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @if (Model.Status != TicketStatus.Closed)
        {
            <form asp-action="Reply" asp-route-id="@Model.SupportTicketId" method="post" enctype="multipart/form-data" style="border:1px solid var(--ffs-border);border-radius:var(--ffs-radius);padding:18px;background:var(--ffs-card);">
                <textarea name="message" rows="3" placeholder="Add a reply..." style="width:100%;border:1px solid var(--ffs-border);border-radius:8px;padding:9px 14px;font-size:0.9rem;margin-bottom:10px;"></textarea>
                <label class="tk-attach-pick">
                    <span>&#128247; Attach images (max 3)</span>
                    <input type="file" name="attachments" accept="image/jpeg,image/png,image/webp" multiple data-previews="replyPreviews" />
                </label>
                <div class="tk-previews" id="replyPreviews"></div>
                <div style="display:flex;gap:10px;align-items:center;">
                    <button type="submit" class="ffs-btn ffs-btn-forest">Send Reply</button>
                </div>
            </form>
            <form asp-action="Close" asp-route-id="@Model.SupportTicketId" method="post" style="margin-top:12px;text-align:right;" onsubmit="return confirm('Close this ticket? The conversation will be locked and saved to your Ticket History.');">
                <button type="submit" class="ffs-btn ffs-btn-outline" style="font-size:0.82rem;padding:8px 16px;">Close this ticket</button>
            </form>
        }
        else
        {
            <div style="border:1px solid var(--ffs-border);border-radius:var(--ffs-radius);padding:20px;background:var(--ffs-cream-alt);text-align:center;">
                <p style="color:var(--ffs-ink-muted);font-size:0.88rem;margin:0 0 12px;">This conversation is closed and saved to your Ticket History.</p>
                <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap;">
                    @if (Model.TranscriptText is not null)
                    {
                        <a asp-action="Transcript" asp-route-id="@Model.SupportTicketId" class="ffs-btn ffs-btn-forest">Download transcript (.txt)</a>
                    }
                    <a asp-action="NewTicket" class="ffs-btn ffs-btn-outline">Open a new ticket</a>
                </div>
            </div>
        }
    </div>
</section>

<style>
    .tk-attach-pick { display:inline-flex;align-items:center;gap:8px;border:1px dashed var(--ffs-border);border-radius:999px;padding:8px 16px;font-size:0.82rem;cursor:pointer;background:#fff;margin-bottom:10px; }
    .tk-attach-pick:hover { border-color:var(--ffs-forest); }
    .tk-attach-pick input { display:none; }
    .tk-previews { display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px; }
    .tk-previews img, .tk-msg-imgs img { width:72px;height:72px;object-fit:cover;border-radius:8px;border:1px solid var(--ffs-border); }
    .tk-msg-imgs { display:flex;gap:6px;flex-wrap:wrap;margin-top:8px; }
</style>
<script>
    document.querySelectorAll('input[type=file][data-previews]').forEach(function (input) {
        input.addEventListener('change', function () {
            var box = document.getElementById(input.getAttribute('data-previews'));
            box.innerHTML = '';
            Array.prototype.slice.call(input.files, 0, 3).forEach(function (f) {
                var img = document.createElement('img');
                img.src = URL.createObjectURL(f);
                box.appendChild(img);
            });
        });
    });
</script>
