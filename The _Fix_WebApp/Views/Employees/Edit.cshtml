@model EmployeeEditViewModel
@{
    ViewData["Title"] = "Edit Employee";
    Layout = "_StaffLayout";
    var roles = ViewBag.AssignableRoles as List<string> ?? new List<string>();
}

<div class="stf-content">
    <div class="stf-page-head">
        <div>
            <span class="stf-eyebrow">Identity &amp; Governance &bull; Employees.Manage</span>
            <h1>Edit Employee</h1>
            <p>Update profile details, role and employment status. Login credentials are not changed here.</p>
        </div>
        <a class="stf-btn stf-btn-outline" asp-controller="Employees" asp-action="Index">&larr; Back to directory</a>
    </div>

    <form asp-controller="Employees" asp-action="Edit" asp-route-id="@Model.Id" method="post" class="stf-form-card" novalidate>
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="stf-form-alert"></div>

        <h2 class="stf-form-section">Identity</h2>
        <div class="stf-form-grid">
            <div class="stf-field">
                <label asp-for="FullName"></label>
                <input asp-for="FullName" type="text" />
                <span asp-validation-for="FullName" class="stf-err"></span>
            </div>
            <div class="stf-field">
                <label asp-for="Email"></label>
                <input asp-for="Email" type="email" />
                <span asp-validation-for="Email" class="stf-err"></span>
            </div>
        </div>

        <h2 class="stf-form-section">Role &amp; employment</h2>
        <div class="stf-form-grid">
            <div class="stf-field">
                <label asp-for="JobPosition"></label>
                <input asp-for="JobPosition" type="text" list="jobPositionOptions" autocomplete="off" placeholder="Choose or type a position" />
                <datalist id="jobPositionOptions">@foreach (var jp in (List<string>)(ViewBag.JobPositions ?? new List<string>())) { <option value="@jp"></option> }</datalist>
                <span asp-validation-for="JobPosition" class="stf-err"></span>
            </div>
            <div class="stf-field">
                <label asp-for="EmploymentStatus"></label>
                <select asp-for="EmploymentStatus">
                    @foreach (var status in EmployeeEditViewModel.EmploymentStatuses)
                    {
                        <option value="@status" selected="@(Model.EmploymentStatus == status)">@status</option>
                    }
                </select>
            </div>
            <div class="stf-field">
                <label asp-for="Role"></label>
                <select asp-for="Role">
                    @foreach (var role in roles)
                    {
                        <option value="@role" selected="@(Model.Role == role)">@role</option>
                    }
                </select>
            </div>
            <div class="stf-field">
                <label class="stf-switch" style="text-transform:none;letter-spacing:0;font-weight:500;">
                    <input asp-for="IsActive" type="checkbox" /> Account is active
                </label>
            </div>
        </div>

        <div class="stf-form-actions">
            <button type="submit" class="stf-btn stf-btn-primary">Save changes</button>
            <a class="stf-btn stf-btn-outline" asp-controller="Employees" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>
