@model EmployeeViewModel
@{
    ViewData["Title"] = "Add Employee";
    Layout = "_StaffLayout";
    var roles = ViewBag.AssignableRoles as List<string> ?? new List<string>();
}

<div class="stf-content">
    <div class="stf-page-head">
        <div>
            <span class="stf-eyebrow">Identity &amp; Governance &bull; Employees.Manage</span>
            <h1>Add Employee</h1>
            <p>Create a staff account and assign its role. Permissions come from the role - adjust them on the Roles &amp; Permissions screen.</p>
        </div>
        <a class="stf-btn stf-btn-outline" asp-controller="Employees" asp-action="Index">&larr; Back to directory</a>
    </div>

    <form asp-controller="Employees" asp-action="CreateEmployee" method="post" class="stf-form-card" novalidate>
        <div asp-validation-summary="ModelOnly" class="stf-form-alert"></div>

        <h2 class="stf-form-section">Identity</h2>
        <div class="stf-form-grid">
            <div class="stf-field">
                <label asp-for="FullName"></label>
                <input asp-for="FullName" type="text" autocomplete="off" />
                <span asp-validation-for="FullName" class="stf-err"></span>
            </div>
            <div class="stf-field">
                <label asp-for="Username"></label>
                <input asp-for="Username" type="text" autocomplete="off" />
                <span class="stf-hint">They sign in on the Employee Login screen with this.</span>
                <span asp-validation-for="Username" class="stf-err"></span>
            </div>
            <div class="stf-field full">
                <label asp-for="Email"></label>
                <input asp-for="Email" type="email" autocomplete="off" />
                <span asp-validation-for="Email" class="stf-err"></span>
            </div>
        </div>

        <h2 class="stf-form-section">Role &amp; position</h2>
        <div class="stf-form-grid">
            <div class="stf-field">
                <label asp-for="JobPosition"></label>
                <input asp-for="JobPosition" type="text" list="jobPositionOptions" autocomplete="off" placeholder="Choose or type a position" />
                <datalist id="jobPositionOptions">@foreach (var jp in (List<string>)(ViewBag.JobPositions ?? new List<string>())) { <option value="@jp"></option> }</datalist>
                <span asp-validation-for="JobPosition" class="stf-err"></span>
            </div>
            <div class="stf-field">
                <label asp-for="Role"></label>
                <select asp-for="Role">
                    <option value="">Select a role</option>
                    @foreach (var role in roles)
                    {
                        <option value="@role" selected="@(Model.Role == role)">@role</option>
                    }
                </select>
                <span asp-validation-for="Role" class="stf-err"></span>
            </div>
        </div>

        <h2 class="stf-form-section">Access</h2>
        <div class="stf-form-grid">
            <div class="stf-field full">
                <label asp-for="Password"></label>
                <input asp-for="Password" type="password" autocomplete="new-password" />
                <span class="stf-hint">The employee should change this after their first login.</span>
                <span asp-validation-for="Password" class="stf-err"></span>
            </div>
        </div>

        <div class="stf-form-actions">
            <button type="submit" class="stf-btn stf-btn-primary">Create employee</button>
            <a class="stf-btn stf-btn-outline" asp-controller="Employees" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>
