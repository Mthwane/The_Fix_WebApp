@model List<ApplicationUser>
@{
    ViewData["Title"] = "Employees";
    var roles = ViewBag.Roles as Dictionary<string, string> ?? new();
    var assignableRoles = ViewBag.AssignableRoles as string[] ?? Array.Empty<string>();
}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Employees</h2>
        <a asp-controller="Employees" asp-action="CreateEmployee" class="btn btn-primary">+ Add Employee</a>
    </div>

    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Username</th>
                <th>Email</th>
                <th>Job Position</th>
                <th>Role</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var employee in Model)
        {
            <tr class="@(employee.IsActive ? "" : "table-secondary")">
                <td>@employee.FullName</td>
                <td>@employee.UserName</td>
                <td>@employee.Email</td>
                <td>@employee.JobPosition</td>
                <td>
                    <form asp-controller="Employees" asp-action="AssignRole" method="post" class="d-flex gap-1">
                        <input type="hidden" name="userId" value="@employee.Id" />
                        <select name="role" class="form-select form-select-sm" style="width:140px;">
                            @foreach (var r in assignableRoles)
                            {
                                var current = roles.GetValueOrDefault(employee.Id, "");
                                <option value="@r" selected="@(current.Contains(r))">@r</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Set</button>
                    </form>
                </td>
                <td>
                    @if (employee.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Deactivated</span>
                    }
                </td>
                <td class="text-end">
                    <a asp-controller="Employees" asp-action="Edit" asp-route-id="@employee.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                    @if (employee.IsActive)
                    {
                        <form asp-controller="Employees" asp-action="Deactivate" asp-route-id="@employee.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Deactivate this staff account?');">Deactivate</button>
                        </form>
                    }
                    else
                    {
                        <form asp-controller="Employees" asp-action="Reactivate" asp-route-id="@employee.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-success">Reactivate</button>
                        </form>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
