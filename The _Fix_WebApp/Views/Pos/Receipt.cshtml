@model Order
@{
    ViewData["Title"] = "Receipt";
}

<div class="mx-auto" style="max-width: 400px;">
    <h2 class="text-center">FashionFix</h2>
    <p class="text-center text-muted">Receipt #@Model.OrderNumber</p>
    <p>Date: @Model.DateCreated.ToLocalTime()</p>
    <hr />
    <table class="table table-sm">
        <tbody>
        @foreach (var item in Model.OrderItems)
        {
            <tr>
                <td>@item.Product.Name (x@item.Quantity)</td>
                <td class="text-end">@item.LineTotal.ToString("C")</td>
            </tr>
        }
        </tbody>
    </table>
    <hr />
    <p>Subtotal: @Model.SubTotal.ToString("C")</p>
    <p>Discount: @Model.DiscountTotal.ToString("C")</p>
    <p>Tax: @Model.TaxTotal.ToString("C")</p>
    <h5>Total: @Model.GrandTotal.ToString("C")</h5>
    <p class="text-muted small text-center mt-3">Thank you for shopping at FashionFix. Items may be returned within 30 days with this receipt.</p>
</div>
