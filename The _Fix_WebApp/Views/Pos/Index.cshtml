@model POSCheckoutViewModel
@{
    ViewData["Title"] = "POS / Till";
}
<div class="container-fluid py-4">
    <h2>POS / Till</h2>

    <div class="row">
        <div class="col-lg-7">
            <div class="mb-3">
                <label class="form-label">Scan or enter SKU</label>
                <input type="text" id="barcodeInput" class="form-control form-control-lg" placeholder="Scan barcode or type SKU and press Enter" autofocus />
                <div id="scanError" class="text-danger small mt-1"></div>
            </div>

            <table class="table" id="cartTable">
                <thead>
                    <tr><th>Item</th><th>SKU</th><th>Qty</th><th>Unit Price</th><th>Line Total</th><th></th></tr>
                </thead>
                <tbody id="cartBody">
                    <tr id="emptyCartRow"><td colspan="6" class="text-muted text-center py-3">Cart is empty - scan an item to begin.</td></tr>
                </tbody>
            </table>
        </div>

        <div class="col-lg-5">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Checkout</h5>

                    <form id="checkoutForm" asp-controller="Pos" asp-action="Checkout" method="post">
                        <div id="cartInputs"></div>

                        <div class="mb-2 d-flex justify-content-between">
                            <span>Subtotal</span><strong id="subtotalDisplay">R0.00</strong>
                        </div>
                        <div class="mb-2">
                            <label class="form-label">Discount</label>
                            <input type="number" step="0.01" min="0" name="DiscountTotal" id="discountInput" class="form-control" value="0" />
                        </div>
                        <div class="mb-2 d-flex justify-content-between text-muted">
                            <span>VAT (15%)</span><span id="vatDisplay">R0.00</span>
                        </div>
                        <div class="mb-3 d-flex justify-content-between fs-5 border-top pt-2">
                            <span>Total</span><strong id="grandTotalDisplay">R0.00</strong>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Payment Method</label>
                            <select name="PaymentMethod" class="form-select" required>
                                <option value="Cash">Cash</option>
                                <option value="CreditCard">Credit Card</option>
                                <option value="DebitCard">Debit Card</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Customer ID (optional)</label>
                            <input type="text" name="CustomerId" class="form-control" placeholder="Link this sale to a customer account" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Email receipt to (optional)</label>
                            <input type="email" name="ReceiptEmail" class="form-control" placeholder="customer@example.com" />
                            <div class="form-text">Overrides the linked customer's email if both are filled in - handy for walk-in customers with no account.</div>
                        </div>

                        <button type="submit" id="checkoutBtn" class="btn btn-danger w-100" disabled>Complete Sale</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Scan preview modal - shown every time a SKU is found, before it's added to the till. -->
<div class="modal fade" id="scanPreviewModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Item Scanned</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex gap-3">
                    <img id="scanPreviewImage" src="" alt="" class="rounded border"
                         style="width:120px;height:120px;object-fit:cover;flex-shrink:0;" />
                    <div>
                        <h5 id="scanPreviewName" class="mb-1"></h5>
                        <div id="scanPreviewDetails" class="text-muted small mb-2"></div>
                        <div class="fs-5 fw-bold" id="scanPreviewPrice"></div>
                        <div id="scanPreviewStock" class="text-muted small"></div>
                    </div>
                </div>

                <div class="mt-3">
                    <label class="form-label">Quantity</label>
                    <input type="number" id="scanPreviewQty" class="form-control" value="1" min="1" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="scanPreviewAddBtn">Add to Till</button>
            </div>
        </div>
    </div>
</div>

@* If checkout was rejected (e.g. a stock check failed) the scanned cart is restored from the
   posted model instead of the cashier having to re-scan everything from scratch. *@
<script id="restoreCartData" type="application/json">@Html.Raw(Json.Serialize(Model.CartItems.Select(i => new { productId = i.ProductId, name = i.ProductName, sku = i.SKU, quantity = i.Quantity, unitPrice = i.UnitPrice })))</script>

@section Scripts {
    <script src="~/js/site.js"></script>
}
