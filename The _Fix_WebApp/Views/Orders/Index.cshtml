@model List<Order>
@{
    ViewData["Title"] = "Orders";
    Layout = "_StaffLayout";
    var selectedCategory = ViewBag.SelectedCategory as OrderCategory?;
    var selectedStatus = ViewBag.SelectedStatus as OrderStatus?;
    var selectedType = ViewBag.SelectedType as OrderType?;
    var search = ViewBag.Search as string;
    var categoryCounts = (Dictionary<OrderCategory, int>)ViewBag.CategoryCounts;
    var allCount = (int)ViewBag.AllCount;

    string CategoryUrl(OrderCategory? cat) => Url.Action("Index", new { category = cat, type = selectedType, search }) ?? "#";

    (string bg, string fg) BadgeFor(OrderStatus s) => s switch
    {
        OrderStatus.Delivered or OrderStatus.Completed => ("var(--stf-primary-fixed, #cde9d6)", "var(--stf-primary)"),
        OrderStatus.Cancelled or OrderStatus.Returned => ("var(--stf-error-container)", "var(--stf-error)"),
        OrderStatus.Shipped => ("var(--stf-primary-container)", "var(--stf-on-primary-container)"),
        OrderStatus.Processing => ("var(--stf-secondary-container)", "var(--stf-secondary)"),
        _ => ("var(--stf-surface-container)", "var(--stf-on-surface-variant)")
    };
}

<div class="stf-content">
    <div class="stf-page-head">
        <div>
            <span class="stf-eyebrow">Order Fulfillment</span>
            <h1>Orders</h1>
            <p>Move online orders through Processing &rarr; Shipped &rarr; Delivered, or cancel one that can't be fulfilled.</p>
        </div>
    </div>

    <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px;">
        <a href="@CategoryUrl(null)" class="stf-chip" style="@(selectedCategory is null ? "background:var(--stf-primary);color:#fff;" : "")">All <strong style="margin-left:4px;">@allCount</strong></a>
        <a href="@CategoryUrl(OrderCategory.Pending)" class="stf-chip" style="@(selectedCategory == OrderCategory.Pending ? "background:var(--stf-primary);color:#fff;" : "")">Pending <strong style="margin-left:4px;">@categoryCounts[OrderCategory.Pending]</strong></a>
        <a href="@CategoryUrl(OrderCategory.Completed)" class="stf-chip" style="@(selectedCategory == OrderCategory.Completed ? "background:var(--stf-primary);color:#fff;" : "")">Completed <strong style="margin-left:4px;">@categoryCounts[OrderCategory.Completed]</strong></a>
        <a href="@CategoryUrl(OrderCategory.Past)" class="stf-chip" style="@(selectedCategory == OrderCategory.Past ? "background:var(--stf-primary);color:#fff;" : "")">Past <strong style="margin-left:4px;">@categoryCounts[OrderCategory.Past]</strong></a>
    </div>

    <form asp-controller="Orders" asp-action="Index" method="get" class="stf-card" style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:16px;">
        <input type="hidden" name="category" value="@selectedCategory" />
        <input type="text" name="search" value="@search" placeholder="Search by order #, customer name or email"
               style="flex:1;min-width:220px;border:1px solid var(--stf-outline-variant);border-radius:999px;padding:9px 16px;font-size:0.88rem;" />
        <select name="status" onchange="this.form.submit()" @(selectedCategory.HasValue ? "disabled" : "")
                style="border:1px solid var(--stf-outline-variant);border-radius:8px;padding:9px 12px;font-size:0.85rem;">
            <option value="">All Statuses</option>
            @foreach (OrderStatus s in Enum.GetValues(typeof(OrderStatus)))
            {
                <option value="@s" selected="@(selectedStatus == s)">@s</option>
            }
        </select>
        <select name="type" onchange="this.form.submit()" style="border:1px solid var(--stf-outline-variant);border-radius:8px;padding:9px 12px;font-size:0.85rem;">
            <option value="">All Types</option>
            @foreach (OrderType t in Enum.GetValues(typeof(OrderType)))
            {
                <option value="@t" selected="@(selectedType == t)">@t</option>
            }
        </select>
        <button type="submit" class="stf-btn stf-btn-outline">Apply</button>
        @if (selectedStatus.HasValue || selectedType.HasValue || !string.IsNullOrWhiteSpace(search) || selectedCategory.HasValue)
        {
            <a asp-controller="Orders" asp-action="Index" class="stf-btn stf-btn-danger-outline">Clear</a>
        }
    </form>

    @if (selectedCategory.HasValue)
    {
        <p style="font-size:0.8rem;color:var(--stf-on-surface-variant);">Showing the <strong>@selectedCategory</strong> tab - clear it above to filter by an individual status instead.</p>
    }

    @if (!Model.Any())
    {
        <div class="stf-card" style="text-align:center;padding:40px 20px;color:var(--stf-on-surface-variant);">No orders match this filter.</div>
    }
    else
    {
        <p style="font-size:0.8rem;color:var(--stf-on-surface-variant);">@Model.Count order(s) shown (max 200).</p>
        <table class="stf-table">
            <thead><tr><th>Order #</th><th>Type</th><th>Customer</th><th>Items</th><th>Total</th><th>Status</th><th>Placed</th><th></th></tr></thead>
            <tbody>
            @foreach (var o in Model)
            {
                var (bg, fg) = BadgeFor(o.Status);
                var canAdvance = o.Status is OrderStatus.Pending or OrderStatus.Processing or OrderStatus.Shipped;
                var canCancel = o.Status is OrderStatus.Pending or OrderStatus.Processing or OrderStatus.Shipped;
                var nextLabel = o.Status switch
                {
                    OrderStatus.Pending => "Start Processing",
                    OrderStatus.Processing => "Mark Shipped",
                    OrderStatus.Shipped => "Mark Delivered",
                    _ => ""
                };
                <tr>
                    <td style="font-weight:600;"><a asp-controller="Orders" asp-action="Details" asp-route-id="@o.OrderId">@o.OrderNumber</a></td>
                    <td>@o.OrderType</td>
                    <td>@(o.Customer?.FullName ?? "Walk-in")</td>
                    <td>@o.OrderItems.Sum(i => i.Quantity) item(s)</td>
                    <td>@o.GrandTotal.ToString("C")</td>
                    <td><span class="stf-badge" style="background:@bg;color:@fg;">@o.Status</span></td>
                    <td>@o.DateCreated.ToLocalTime().ToString("dd MMM, HH:mm")</td>
                    <td style="text-align:right;white-space:nowrap;">
                        @if (canAdvance)
                        {
                            <form asp-controller="Orders" asp-action="AdvanceStatus" asp-route-id="@o.OrderId" method="post" style="display:inline;">
                                <button type="submit" class="stf-btn stf-btn-outline" style="padding:6px 12px;font-size:0.75rem;">@nextLabel</button>
                            </form>
                        }
                        @if (canCancel)
                        {
                            <form asp-controller="Orders" asp-action="Cancel" asp-route-id="@o.OrderId" method="post" style="display:inline;">
                                <button type="submit" class="stf-btn stf-btn-danger-outline" style="padding:6px 12px;font-size:0.75rem;" onclick="return confirm('Cancel this order and restock its items?');">Cancel</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>
