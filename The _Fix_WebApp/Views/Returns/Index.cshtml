@model List<ReturnTransaction>
@{
    ViewData["Title"] = "Returns & Exchanges";
}
<div class="container py-4">
    <h2>Returns & Exchanges</h2>

    <form asp-controller="Returns" asp-action="Lookup" method="get" class="d-flex gap-2 mb-4" style="max-width:400px;">
        <input type="text" name="orderNumber" class="form-control" placeholder="Enter order number (e.g. POS-20260101120000)" />
        <button type="submit" class="btn btn-primary">Find Order</button>
    </form>

    <h5>Recent Returns</h5>
    <table class="table table-sm">
        <thead><tr><th>Date</th><th>Order</th><th>Product</th><th>Qty</th><th>Refund</th><th>Method</th></tr></thead>
        <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.DateProcessed.ToLocalTime()</td>
                <td>@r.Order?.OrderNumber</td>
                <td>@r.OrderItem?.Product?.Name</td>
                <td>@r.QuantityReturned</td>
                <td>@r.RefundAmount.ToString("C")</td>
                <td>@r.RefundMethod</td>
            </tr>
        }
        </tbody>
    </table>
</div>
