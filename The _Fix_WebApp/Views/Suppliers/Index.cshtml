@model List<Supplier>
@{
    ViewData["Title"] = "Suppliers";
}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Suppliers</h2>
        <div>
            <a asp-controller="Suppliers" asp-action="Create" class="btn btn-outline-primary">+ Add Supplier</a>
            <a asp-controller="PurchaseOrders" asp-action="Index" class="btn btn-outline-secondary">Purchase Orders</a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No suppliers yet - add one before raising a purchase order.</div>
    }
    else
    {
        <table class="table table-hover">
            <thead><tr><th>Name</th><th>Contact Email</th><th>Contact Phone</th><th>Lead Time</th></tr></thead>
            <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.Name</td>
                    <td>@s.ContactEmail</td>
                    <td>@s.ContactPhone</td>
                    <td>@s.LeadTimeDays day(s)</td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>
